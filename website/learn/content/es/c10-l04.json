{
 "title": "Ordenar y buscar: std.sort",
 "blocks": [
  {
   "t": "p",
   "text": "`sort.sort(lista)` ordena una `List` en el sitio (se requiere `T: Ord`); `sort.sort_by(lista, regla)` ordena con tu propia regla; `sort.binary_search(lista, x)` busca rápidamente en una lista **ordenada** y devuelve un `Optional[usize]` (la posición)."
  },
  {
   "t": "code",
   "code": [
    "import std.sort",
    "",
    "fn main():",
    "    v = List[i32]()",
    "    v.push(40)",
    "    v.push(10)",
    "    v.push(30)",
    "    v.push(20)",
    "    sort.sort(v)",
    "    for x in v:",
    "        print(x)",
    "    print(sort.is_sorted(v))",
    "    match sort.binary_search(v, 30):",
    "        Valid(i):",
    "            print(\"30 is at index\", i)",
    "        None:",
    "            print(\"not found\")"
   ],
   "run": true,
   "output": [
    "10",
    "20",
    "30",
    "40",
    "true",
    "30 is at index 2"
   ]
  },
