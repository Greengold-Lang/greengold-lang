{
 "title": "Práctica: un intérprete de comandos",
 "blocks": [
  {
   "t": "p",
   "text": "Enums, variantes con datos y la expresión `match` juntos: una pequeña calculadora."
  },
  {
   "t": "code",
   "code": [
    "enum Command:",
    "    Add(f64, f64)",
    "    Subtract(f64, f64)",
    "    Square(f64)",
    "    Reset",
    "",
    "fn evaluate(cmd: Command) -> f64:",
    "    return match cmd:",
    "        Command.Add(a, b) => a + b",
    "        Command.Subtract(a, b) => a - b",
    "        Command.Square(x) => x * x",
    "        Command.Reset => 0.0",
    "",
    "fn main():",
    "    commands: [4]Command = [",
    "        Command.Add(10.0, 5.0),",
    "        Command.Square(4.0),",
    "        Command.Subtract(20.0, 8.0),",
    "        Command.Reset",
    "    ]",
    "    for c in commands:",
    "        print(\"result:\", evaluate(c))"
   ],
   "run": true,
   "output": [
    "result: 15",
    "result: 16",
    "result: 12",
    "result: 0"
   ]
  },
  {
   "t": "exercise",
   "id": "c06-l06-x1",
   "prompt": "Añade una variante `Multiply(f64, f64)` a `Command` y escribe su rama en `evaluate`. Imprime `Multiply(6.0, 7.0)`.",
   "starter": [
    "enum Command:",
    "    Add(f64, f64)",
    "    Reset",
    "",
    "fn evaluate(cmd: Command) -> f64:",
    "    return match cmd:",
    "        Command.Add(a, b) => a + b",
    "        Command.Reset => 0.0",
    "",
    "fn main():",
    "    print(evaluate(Command.Add(6.0, 7.0)))"
   ],
   "solution": [
    "enum Command:",
    "    Add(f64, f64)",
    "    Multiply(f64, f64)",
    "    Reset",
    "",
    "fn evaluate(cmd: Command) -> f64:",
    "    return match cmd:",
    "        Command.Add(a, b) => a + b",
    "        Command.Multiply(a, b) => a * b",
    "        Command.Reset => 0.0",
    "",
    "fn main():",
    "    print(evaluate(Command.Multiply(6.0, 7.0)))"
   ],
   "hint": "Añade la nueva rama tanto al enum como al `match`; si falta una de las dos, no compila.",
   "expected": [
    "42"
   ]
  },
  {
   "t": "quiz",
   "id": "c06-l06-q1",
   "q": "Si añades una variante al enum y no actualizas el `match`, ¿qué ocurre?",
   "options": [
    "Se ejecuta la rama antigua",
    "El compilador indica la rama que falta",
    "El programa se comporta mal en silencio"
   ],
   "answer": 1,
   "why": "La comprobación de exhaustividad detecta en compilación los casos olvidados."
  }
 ]
}
