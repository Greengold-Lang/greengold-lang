{
 "title": "Práctica: un analizador de texto seguro",
 "blocks": [
  {
   "t": "p",
   "text": "Una función que convierte texto en un número usa `Result` y errores de enum a la vez. Los rangos de caracteres se comparan como `'0'..'9'`; el valor de un dígito se obtiene con `c - '0'`."
  },
  {
   "t": "code",
   "code": [
    "enum ParseError:",
    "    EmptyInput",
    "    InvalidFormat",
    "",
    "fn parse_positive(input: str) -> Result[i32, ParseError]:",
    "    if input.len == 0:",
    "        return Err(ParseError.EmptyInput)",
    "    total = 0",
    "    for i in 0..input.len:",
    "        c = input[i]",
    "        if c < '0' or c > '9':",
    "            return Err(ParseError.InvalidFormat)",
    "        total = total * 10 + i32(c - '0')",
    "    return Ok(total)",
    "",
    "fn main():",
    "    inputs: [3]str = [\"1234\", \"\", \"42a\"]",
    "    for s in inputs:",
    "        match parse_positive(s):",
    "            Ok(num):",
    "                print(\"parsed:\", num)",
    "            Err(e):",
    "                match e:",
    "                    ParseError.EmptyInput:",
    "                        print(\"error: input is empty\")",
    "                    ParseError.InvalidFormat:",
    "                        print(\"error: invalid character in\", s)"
   ],
   "run": true,
   "output": [
    "parsed: 1234",
    "error: input is empty",
    "error: invalid character in 42a"
   ]
  },
  {
   "t": "exercise",
