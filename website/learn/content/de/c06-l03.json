{
 "title": "Zahlen, Bereiche und Alternativen",
 "blocks": [
  {
   "t": "p",
   "text": "`match` ist nicht auf Enums beschränkt; es funktioniert auch mit Ganzzahlen, Zeichen, Bools und Zeichenketten. `|` passt auf mehrere Alternativen, `a..=b` auf einen Bereich."
  },
  {
   "t": "code",
   "code": [
    "fn classify(code: i32):",
    "    match code:",
    "        200 | 201 | 204:",
    "            print(\"success\")",
    "        301 | 302:",
    "            print(\"redirect\")",
    "        400..=499:",
    "            print(\"client error\")",
    "        500..=599:",
    "            print(\"server error\")",
    "        _:",
    "            print(\"unknown\")",
    "",
    "fn main():",
    "    classify(201)",
    "    classify(404)",
    "    classify(503)",
    "    classify(99)"
   ],
   "run": true,
   "output": [
    "success",
    "client error",
    "server error",
    "unknown"
   ]
  },
  {
   "t": "code",
   "code": [
    "fn kind(c: u8):",
    "    match c:",
    "        'a'..='z' | 'A'..='Z':",
    "            print(\"letter\")",
    "        '0'..='9':",
    "            print(\"digit\")",
    "        _:",
    "            print(\"other\")",
    "",
    "fn main():",
    "    kind('q')",
    "    kind('7')",
    "    kind('!')"
   ],
   "run": true,
   "output": [
    "letter",
    "digit",
    "other"
   ]
  },
  {
   "t": "exercise",
   "id": "c06-l03-x1",
   "prompt": "`grade(score: i32)`: Gib `A` für 90..=100, `B` für 80..=89, `C` für 70..=79 und `F` für den Rest aus. Rufe es mit 85 auf.",
   "starter": [
    "fn grade(score: i32):",
    "    match score:",
    "        _:",
    "            print(\"F\")",
    "",
    "fn main():",
    "    grade(85)"
   ],
   "solution": [
    "fn grade(score: i32):",
    "    match score:",
    "        90..=100:",
    "            print(\"A\")",
    "        80..=89:",
    "            print(\"B\")",
    "        70..=79:",
    "            print(\"C\")",
    "        _:",
    "            print(\"F\")",
    "",
    "fn main():",
    "    grade(85)"
   ],
   "hint": "Füge drei Bereichszweige über dem `_`-Zweig hinzu.",
   "expected": [
    "B"
   ]
  },
  {
   "t": "quiz",
   "id": "c06-l03-q1",
   "q": "Was bedeutet `|` im Muster `200 | 201:`?",
   "options": [
    "und",
    "oder (Alternative)",
    "eine Bit-Operation"
   ],
   "answer": 1,
   "why": "In einem Muster bedeutet `|` „eines davon“."
  }
 ]
}
