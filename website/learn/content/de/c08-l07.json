    "                    print(\"invalid\")"
   ],
   "solution": [
    "enum ParseError:",
    "    EmptyInput",
    "    InvalidFormat",
    "    TooLong",
    "",
    "fn parse_positive(input: str) -> Result[i32, ParseError]:",
    "    if input.len == 0:",
    "        return Err(ParseError.EmptyInput)",
    "    if input.len > 5:",
    "        return Err(ParseError.TooLong)",
    "    total = 0",
    "    for i in 0..input.len:",
    "        c = input[i]",
    "        if c < '0' or c > '9':",
    "            return Err(ParseError.InvalidFormat)",
    "        total = total * 10 + i32(c - '0')",
    "    return Ok(total)",
    "",
    "fn main():",
    "    match parse_positive(\"123456\"):",
    "        Ok(n):",
    "            print(\"parsed:\", n)",
    "        Err(e):",
    "            match e:",
    "                ParseError.EmptyInput:",
    "                    print(\"empty\")",
    "                ParseError.InvalidFormat:",
    "                    print(\"invalid\")",
    "                ParseError.TooLong:",
    "                    print(\"too long\")"
   ],
   "hint": "Füge die neue Variante dem Enum, dem `match` und einer Prüfung hinzu.",
   "expected": [
    "too long"
   ]
  },
  {
   "t": "quiz",
   "id": "c08-l07-q1",
   "q": "Was ermittelt `c - '0'`?",
   "options": [
    "Den ASCII-Code des Zeichens",
    "Den Zahlenwert eines Ziffernzeichens",
    "Die Position des Zeichens"
   ],
   "answer": 1,
   "why": "`'5' - '0'` = 5: Ziffernzeichen sind aufeinanderfolgend."
  }
 ]
