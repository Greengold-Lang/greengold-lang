{
 "title": "Sortieren und Suchen: std.sort",
 "blocks": [
  {
   "t": "p",
   "text": "`sort.sort(liste)` sortiert eine `List` an Ort und Stelle (`T: Ord` ist nötig); `sort.sort_by(liste, regel)` sortiert nach deiner eigenen Regel; `sort.binary_search(liste, x)` sucht schnell in einer **sortierten** Liste und liefert ein `Optional[usize]` (die Position)."
  },
  {
   "t": "code",
   "code": [
    "import std.sort",
    "",
    "fn main():",
    "    v = List[i32]()",
    "    v.push(40)",
    "    v.push(10)",
    "    v.push(30)",
    "    v.push(20)",
    "    sort.sort(v)",
    "    for x in v:",
    "        print(x)",
    "    print(sort.is_sorted(v))",
    "    match sort.binary_search(v, 30):",
    "        Valid(i):",
    "            print(\"30 is at index\", i)",
    "        None:",
    "            print(\"not found\")"
   ],
   "run": true,
   "output": [
    "10",
    "20",
    "30",
    "40",
    "true",
    "30 is at index 2"
   ]
  },
