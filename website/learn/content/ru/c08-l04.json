   ],
   "solution": [
    "fn check(a: i32) -> Result[i32, str]:",
    "    if a < 0:",
    "        return Err(\"negative\")",
    "    return Ok(a)",
    "",
    "fn parse_and_double(a: i32) -> Result[i32, str]:",
    "    v = check(a)?",
    "    return Ok(v * 2)",
    "",
    "fn show(a: i32):",
    "    match parse_and_double(a):",
    "        Ok(v):",
    "            print(\"ok\", v)",
    "        Err(m):",
    "            print(\"error:\", m)",
    "",
    "fn main():",
    "    show(21)",
    "    show(-4)"
   ],
   "hint": "Напишите `v = check(a)?`, затем верните `Ok(v * 2)`.",
   "expected": [
    "ok 42",
    "error: negative"
   ]
