 "title": "Практика: программа из функций",
 "blocks": [
  {
   "t": "p",
   "text": "Разбиение большой задачи на маленькие функции делает код читаемым и проверяемым. Ниже конвертер температуры собран из функций, каждая из которых делает одно дело."
  },
  {
   "t": "code",
   "code": [
    "const FREEZING_F: f64 = 32.0",
    "",
    "fn to_fahrenheit(c: f64) -> f64:",
    "    return c * 9.0 / 5.0 + FREEZING_F",
    "",
    "fn to_celsius(f: f64) -> f64:",
    "    return (f - FREEZING_F) * 5.0 / 9.0",
    "",
    "fn main():",
    "    print(\"25 C =\", to_fahrenheit(25.0), \"F\")",
    "    print(\"212 F =\", to_celsius(212.0), \"C\")"
   ],
   "run": true,
   "output": [
    "25 C = 77 F",
    "212 F = 100 C"
   ]
  },
  {
   "t": "exercise",
   "id": "c03-l04-x1",
   "prompt": "Напишите `is_leap(year)`: `true`, если год делится на 4, но не на 100, либо делится на 400. Выведите 2024, 1900 и 2000.",
   "starter": [
    "fn is_leap(year: i32) -> bool:",
    "    return false",
    "",
    "fn main():",
    "    print(is_leap(2024))",
    "    print(is_leap(1900))",
    "    print(is_leap(2000))"
   ],
   "solution": [
    "fn is_leap(year: i32) -> bool:",
    "    return (year % 4 == 0 and year % 100 != 0) or year % 400 == 0",
    "",
    "fn main():",
    "    print(is_leap(2024))",
    "    print(is_leap(1900))",
    "    print(is_leap(2000))"
   ],
   "hint": "Объедините три условия с помощью `and` и `or`; используйте скобки.",
   "expected": [
    "true",
    "false",
    "true"
   ]
  },
