   "t": "p",
   "text": "Функции могут вызывать друг друга; результат одной может быть аргументом другой. `return` сразу выходит из функции, поэтому его используют и для **раннего возврата**."
  },
  {
   "t": "code",
   "code": [
    "fn square(x: i32) -> i32:",
    "    return x * x",
    "",
    "fn abs_value(x: i32) -> i32:",
    "    if x < 0:",
    "        return -x",
    "    return x",
    "",
    "fn main():",
    "    print(square(abs_value(-4)))"
   ],
   "run": true,
   "output": [
    "16"
   ]
  },
