{
 "title": "Варианты, несущие данные",
 "blocks": [
  {
   "t": "p",
   "text": "В Greengold варианты enum могут **нести данные**, причём у каждого варианта они могут быть разными. Такое значение называют «алгебраическим типом данных». Внутри `match` вы даёте данным имена в шаблоне."
  },
  {
   "t": "code",
   "code": [
    "enum Shape:",
    "    Circle(f64)",
    "    Rectangle(f64, f64)",
    "    Point",
    "",
    "fn describe(s: Shape):",
    "    match s:",
    "        Shape.Circle(radius):",
    "            print(\"circle, radius\", radius)",
    "        Shape.Rectangle(w, h):",
    "            print(\"rectangle\", w, \"x\", h)",
    "        Shape.Point:",
    "            print(\"a point\")",
    "",
    "fn main():",
    "    describe(Shape.Circle(5.0))",
    "    describe(Shape.Rectangle(10.0, 4.0))",
    "    describe(Shape.Point)"
   ],
   "run": true,
   "output": [
    "circle, radius 5",
    "rectangle 10 x 4",
    "a point"
   ]
  },
  {
   "t": "p",
   "text": "Ненужное поле можно игнорировать с помощью `_`: `Shape.Rectangle(w, _):`."
  },
  {
   "t": "exercise",
   "id": "c06-l02-x1",
   "prompt": "Завершите `area(s)`: `w * h` для прямоугольника, `side * side` для квадрата, 0 для `Empty`. Выведите площадь `Rect(3, 4)`.",
   "starter": [
    "enum Figure:",
    "    Rect(i32, i32)",
    "    Square(i32)",
    "    Empty",
    "",
    "fn area(s: Figure) -> i32:",
    "    match s:",
    "        Figure.Rect(w, h):",
    "            return 0",
    "        Figure.Square(side):",
    "            return 0",
    "        Figure.Empty:",
    "            return 0",
    "",
    "fn main():",
    "    print(area(Figure.Rect(3, 4)))"
   ],
   "solution": [
    "enum Figure:",
    "    Rect(i32, i32)",
    "    Square(i32)",
    "    Empty",
    "",
    "fn area(s: Figure) -> i32:",
    "    match s:",
    "        Figure.Rect(w, h):",
    "            return w * h",
    "        Figure.Square(side):",
    "            return side * side",
    "        Figure.Empty:",
    "            return 0",
    "",
    "fn main():",
    "    print(area(Figure.Rect(3, 4)))"
   ],
   "hint": "Замените первые две строки `return 0` вычислением.",
   "expected": [
    "12"
   ]
  },
  {
   "t": "quiz",
   "id": "c06-l02-q1",
   "q": "Что делает `_` в шаблоне `Shape.Rectangle(w, _)`?",
   "options": [
    "Игнорирует второе поле",
    "Это ошибка",
    "Устанавливает второе поле в 0"
   ],
   "answer": 0,
   "why": "`_` — подстановочный знак: это значение не нужно."
  }
 ]
