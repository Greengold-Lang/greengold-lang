    "fn get_c_random(max: i32) -> i32:",
    "    if max <= 0:",
    "        return 0",
    "    unsafe:",
    "        raw = rand()",
    "        return raw % max",
    "",
    "fn main():",
    "    dice = get_c_random(6) + 1",
    "    print(\"dice:\", dice)"
