{
 "title": "Числа, диапазоны и альтернативы",
 "blocks": [
  {
   "t": "p",
   "text": "`match` не ограничен enum; он работает и с целыми числами, символами, bool и строками. `|` сопоставляет несколько альтернатив, `a..=b` — диапазон."
  },
  {
   "t": "code",
   "code": [
    "fn classify(code: i32):",
    "    match code:",
    "        200 | 201 | 204:",
    "            print(\"success\")",
    "        301 | 302:",
    "            print(\"redirect\")",
    "        400..=499:",
    "            print(\"client error\")",
    "        500..=599:",
    "            print(\"server error\")",
    "        _:",
    "            print(\"unknown\")",
    "",
    "fn main():",
    "    classify(201)",
    "    classify(404)",
    "    classify(503)",
    "    classify(99)"
   ],
   "run": true,
   "output": [
    "success",
    "client error",
    "server error",
    "unknown"
   ]
  },
  {
   "t": "code",
   "code": [
    "fn kind(c: u8):",
    "    match c:",
    "        'a'..='z' | 'A'..='Z':",
    "            print(\"letter\")",
    "        '0'..='9':",
    "            print(\"digit\")",
    "        _:",
    "            print(\"other\")",
    "",
    "fn main():",
    "    kind('q')",
    "    kind('7')",
    "    kind('!')"
   ],
   "run": true,
   "output": [
    "letter",
    "digit",
    "other"
   ]
  },
  {
   "t": "exercise",
   "id": "c06-l03-x1",
   "prompt": "`grade(score: i32)`: выводит `A` для 90..=100, `B` для 80..=89, `C` для 70..=79 и `F` для остальных. Вызовите её с 85.",
   "starter": [
    "fn grade(score: i32):",
    "    match score:",
    "        _:",
    "            print(\"F\")",
    "",
    "fn main():",
    "    grade(85)"
   ],
   "solution": [
    "fn grade(score: i32):",
    "    match score:",
    "        90..=100:",
    "            print(\"A\")",
    "        80..=89:",
    "            print(\"B\")",
    "        70..=79:",
    "            print(\"C\")",
    "        _:",
    "            print(\"F\")",
    "",
    "fn main():",
    "    grade(85)"
   ],
   "hint": "Добавьте три ветки с диапазонами над веткой `_`.",
   "expected": [
    "B"
   ]
  },
  {
   "t": "quiz",
   "id": "c06-l03-q1",
   "q": "Что означает `|` в шаблоне `200 | 201:`?",
   "options": [
    "и",
    "или (альтернатива)",
    "битовая операция"
   ],
   "answer": 1,
   "why": "В шаблоне `|` означает «одно из этих»."
  }
 ]
}
