{
 "title": "Sayılar, aralıklar ve alternatifler",
 "blocks": [
  {
   "t": "p",
   "text": "`match` yalnızca enum'larla sınırlı değildir; tam sayılar, karakterler, bool ve metinlerle de çalışır. `|` birden fazla alternatifi, `a..=b` bir aralığı eşler."
  },
  {
   "t": "code",
   "code": [
    "fn classify(code: i32):",
    "    match code:",
    "        200 | 201 | 204:",
    "            print(\"success\")",
    "        301 | 302:",
    "            print(\"redirect\")",
    "        400..=499:",
    "            print(\"client error\")",
    "        500..=599:",
    "            print(\"server error\")",
    "        _:",
    "            print(\"unknown\")",
    "",
    "fn main():",
    "    classify(201)",
    "    classify(404)",
    "    classify(503)",
    "    classify(99)"
   ],
   "run": true,
   "output": [
    "success",
    "client error",
    "server error",
    "unknown"
   ]
  },
  {
   "t": "code",
   "code": [
    "fn kind(c: u8):",
    "    match c:",
    "        'a'..='z' | 'A'..='Z':",
    "            print(\"letter\")",
    "        '0'..='9':",
    "            print(\"digit\")",
    "        _:",
    "            print(\"other\")",
    "",
    "fn main():",
    "    kind('q')",
    "    kind('7')",
    "    kind('!')"
   ],
   "run": true,
   "output": [
    "letter",
    "digit",
    "other"
   ]
  },
  {
   "t": "exercise",
   "id": "c06-l03-x1",
   "prompt": "`grade(score: i32)`: 90..=100 için `A`, 80..=89 için `B`, 70..=79 için `C`, diğerleri için `F` yazdırsın. 85 ile çağır.",
   "starter": [
    "fn grade(score: i32):",
    "    match score:",
    "        _:",
    "            print(\"F\")",
    "",
    "fn main():",
    "    grade(85)"
   ],
   "solution": [
    "fn grade(score: i32):",
    "    match score:",
    "        90..=100:",
    "            print(\"A\")",
    "        80..=89:",
    "            print(\"B\")",
    "        70..=79:",
    "            print(\"C\")",
    "        _:",
    "            print(\"F\")",
    "",
    "fn main():",
    "    grade(85)"
   ],
   "hint": "`_` dalının üstüne üç aralık dalı ekle.",
   "expected": [
    "B"
   ]
  },
  {
   "t": "quiz",
   "id": "c06-l03-q1",
   "q": "`200 | 201:` deseninde `|` ne anlama gelir?",
   "options": [
    "ve",
    "ya da (alternatif)",
    "bit işlemi"
   ],
   "answer": 1,
   "why": "Desen içinde `|` \"şunlardan biri\" demektir."
  }
 ]
}
