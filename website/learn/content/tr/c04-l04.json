  {
   "t": "p",
   "text": "Sınır dışı bir indeks çalışma anında programı durdurur; yani bellekte sessizce yanlış yere yazılmaz. **`type`** ile uzun bir tipe kısa bir ad verebilirsin."
  },
  {
   "t": "code",
   "code": [
    "type Point = (f64, f64)",
    "",
    "fn dist2(a: Point, b: Point) -> f64:",
    "    dx = a.0 - b.0",
    "    dy = a.1 - b.1",
    "    return dx * dx + dy * dy",
    "",
    "fn main():",
    "    origin: Point = (0.0, 0.0)",
    "    target: Point = (3.0, 4.0)",
    "    print(dist2(origin, target))"
   ],
   "run": true,
   "output": [
    "25"
   ]
  },
  {
   "t": "exercise",
   "id": "c04-l04-x1",
   "prompt": "Dizideki en büyük sayıyı bul ve yazdır.",
   "starter": [
    "fn main():",
    "    data: [5]i32 = [8, 3, 15, 4, 9]",
    "    best = data[0]",
    "    print(best)"
   ],
   "solution": [
    "fn main():",
    "    data: [5]i32 = [8, 3, 15, 4, 9]",
    "    best = data[0]",
    "    for x in data:",
    "        if x > best:",
    "            best = x",
    "    print(best)"
   ],
   "hint": "`for x in data:` ile dolaş; `x > best` ise `best = x`.",
   "expected": [
    "15"
   ]
  },
