   "id": "c03-l02-x1",
   "prompt": "`max_of(a, b)` fonksiyonunu yaz: büyük olanı döndürsün.",
   "starter": [
    "fn max_of(a: i32, b: i32) -> i32:",
    "    return 0",
    "",
    "fn main():",
    "    print(max_of(7, 12))",
    "    print(max_of(30, 4))"
   ],
   "solution": [
    "fn max_of(a: i32, b: i32) -> i32:",
    "    if a > b:",
    "        return a",
    "    return b",
    "",
    "fn main():",
    "    print(max_of(7, 12))",
    "    print(max_of(30, 4))"
   ],
   "hint": "`a > b` ise `a`'yı, değilse `b`'yi döndür.",
   "expected": [
    "12",
    "30"
   ]
