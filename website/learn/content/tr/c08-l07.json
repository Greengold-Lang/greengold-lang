   ],
   "solution": [
    "enum ParseError:",
    "    EmptyInput",
    "    InvalidFormat",
    "    TooLong",
    "",
    "fn parse_positive(input: str) -> Result[i32, ParseError]:",
    "    if input.len == 0:",
    "        return Err(ParseError.EmptyInput)",
    "    if input.len > 5:",
    "        return Err(ParseError.TooLong)",
    "    total = 0",
    "    for i in 0..input.len:",
    "        c = input[i]",
    "        if c < '0' or c > '9':",
    "            return Err(ParseError.InvalidFormat)",
    "        total = total * 10 + i32(c - '0')",
    "    return Ok(total)",
    "",
    "fn main():",
    "    match parse_positive(\"123456\"):",
    "        Ok(n):",
    "            print(\"parsed:\", n)",
    "        Err(e):",
    "            match e:",
    "                ParseError.EmptyInput:",
    "                    print(\"empty\")",
    "                ParseError.InvalidFormat:",
    "                    print(\"invalid\")",
    "                ParseError.TooLong:",
    "                    print(\"too long\")"
   ],
   "hint": "Yeni varyantı hem enum'a, hem `match`'e, hem de kontrole ekle.",
   "expected": [
    "too long"
   ]
  },
