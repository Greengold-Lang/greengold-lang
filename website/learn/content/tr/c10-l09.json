{
 "title": "Tarih ve süre: std.time",
 "blocks": [
  {
   "t": "p",
   "text": "`std.time` anlık zamanı (`now_utc()`, `Instant.now()`) ve tarih hesabını sunar. Tarihleri milisaniye cinsinden Unix zamanıyla tutar: `datetime_from_unix_millis(0)` 1970-01-01'i verir. `add_days`, `add_months`, `weekday_name`, `to_iso`, `format` gibi yöntemleri vardır. Süre için `Duration` kullanılır."
  },
  {
   "t": "code",
   "code": [
    "import std.time",
    "",
    "fn main():",
    "    d = time.datetime_from_unix_millis(0)",
    "    print(d.to_iso().as_str())",
    "    print(d.weekday_name())",
    "    later = d.add_days(100)",
    "    print(later.to_iso().as_str())",
    "    print(time.is_leap_year(2024), time.days_in_month(2024, 2))"
   ],
   "run": true,
   "output": [
    "1970-01-01T00:00:00Z",
    "Thursday",
    "1970-04-11T00:00:00Z",
    "true 29"
   ]
  },
  {
   "t": "exercise",
   "id": "c10-l09-x1",
   "prompt": "1970-01-01'e 365 gün ekle ve ISO biçiminde yazdır.",
   "starter": [
    "import std.time",
    "",
    "fn main():",
    "    d = time.datetime_from_unix_millis(0)",
    "    print(d.to_iso().as_str())"
   ],
   "solution": [
    "import std.time",
    "",
    "fn main():",
    "    d = time.datetime_from_unix_millis(0)",
    "    print(d.add_days(365).to_iso().as_str())"
   ],
   "hint": "`d.add_days(365)`",
   "expected": [
    "1971-01-01T00:00:00Z"
   ]
  },
  {
   "t": "quiz",
   "id": "c10-l09-q1",
   "q": "`datetime_from_unix_millis(0)` hangi tarihi verir?",
   "options": [
    "2000-01-01",
    "1970-01-01",
    "Bugünün tarihi"
   ],
   "answer": 1,
   "why": "Unix zamanı 1 Ocak 1970'te başlar."
  }
 ]
}
