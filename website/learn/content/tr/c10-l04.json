{
 "title": "Sıralama ve arama: std.sort",
 "blocks": [
  {
   "t": "p",
   "text": "`sort.sort(liste)` bir `List`'i yerinde sıralar (`T: Ord` olmalı); `sort.sort_by(liste, kural)` kendi kuralınla sıralar; `sort.binary_search(liste, x)` **sıralı** bir listede hızlı arama yapar ve `Optional[usize]` (konum) döndürür."
  },
  {
   "t": "code",
   "code": [
    "import std.sort",
    "",
    "fn main():",
    "    v = List[i32]()",
    "    v.push(40)",
    "    v.push(10)",
    "    v.push(30)",
    "    v.push(20)",
    "    sort.sort(v)",
    "    for x in v:",
    "        print(x)",
    "    print(sort.is_sorted(v))",
    "    match sort.binary_search(v, 30):",
    "        Valid(i):",
    "            print(\"30 is at index\", i)",
    "        None:",
    "            print(\"not found\")"
   ],
   "run": true,
   "output": [
    "10",
    "20",
    "30",
    "40",
    "true",
    "30 is at index 2"
   ]
  },
