{
 "title": "Paylaşılan değer ve paralel işlem",
 "blocks": [
  {
   "t": "p",
   "text": "**`Shared[T]`** değiştirilemeyen bir değeri birden çok sahibe verir (`clone()` sahip ekler, son sahip bırakınca değer silinir). Yapılandırma gibi, okunacak ama değişmeyecek veriler için uygundur."
  },
  {
   "t": "code",
   "code": [
    "struct Config:",
    "    name: string",
    "    limits: List[i32]",
    "",
    "fn limit_sum(c: Shared[Config]) -> i32:",
    "    t = 0",
    "    for x in c.value.limits:",
    "        t += x",
    "    return t",
    "",
    "fn main():",
    "    limits = List[i32]()",
    "    limits.push(10)",
    "    limits.push(20)",
    "    cfg = Shared[Config](Config{ name: string.from(\"prod\"), limits: limits })",
    "    other = cfg.clone()",
    "    print(limit_sum(cfg), other.value.name.as_str())"
   ],
   "run": true,
   "output": [
    "30 prod"
   ]
  },
  {
   "t": "p",
   "text": "Büyük bir diziyi bütün çekirdeklerde işlemek için `std.parallel` bir **havuz** sunar: `Pool.new(n)`, `map_i64`, `map_f64`, `reduce_i64`, `reduce_f64` ve `cpu_count()`."
  },
  {
   "t": "code",
   "code": [
    "import std.parallel",
    "",
    "fn square(x: i64) -> i64:",
    "    return x * x",
    "",
    "fn add(a: i64, b: i64) -> i64:",
    "    return a + b",
    "",
    "fn main():",
    "    pool = parallel.Pool.new(parallel.cpu_count())",
    "    src = List[i64]()",
    "    for i in 1..=10:",
    "        src.push(i64(i))",
    "    dst = List[i64]()",
    "    for i in 1..=10:",
    "        dst.push(0)",
    "    parallel.map_i64(pool, src, dst, square)",
    "    print(parallel.reduce_i64(pool, dst, 0, add))"
   ],
   "run": false,
   "local": true
  },
  {
   "t": "quiz",
   "id": "c12-l05-q1",
   "q": "`Shared[T]` hangi tür veri için uygundur?",
   "options": [
    "Sürekli değişen sayaçlar",
    "Okunacak ama değişmeyecek paylaşılan veri",
    "Yalnızca sayılar"
   ],
   "answer": 1,
   "why": "Değişen veri için `Locked[T]` ya da atomikler kullanılır."
  }
 ]
