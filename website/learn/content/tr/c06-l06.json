   "t": "p",
   "text": "Enum, veri taşıyan varyantlar ve `match` ifadesi bir arada: küçük bir hesap makinesi."
  },
  {
   "t": "code",
   "code": [
    "enum Command:",
    "    Add(f64, f64)",
    "    Subtract(f64, f64)",
    "    Square(f64)",
    "    Reset",
    "",
    "fn evaluate(cmd: Command) -> f64:",
    "    return match cmd:",
    "        Command.Add(a, b) => a + b",
    "        Command.Subtract(a, b) => a - b",
    "        Command.Square(x) => x * x",
    "        Command.Reset => 0.0",
    "",
    "fn main():",
    "    commands: [4]Command = [",
    "        Command.Add(10.0, 5.0),",
    "        Command.Square(4.0),",
    "        Command.Subtract(20.0, 8.0),",
    "        Command.Reset",
    "    ]",
    "    for c in commands:",
    "        print(\"result:\", evaluate(c))"
   ],
   "run": true,
   "output": [
    "result: 15",
    "result: 16",
    "result: 12",
    "result: 0"
   ]
  },
  {
   "t": "exercise",
   "id": "c06-l06-x1",
   "prompt": "`Command`'a `Multiply(f64, f64)` varyantını ekle ve `evaluate`'e dalını yaz. `Multiply(6.0, 7.0)`'ı yazdır.",
   "starter": [
    "enum Command:",
    "    Add(f64, f64)",
    "    Reset",
    "",
    "fn evaluate(cmd: Command) -> f64:",
    "    return match cmd:",
    "        Command.Add(a, b) => a + b",
    "        Command.Reset => 0.0",
    "",
    "fn main():",
    "    print(evaluate(Command.Add(6.0, 7.0)))"
   ],
   "solution": [
    "enum Command:",
    "    Add(f64, f64)",
    "    Multiply(f64, f64)",
    "    Reset",
    "",
    "fn evaluate(cmd: Command) -> f64:",
    "    return match cmd:",
    "        Command.Add(a, b) => a + b",
    "        Command.Multiply(a, b) => a * b",
    "        Command.Reset => 0.0",
    "",
    "fn main():",
    "    print(evaluate(Command.Multiply(6.0, 7.0)))"
   ],
   "hint": "Hem enum'a hem `match`'e yeni dalı ekle; biri eksikse derlenmez.",
   "expected": [
    "42"
   ]
  },
