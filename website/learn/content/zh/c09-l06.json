    "import std.sort",
    "",
    "fn main():",
    "    v = List[i32]()",
    "    v.push(5)",
    "    v.push(2)",
    "    v.push(9)",
    "    v.push(1)",
    "    sort.sort_by(v, fn(a: i32, b: i32) -> bool => a < b)",
    "    for x in v:",
    "        print(x)"
   ],
   "hint": "用 `a < b` 代替 `a > b`。",
   "expected": [
    "1",
    "2",
    "5",
    "9"
   ]
