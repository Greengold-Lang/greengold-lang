{
 "title": "排序与查找：std.sort",
 "blocks": [
  {
   "t": "p",
   "text": "`sort.sort(列表)` 就地对 `List` 排序（需要 `T: Ord`）；`sort.sort_by(列表, 规则)` 按你自己的规则排序；`sort.binary_search(列表, x)` 在**已排序**的列表中快速查找，返回 `Optional[usize]`（位置）。"
  },
  {
   "t": "code",
   "code": [
    "import std.sort",
    "",
    "fn main():",
    "    v = List[i32]()",
    "    v.push(40)",
    "    v.push(10)",
    "    v.push(30)",
    "    v.push(20)",
    "    sort.sort(v)",
    "    for x in v:",
    "        print(x)",
    "    print(sort.is_sorted(v))",
    "    match sort.binary_search(v, 30):",
    "        Valid(i):",
    "            print(\"30 is at index\", i)",
    "        None:",
    "            print(\"not found\")"
   ],
   "run": true,
   "output": [
    "10",
    "20",
    "30",
    "40",
    "true",
    "30 is at index 2"
   ]
  },
  {
