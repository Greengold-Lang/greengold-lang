   "solution": [
    "fn find_index(items: []i32, target: i32) -> Optional[usize]:",
    "    for idx, val in items:",
    "        if val == target:",
    "            return Valid(idx)",
    "    return None",
    "",
    "fn main():",
    "    numbers: [4]i32 = [10, 25, 40, 85]",
    "    print(find_index(numbers, 99).value_or(1000))",
    "    print(find_index(numbers, 40).value_or(1000))"
   ],
   "hint": "把 `.value_or(1000)` 放在两个调用的末尾。",
   "expected": [
    "1000",
    "2"
   ]
