{
 "title": "Practice: a safe text parser",
 "blocks": [
  {
   "t": "p",
   "text": "A function turning text into a number uses `Result` and enum errors together. Character ranges are compared like `'0'..'9'`; a digit's value is found with `c - '0'`."
  },
  {
   "t": "code",
   "code": [
    "enum ParseError:",
    "    EmptyInput",
    "    InvalidFormat",
    "",
    "fn parse_positive(input: str) -> Result[i32, ParseError]:",
    "    if input.len == 0:",
    "        return Err(ParseError.EmptyInput)",
    "    total = 0",
    "    for i in 0..input.len:",
    "        c = input[i]",
    "        if c < '0' or c > '9':",
    "            return Err(ParseError.InvalidFormat)",
    "        total = total * 10 + i32(c - '0')",
    "    return Ok(total)",
    "",
    "fn main():",
    "    inputs: [3]str = [\"1234\", \"\", \"42a\"]",
    "    for s in inputs:",
    "        match parse_positive(s):",
    "            Ok(num):",
    "                print(\"parsed:\", num)",
    "            Err(e):",
    "                match e:",
    "                    ParseError.EmptyInput:",
    "                        print(\"error: input is empty\")",
    "                    ParseError.InvalidFormat:",
    "                        print(\"error: invalid character in\", s)"
   ],
   "run": true,
   "output": [
    "parsed: 1234",
    "error: input is empty",
    "error: invalid character in 42a"
   ]
  },
  {
   "t": "exercise",
   "id": "c08-l07-x1",
   "prompt": "Add a limit to `parse_positive`: for inputs longer than 5 characters return a new `TooLong` error. Try `\"123456\"`.",
   "starter": [
    "enum ParseError:",
    "    EmptyInput",
    "    InvalidFormat",
    "",
    "fn parse_positive(input: str) -> Result[i32, ParseError]:",
    "    if input.len == 0:",
    "        return Err(ParseError.EmptyInput)",
    "    total = 0",
    "    for i in 0..input.len:",
    "        c = input[i]",
    "        if c < '0' or c > '9':",
    "            return Err(ParseError.InvalidFormat)",
    "        total = total * 10 + i32(c - '0')",
    "    return Ok(total)",
    "",
    "fn main():",
    "    match parse_positive(\"123456\"):",
    "        Ok(n):",
    "            print(\"parsed:\", n)",
    "        Err(e):",
    "            match e:",
    "                ParseError.EmptyInput:",
    "                    print(\"empty\")",
    "                ParseError.InvalidFormat:",
    "                    print(\"invalid\")"
   ],
   "solution": [
    "enum ParseError:",
    "    EmptyInput",
    "    InvalidFormat",
    "    TooLong",
    "",
    "fn parse_positive(input: str) -> Result[i32, ParseError]:",
    "    if input.len == 0:",
    "        return Err(ParseError.EmptyInput)",
    "    if input.len > 5:",
    "        return Err(ParseError.TooLong)",
    "    total = 0",
    "    for i in 0..input.len:",
    "        c = input[i]",
    "        if c < '0' or c > '9':",
    "            return Err(ParseError.InvalidFormat)",
    "        total = total * 10 + i32(c - '0')",
    "    return Ok(total)",
    "",
    "fn main():",
    "    match parse_positive(\"123456\"):",
    "        Ok(n):",
    "            print(\"parsed:\", n)",
    "        Err(e):",
    "            match e:",
    "                ParseError.EmptyInput:",
    "                    print(\"empty\")",
    "                ParseError.InvalidFormat:",
    "                    print(\"invalid\")",
    "                ParseError.TooLong:",
    "                    print(\"too long\")"
   ],
   "hint": "Add the new variant to the enum, to the `match` and to a check.",
   "expected": [
    "too long"
   ]
  },
  {
   "t": "quiz",
   "id": "c08-l07-q1",
   "q": "What does `c - '0'` find?",
   "options": [
    "The ASCII code of the character",
    "The numeric value of a digit character",
    "The position of the character"
   ],
   "answer": 1,
   "why": "`'5' - '0'` = 5: digit characters are consecutive."
  }
 ]
}
