{
 "title": "A result that carries an error: Result",
 "blocks": [
  {
   "t": "p",
   "text": "When it matters why an operation failed you use `Result[T, E]`. `Ok(value)` carries success, `Err(error)` carries failure. The error is usually expressed with your own `enum`, so every kind of error has a name."
  },
  {
   "t": "code",
   "code": [
    "enum MathError:",
    "    DivisionByZero",
    "    NegativeSquareRoot",
    "",
    "fn safe_divide(a: f64, b: f64) -> Result[f64, MathError]:",
    "    if b == 0.0:",
    "        return Err(MathError.DivisionByZero)",
    "    return Ok(a / b)",
    "",
    "fn main():",
    "    match safe_divide(10.0, 4.0):",
    "        Ok(res):",
    "            print(\"result:\", res)",
    "        Err(e):",
    "            print(\"error\")",
    "    match safe_divide(10.0, 0.0):",
    "        Ok(res):",
    "            print(\"result:\", res)",
    "        Err(e):",
    "            match e:",
    "                MathError.DivisionByZero:",
    "                    print(\"division by zero prevented\")",
    "                MathError.NegativeSquareRoot:",
    "                    print(\"negative root\")"
   ],
   "run": true,
   "output": [
    "result: 2.5",
    "division by zero prevented"
   ]
  },
  {
   "t": "exercise",
   "id": "c08-l03-x1",
   "prompt": "Write `validate_age(age: i32) -> Result[i32, str]`: `Err(\"invalid age\")` if below 0 or above 150, otherwise `Ok(age)`. Print the result for 200 and 30 with `match`.",
   "starter": [
    "fn validate_age(age: i32) -> Result[i32, str]:",
    "    return Ok(age)",
    "",
    "fn show(age: i32):",
    "    match validate_age(age):",
    "        Ok(a):",
    "            print(\"ok\", a)",
    "        Err(msg):",
    "            print(\"error:\", msg)",
    "",
    "fn main():",
    "    show(200)",
    "    show(30)"
   ],
   "solution": [
    "fn validate_age(age: i32) -> Result[i32, str]:",
    "    if age < 0 or age > 150:",
    "        return Err(\"invalid age\")",
    "    return Ok(age)",
    "",
    "fn show(age: i32):",
    "    match validate_age(age):",
    "        Ok(a):",
    "            print(\"ok\", a)",
    "        Err(msg):",
    "            print(\"error:\", msg)",
    "",
    "fn main():",
    "    show(200)",
    "    show(30)"
   ],
   "hint": "`Err` with `if age < 0 or age > 150:`, then `Ok(age)`.",
   "expected": [
    "error: invalid age",
    "ok 30"
   ]
  },
  {
   "t": "quiz",
   "id": "c08-l03-q1",
   "q": "When is `Result` preferred over `Optional`?",
   "options": [
    "Never",
    "When the reason for failure matters",
    "Only with numbers"
   ],
   "answer": 1,
   "why": "`Result` carries the error information; `Optional` only says \"nothing\"."
  }
 ]
}
