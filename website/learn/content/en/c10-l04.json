{
 "title": "Sorting and searching: std.sort",
 "blocks": [
  {
   "t": "p",
   "text": "`sort.sort(list)` sorts a `List` in place (`T: Ord` is required); `sort.sort_by(list, rule)` sorts with your own rule; `sort.binary_search(list, x)` searches a **sorted** list quickly and returns an `Optional[usize]` (the position)."
  },
  {
   "t": "code",
   "code": [
    "import std.sort",
    "",
    "fn main():",
    "    v = List[i32]()",
    "    v.push(40)",
    "    v.push(10)",
    "    v.push(30)",
    "    v.push(20)",
    "    sort.sort(v)",
    "    for x in v:",
    "        print(x)",
    "    print(sort.is_sorted(v))",
    "    match sort.binary_search(v, 30):",
    "        Valid(i):",
    "            print(\"30 is at index\", i)",
    "        None:",
    "            print(\"not found\")"
   ],
   "run": true,
   "output": [
    "10",
    "20",
    "30",
    "40",
    "true",
    "30 is at index 2"
   ]
  },
