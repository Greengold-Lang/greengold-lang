{
 "title": "JSON: std.json",
 "blocks": [
  {
   "t": "p",
   "text": "`json.parse(text)` gives a `Result[Json, string]`. `Json` is an enum; `doc.get(\"key\")` takes a sub-value and `as_i64()`, `as_string()`, `as_bool()` ... extract it as an `Optional`. To build a new document use `json.object()`, `set`, `json.integer`, `json.text`; `to_text()` turns it into text."
  },
  {
   "t": "code",
   "code": [
    "import std.json",
    "",
    "fn main():",
    "    match json.parse(\"{\\\"name\\\": \\\"Ada\\\", \\\"age\\\": 36, \\\"tags\\\": [\\\"math\\\", \\\"code\\\"]}\"):",
    "        Ok(doc):",
    "            print(doc.get(\"name\").as_string().value_or(\"?\").as_str())",
    "            print(doc.get(\"age\").as_i64().value_or(0))",
    "            print(doc.get(\"tags\").len())",
    "        Err(msg):",
    "            print(\"bad json:\", msg.as_str())"
   ],
   "run": true,
   "output": [
    "Ada",
    "36",
    "2"
   ]
  },
  {
   "t": "code",
   "code": [
    "import std.json",
    "",
    "fn main():",
    "    doc = json.object()",
    "    doc.set(\"id\", json.integer(7))",
    "    doc.set(\"ok\", json.text(\"yes\"))",
    "    print(doc.to_text().as_str())"
   ],
   "run": true,
   "output": [
    "{\"id\":7,\"ok\":\"yes\"}"
   ]
  },
  {
   "t": "exercise",
   "id": "c10-l07-x1",
   "prompt": "Parse the JSON `{\"price\": 12, \"qty\": 3}` and print `price * qty`.",
   "starter": [
    "import std.json",
    "",
    "fn main():",
    "    match json.parse(\"{\\\"price\\\": 12, \\\"qty\\\": 3}\"):",
    "        Ok(doc):",
    "            print(0)",
    "        Err(msg):",
    "            print(\"bad json\")"
   ],
   "solution": [
    "import std.json",
    "",
    "fn main():",
    "    match json.parse(\"{\\\"price\\\": 12, \\\"qty\\\": 3}\"):",
    "        Ok(doc):",
    "            print(doc.get(\"price\").as_i64().value_or(0) * doc.get(\"qty\").as_i64().value_or(0))",
    "        Err(msg):",
    "            print(\"bad json\")"
   ],
   "hint": "Get the values with `doc.get(\"price\").as_i64().value_or(0)`.",
   "expected": [
    "36"
   ]
  },
  {
   "t": "quiz",
   "id": "c10-l07-q1",
   "q": "Why does `json.parse` return a `Result`?",
   "options": [
    "The text may be invalid JSON",
    "It always fails",
    "For speed"
   ],
   "answer": 0,
   "why": "An expected failure (bad input) is carried as a value with `Err`."
  }
 ]
}
