enum AppError:
    Parse(i32)
    Io

impl AppError:
    fn from(e: i32) -> AppError:
        return AppError.Parse(e)

fn parse(x: i32) -> Result[i32, i32]:
    if x < 0:
        return Err(x)
    return Ok(x * 2)

fn run(x: i32) -> Result[i32, AppError]:
    v = parse(x)?
    return Ok(v + 1)

fn main():
    match run(5):
        Ok(v):
            print("ok", v)
        Err(_):
            print("err")
    match run(-3):
        Ok(v):
            print("ok", v)
        Err(e):
            match e:
                Parse(n):
                    print("parse error", n)
                Io:
                    print("io")
