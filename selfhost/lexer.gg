# Token dump driver. The lexer itself lives in lex.gg so the parser can import it.
import std.fs
import std.process
import lex

fn main():
    text = fs.read_file_to_string("gg_selfhost_in.txt")
    match text:
        None:
            print("cannot read gg_selfhost_in.txt")
            process.process_exit(2)
        Valid(s):
            lx = lex.lexer_new(s.as_str())
            lx.run()
            lx.print_all()
            if lx.diags.len > 0:
                process.process_exit(1)
