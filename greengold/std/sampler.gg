# std.sampler: chooses the next token from the logits of a language model.
#
#     import std.sampler
#
#     s = sampler.Sampler.new(0.8, 40, 0.95, 1234)      # temperature, top-k, top-p, seed
#     token = s.sample(logits)
#     s.accept(token)                                    # remember it for the repeat penalty
#
# With temperature 0 the best token is always taken. Otherwise only the `top_k` best tokens are kept (0 means the
# 1024 best), their probabilities are `softmax(logit / temperature)`, the smallest group of them whose probabilities
# add up to `top_p` is kept, and one is drawn at random. The generator is seeded, so a run can be repeated.
import std.nn

public
struct Sampler:
    temperature: f32
    top_k: usize
    top_p: f32
    repeat_penalty: f32  # > 1 makes tokens of the last 64 that were accepted less likely (1 = off)
    history: List[i32]
    state: u64
    idx: List[i32]
    val: List[f32]

private
# xorshift64*: a uniform number in [0, 1).
fn _next(s: lend Sampler) -> f32:
    x = s.state
    x = x ^ (x >> 12)
    x = x ^ (x << 25)
    x = x ^ (x >> 27)
    s.state = x
    overflow: wrap
    r = x * 2685821657736338717
    return f32(r >> 40) / 16777216.0

public
impl Sampler:
    fn new(temperature: f32, top_k: usize, top_p: f32, seed: u64) -> Sampler:
        state = seed * 2654435761 + 88172645463325252
        if state == 0:
            state = 88172645463325252
        return Sampler{ temperature: temperature, top_k: top_k, top_p: top_p, repeat_penalty: 1.0, state: state,
            history: List[i32](), idx: List[i32](), val: List[f32]() }

    # Remembers a token of the text so far (prompt tokens and chosen ones) for the repeat penalty.
    fn accept(self: lend Sampler, token: i32):
        self.history.push(token)

    # Picks a token. `logits` is changed (the repeat penalty is applied to it in place).
    fn sample(self: lend Sampler, logits: lend []f32) -> i32:
        if self.repeat_penalty != 1.0:
            first: usize = 0
            if self.history.len() > 64:
                first = self.history.len() - 64
            for i in first..self.history.len():
                t = self.history[i]
                if t >= 0 and usize(t) < logits.len:
                    if logits[usize(t)] > 0.0:
                        logits[usize(t)] = logits[usize(t)] / self.repeat_penalty
                    else:
                        logits[usize(t)] = logits[usize(t)] * self.repeat_penalty
        if self.temperature <= 0.0:
            best: usize = 0
            for i in 1..logits.len:
                if logits[i] > logits[best]:
                    best = i
            return i32(best)
        k = self.top_k
        if k == 0:
            k = 1024
        if k > logits.len:
            k = logits.len
        # the k best, sorted from the best down
        self.idx.clear()
        self.val.clear()
        for i in 0..logits.len:
            v = logits[i]
            n = self.idx.len()
            if n == k and v <= self.val[n - 1]:
                continue
            if n < k:
                self.idx.push(0)
                self.val.push(0.0)
                n += 1
            j = n - 1
            while j > 0 and self.val[j - 1] < v:
                self.idx[j] = self.idx[j - 1]
                self.val[j] = self.val[j - 1]
                j -= 1
            self.idx[j] = i32(i)
            self.val[j] = v
        n = self.idx.len()
        top = self.val[0]
        total: f32 = 0.0
        for j in 0..n:
            self.val[j] = nn.exp((self.val[j] - top) / self.temperature)
            total += self.val[j]
        # keep the smallest group that reaches top_p
        keep = n
        if self.top_p < 1.0:
            acc: f32 = 0.0
            for j in 0..n:
                acc += self.val[j] / total
                if acc >= self.top_p:
                    keep = j + 1
                    break
        kept: f32 = 0.0
        for j in 0..keep:
            kept += self.val[j]
        r = _next(self) * kept
        acc2: f32 = 0.0
        for j in 0..keep:
            acc2 += self.val[j]
            if r < acc2:
                return self.idx[j]
        return self.idx[keep - 1]
