# std.kquant: the "K-quant" weight formats of llama.cpp, `Q4_K` and `Q6_K` (the formats of Q4_K_M files).
#
# Both store super-blocks of 256 values. `Q4_K` is 144 bytes: a 16-bit scale `d`, a 16-bit minimum scale `dmin`, 12
# bytes holding eight 6-bit scales and eight 6-bit minimums (one pair for each group of 32 values), and 128 bytes of
# 4-bit numbers: value = d * scale * q - dmin * min. `Q6_K` is 210 bytes: 128 bytes with the low four bits and 64 with
# the high two bits of 256 6-bit numbers, sixteen signed 8-bit scales (one for each group of 16), and `d`:
# value = d * scale * (q - 32). The matrix products take the activation as `Q8KVec` (blocks of 256 `i8` with an f32
# scale and the sums of each 16 values) and need the number of columns to be a multiple of 256.
import std.parallel
import std.tensor

private
extern "math.h" fn floorf(x: f32) -> f32

public
const SUPER: usize = 256

# One super-block of `Q4_K`: 144 bytes.
struct BlockQ4K:
    d: u16
    dmin: u16
    scales: [12]u8
    qs: [128]u8

# One super-block of `Q6_K`: 210 bytes.
struct BlockQ6K:
    ql: [128]u8
    qh: [64]u8
    scales: [16]i8
    d: u16

# One super-block of the activation: 292 bytes.
struct BlockQ8K:
    d: f32
    qs: [256]i8
    bsums: [16]i16

# A vector quantized for the K-quant products.
struct Q8KVec:
    blocks: List[BlockQ8K]
    len: usize

fn quantize_q8k(x: []f32) -> Q8KVec:
    out = Q8KVec{ blocks: List[BlockQ8K](), len: x.len }
    quantize_q8k_into(x, out)
    return out

# The same into an existing `Q8KVec`, reusing its memory.
fn quantize_q8k_into(x: []f32, out: lend Q8KVec):
    if x.len % SUPER != 0:
        panic("quantize_q8k: the length must be a multiple of 256")
    out.blocks.clear()
    out.len = x.len
    n = x.len / SUPER
    out.blocks.reserve(n)
    for b in 0..n:
        base = b * SUPER
        amax: f32 = 0.0
        for j in 0..SUPER:
            v = x[base + j]
            if v < 0.0:
                v = 0.0 - v
            if v > amax:
                amax = v
        d = amax / 127.0
        id: f32 = 0.0
        if d != 0.0:
            id = 1.0 / d
        qs: [256]i8 = [0; 256]
        bsums: [16]i16 = [0; 16]
        for j in 0..SUPER:
            q = i32(floorf(x[base + j] * id + 0.5))
            qs[j] = i8(q)
            bsums[j / 16] = bsums[j / 16] + i16(q)
        out.blocks.push(BlockQ8K{ d: d, qs: qs, bsums: bsums })

impl Q8KVec:
    # Back to f32 (for tests and debugging).
    public
    fn dequantize(self: read Q8KVec) -> List[f32]:
        out = List[f32]()
        for b in 0..self.blocks.len():
            for j in 0..SUPER:
                out.push(self.blocks[b].d * f32(self.blocks[b].qs[j]))
        return out

private
# The scale and minimum of group `j` (0..8) of a `Q4_K` super-block.
fn _scale_min(s: [12]u8, j: usize) -> (i32, i32):
    if j < 4:
        return (i32(s[j] & 63), i32(s[j + 4] & 63))
    lo = i32(s[j + 4] & 15)
    hi = i32(s[j + 4] >> 4)
    top_a = i32(s[j - 4] >> 6)
    top_b = i32(s[j] >> 6)
    return (lo | (top_a << 4), hi | (top_b << 4))

# The dot product of one row of `Q4_K` weights with a `Q8_K` vector, `nb` super-blocks each.
fn _row_dot_q4k(w: []BlockQ4K, wbase: usize, x: []BlockQ8K, nb: usize) -> f32:
    facc = f32x8.splat(0.0)
    corr: f32 = 0.0
    chunks: usize = 4
    for b in 0..nb:
        sm = w[wbase + b].scales
        qs = w[wbase + b].qs[..]
        xq = x[b].qs[..]
        acc = i32x8.splat(0)
        for c in 0..chunks:
            s0, m0 = _scale_min(sm, 2 * c)
            s1, m1 = _scale_min(sm, 2 * c + 1)
            v = u8x32.load(qs, c * 32)
            p0 = i32x8.splat(0).dot_u4i8(v & u8x32.splat(15), i8x32.load(xq, c * 64))
            p1 = i32x8.splat(0).dot_u4i8(v.shr(4), i8x32.load(xq, c * 64 + 32))
            acc = acc + p0 * i32x8.splat(s0) + p1 * i32x8.splat(s1)
            bs = x[b].bsums
            msum = m0 * (i32(bs[4 * c]) + i32(bs[4 * c + 1])) + m1 * (i32(bs[4 * c + 2]) + i32(bs[4 * c + 3]))
            corr += tensor.f16_scale(w[wbase + b].dmin) * x[b].d * f32(msum)
        facc = acc.to_f32().fma(f32x8.splat(tensor.f16_scale(w[wbase + b].d) * x[b].d), facc)
    return facc.sum() - corr

# The same for `Q6_K`.
fn _row_dot_q6k(w: []BlockQ6K, wbase: usize, x: []BlockQ8K, nb: usize) -> f32:
    facc = f32x8.splat(0.0)
    corr: f32 = 0.0
    halves: usize = 2
    m4 = u8x32.splat(15)
    m3 = u8x32.splat(3)
    for b in 0..nb:
        ql = w[wbase + b].ql[..]
        qh = w[wbase + b].qh[..]
        sc = w[wbase + b].scales
        xq = x[b].qs[..]
        acc = i32x8.splat(0)
        for h in 0..halves:
            v0 = u8x32.load(ql, 64 * h)
            v1 = u8x32.load(ql, 64 * h + 32)
            hq = u8x32.load(qh, 32 * h)
            q1 = (v0 & m4) | (hq & m3).shl(4)
            q2 = (v1 & m4) | (hq.shr(2) & m3).shl(4)
            q3 = v0.shr(4) | (hq.shr(4) & m3).shl(4)
            q4 = v1.shr(4) | (hq.shr(6) & m3).shl(4)
            g = 8 * h
            s1 = i32x8(i32(sc[g]), i32(sc[g]), i32(sc[g]), i32(sc[g]), i32(sc[g + 1]), i32(sc[g + 1]), i32(sc[g + 1]), i32(sc[g + 1]))
            s2 = i32x8(i32(sc[g + 2]), i32(sc[g + 2]), i32(sc[g + 2]), i32(sc[g + 2]), i32(sc[g + 3]), i32(sc[g + 3]), i32(sc[g + 3]), i32(sc[g + 3]))
            s3 = i32x8(i32(sc[g + 4]), i32(sc[g + 4]), i32(sc[g + 4]), i32(sc[g + 4]), i32(sc[g + 5]), i32(sc[g + 5]), i32(sc[g + 5]), i32(sc[g + 5]))
            s4 = i32x8(i32(sc[g + 6]), i32(sc[g + 6]), i32(sc[g + 6]), i32(sc[g + 6]), i32(sc[g + 7]), i32(sc[g + 7]), i32(sc[g + 7]), i32(sc[g + 7]))
            acc = acc + i32x8.splat(0).dot_u4i8(q1, i8x32.load(xq, 128 * h)) * s1
            acc = acc + i32x8.splat(0).dot_u4i8(q2, i8x32.load(xq, 128 * h + 32)) * s2
            acc = acc + i32x8.splat(0).dot_u4i8(q3, i8x32.load(xq, 128 * h + 64)) * s3
            acc = acc + i32x8.splat(0).dot_u4i8(q4, i8x32.load(xq, 128 * h + 96)) * s4
        bs = x[b].bsums
        csum: i32 = 0
        for k in 0..16:
            csum += i32(sc[k]) * i32(bs[k])
        dd = tensor.f16_scale(w[wbase + b].d) * x[b].d
        facc = acc.to_f32().fma(f32x8.splat(dd), facc)
        corr += dd * 32.0 * f32(csum)
    return facc.sum() - corr

struct _JobQ4K:
    w: []BlockQ4K
    x: []BlockQ8K
    y: *mut f32
    nb: usize

struct _JobQ6K:
    w: []BlockQ6K
    x: []BlockQ8K
    y: *mut f32
    nb: usize

fn _rows_q4k(start: usize, end: usize, ctx: *u8):
    unsafe:
        job = ptr_cast[*_JobQ4K](ctx)
        for r in start..end:
            job[0].y[r] = _row_dot_q4k(job[0].w, r * job[0].nb, job[0].x, job[0].nb)

fn _rows_q6k(start: usize, end: usize, ctx: *u8):
    unsafe:
        job = ptr_cast[*_JobQ6K](ctx)
        for r in start..end:
            job[0].y[r] = _row_dot_q6k(job[0].w, r * job[0].nb, job[0].x, job[0].nb)

public
# y = W x for `rows` x `cols` weights in `Q4_K` super-blocks (`cols` a multiple of 256) and a `Q8_K` vector.
fn q4k_matvec(w: []BlockQ4K, rows: usize, cols: usize, x: read Q8KVec, y: lend []f32):
    nb = cols / SUPER
    if x.len != cols or y.len != rows or w.len != rows * nb:
        panic("q4k_matvec: the sizes do not match")
    xs = x.blocks[..]
    for r in 0..rows:
        y[r] = _row_dot_q4k(w, r * nb, xs, nb)

# The same with the rows shared between the threads of `pool`.
fn q4k_matvec_parallel(pool: lend parallel.Pool, w: []BlockQ4K, rows: usize, cols: usize, x: read Q8KVec, y: lend []f32):
    nb = cols / SUPER
    if x.len != cols or y.len != rows or w.len != rows * nb:
        panic("q4k_matvec_parallel: the sizes do not match")
    unsafe:
        job = _JobQ4K{ w: w, x: x.blocks[..], y: ptr_cast[*mut f32](addr_mut(y)), nb: nb }
        pool.for_range(rows, _rows_q4k, ptr_cast[*u8](addr(job)))

fn q6k_matvec(w: []BlockQ6K, rows: usize, cols: usize, x: read Q8KVec, y: lend []f32):
    nb = cols / SUPER
    if x.len != cols or y.len != rows or w.len != rows * nb:
        panic("q6k_matvec: the sizes do not match")
    xs = x.blocks[..]
    for r in 0..rows:
        y[r] = _row_dot_q6k(w, r * nb, xs, nb)

fn q6k_matvec_parallel(pool: lend parallel.Pool, w: []BlockQ6K, rows: usize, cols: usize, x: read Q8KVec, y: lend []f32):
    nb = cols / SUPER
    if x.len != cols or y.len != rows or w.len != rows * nb:
        panic("q6k_matvec_parallel: the sizes do not match")
    unsafe:
        job = _JobQ6K{ w: w, x: x.blocks[..], y: ptr_cast[*mut f32](addr_mut(y)), nb: nb }
        pool.for_range(rows, _rows_q6k, ptr_cast[*u8](addr(job)))

# Row `r` of a `Q4_K` matrix with `cols` columns, as f32.
fn dequantize_row_q4k(w: []BlockQ4K, cols: usize, r: usize) -> List[f32]:
    out = List[f32]()
    nb = cols / SUPER
    chunks: usize = 4
    for b in 0..nb:
        sm = w[r * nb + b].scales
        d = tensor.f16_to_f32(w[r * nb + b].d)
        dmin = tensor.f16_to_f32(w[r * nb + b].dmin)
        for c in 0..chunks:
            s0, m0 = _scale_min(sm, 2 * c)
            s1, m1 = _scale_min(sm, 2 * c + 1)
            for l in 0..32:
                out.push(d * f32(s0) * f32(i32(w[r * nb + b].qs[c * 32 + l] & 15)) - dmin * f32(m0))
            for l in 0..32:
                out.push(d * f32(s1) * f32(i32(w[r * nb + b].qs[c * 32 + l] >> 4)) - dmin * f32(m1))
    return out

# Row `r` of a `Q6_K` matrix with `cols` columns, as f32.
fn dequantize_row_q6k(w: []BlockQ6K, cols: usize, r: usize) -> List[f32]:
    out = List[f32]()
    nb = cols / SUPER
    for b in 0..nb:
        d = tensor.f16_to_f32(w[r * nb + b].d)
        for i in 0..SUPER:
            h = i / 128
            k = (i % 128) / 32
            l = i % 32
            lo_byte = w[r * nb + b].ql[64 * h + l + 32 * (k % 2)]
            nib = i32(lo_byte & 15)
            if k >= 2:
                nib = i32(lo_byte >> 4)
            top = i32((w[r * nb + b].qh[32 * h + l] >> u8(2 * k)) & 3)
            q = (nib | (top << 4)) - 32
            sc = i32(w[r * nb + b].scales[8 * h + 2 * k + l / 16])
            out.push(d * f32(sc) * f32(q))
    return out
