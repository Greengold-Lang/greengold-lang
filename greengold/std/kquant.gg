# std.kquant: the "K-quant" weight formats of llama.cpp, `Q4_K` and `Q6_K` (the formats of Q4_K_M files).
#
# Both store super-blocks of 256 values. `Q4_K` is 144 bytes: a 16-bit scale `d`, a 16-bit minimum scale `dmin`, 12
# bytes holding eight 6-bit scales and eight 6-bit minimums (one pair for each group of 32 values), and 128 bytes of
# 4-bit numbers: value = d * scale * q - dmin * min. `Q6_K` is 210 bytes: 128 bytes with the low four bits and 64 with
# the high two bits of 256 6-bit numbers, sixteen signed 8-bit scales (one for each group of 16), and `d`:
# value = d * scale * (q - 32). The matrix products take the activation as `Q8KVec` (blocks of 256 `i8` with an f32
# scale and the sums of each 16 values) and need the number of columns to be a multiple of 256.
#
# A product reads the scales and minimums of a row of weights once and then uses them for every vector of a batch,
# so the work per vector is only the integer dot products.
import std.parallel
import std.tensor

private
extern "math.h" fn floorf(x: f32) -> f32

public
const SUPER: usize = 256

# One super-block of `Q4_K`: 144 bytes.
struct BlockQ4K:
    d: u16
    dmin: u16
    scales: [12]u8
    qs: [128]u8

# One super-block of `Q6_K`: 210 bytes.
struct BlockQ6K:
    ql: [128]u8
    qh: [64]u8
    scales: [16]i8
    d: u16

# One super-block of the activation: 324 bytes.
struct BlockQ8K:
    d: f32
    qs: [256]i8
    bsums: [16]i32  # the sum of each group of 16 values

# A vector quantized for the K-quant products. It may hold several vectors one after another (a batch).
struct Q8KVec:
    blocks: List[BlockQ8K]
    len: usize

fn quantize_q8k(x: []f32) -> Q8KVec:
    out = Q8KVec{ blocks: List[BlockQ8K](), len: x.len }
    quantize_q8k_into(x, out)
    return out

# The same into an existing `Q8KVec`, reusing its memory. `x` may be several vectors one after another, each a
# multiple of 256 long: their blocks come out the same as if they were quantized one by one.
fn quantize_q8k_into(x: []f32, out: lend Q8KVec):
    if x.len % SUPER != 0:
        panic("quantize_q8k: the length must be a multiple of 256")
    out.blocks.clear()
    out.len = x.len
    n = x.len / SUPER
    out.blocks.reserve(n)
    for b in 0..n:
        base = b * SUPER
        amax: f32 = 0.0
        for j in 0..SUPER:
            v = x[base + j]
            if v < 0.0:
                v = 0.0 - v
            if v > amax:
                amax = v
        d = amax / 127.0
        id: f32 = 0.0
        if d != 0.0:
            id = 1.0 / d
        qs: [256]i8 = [0; 256]
        bsums: [16]i32 = [0; 16]
        for j in 0..SUPER:
            q = i32(floorf(x[base + j] * id + 0.5))
            qs[j] = i8(q)
            bsums[j / 16] = bsums[j / 16] + q
        out.blocks.push(BlockQ8K{ d: d, qs: qs, bsums: bsums })

impl Q8KVec:
    # Back to f32 (for tests and debugging).
    public
    fn dequantize(self: read Q8KVec) -> List[f32]:
        out = List[f32]()
        for b in 0..self.blocks.len():
            for j in 0..SUPER:
                out.push(self.blocks[b].d * f32(self.blocks[b].qs[j]))
        return out

private
# The scale and minimum of group `j` (0..8) of a `Q4_K` super-block.
fn _scale_min(s: [12]u8, j: usize) -> (i32, i32):
    if j < 4:
        return (i32(s[j] & 63), i32(s[j + 4] & 63))
    lo = i32(s[j + 4] & 15)
    hi = i32(s[j + 4] >> 4)
    top_a = i32(s[j - 4] >> 6)
    top_b = i32(s[j] >> 6)
    return (lo | (top_a << 4), hi | (top_b << 4))

# What a row of weights contributes besides its 4-bit or 6-bit numbers, read out once for all the vectors:
#   sc    the scale of each group (8 per Q4_K super-block, 16 per Q6_K), as the multiplier of the dot product
#   coef  for each group of 16: the minimum (Q4_K) or 32 * scale (Q6_K) that multiplies the sum of the vector's values
#   dd    the block's `d`, dm the block's `dmin` (Q4_K)
struct _RowInfo:
    sc: List[i32]
    coef: List[i32]
    dd: List[f32]
    dm: List[f32]

fn _row_info(nb: usize, per_scale: usize) -> _RowInfo:
    info = _RowInfo{ sc: List[i32](), coef: List[i32](), dd: List[f32](), dm: List[f32]() }
    for i in 0..nb * per_scale:
        info.sc.push(0)
    for i in 0..nb * 16:
        info.coef.push(0)
    for i in 0..nb:
        info.dd.push(0.0)
        info.dm.push(0.0)
    return info

fn _decode_q4k(w: []BlockQ4K, wbase: usize, nb: usize, info: lend _RowInfo):
    groups: usize = 8
    for b in 0..nb:
        sm = w[wbase + b].scales
        for g in 0..groups:
            s, m = _scale_min(sm, g)
            info.sc[b * 8 + g] = s
            info.coef[b * 16 + 2 * g] = m
            info.coef[b * 16 + 2 * g + 1] = m
        info.dd[b] = tensor.f16_scale(w[wbase + b].d)
        info.dm[b] = tensor.f16_scale(w[wbase + b].dmin)

fn _decode_q6k(w: []BlockQ6K, wbase: usize, nb: usize, info: lend _RowInfo):
    groups: usize = 16
    for b in 0..nb:
        for g in 0..groups:
            s = i32(w[wbase + b].scales[g])
            info.sc[b * 16 + g] = s
            info.coef[b * 16 + g] = 32 * s
        info.dd[b] = tensor.f16_scale(w[wbase + b].d)

# The dot product of the row of `Q4_K` weights that `_decode_q4k` read with one `Q8_K` vector of `nb` super-blocks.
fn _dot_q4k(w: []BlockQ4K, wbase: usize, info: _RowInfo, x: []BlockQ8K, nb: usize) -> f32:
    facc = f32x8.splat(0.0)
    cacc = f32x8.splat(0.0)
    chunks: usize = 4
    m15 = u8x32.splat(15)
    for b in 0..nb:
        qs = w[wbase + b].qs[..]
        xq = x[b].qs[..]
        acc = i32x8.splat(0)
        for c in 0..chunks:
            v = u8x32.load(qs, c * 32)
            s0 = info.sc[b * 8 + 2 * c]
            s1 = info.sc[b * 8 + 2 * c + 1]
            acc = acc.dot_u4i8_scaled(v & m15, i8x32.load(xq, c * 64), s0, s0)
            acc = acc.dot_u4i8_scaled(v.shr(4), i8x32.load(xq, c * 64 + 32), s1, s1)
        xd = x[b].d
        facc = acc.to_f32().fma(f32x8.splat(info.dd[b] * xd), facc)
        bs = x[b].bsums[..]
        mins = i32x8.load(info.coef[..], b * 16) * i32x8.load(bs, 0) + i32x8.load(info.coef[..], b * 16 + 8) * i32x8.load(bs, 8)
        cacc = mins.to_f32().fma(f32x8.splat(info.dm[b] * xd), cacc)
    return facc.sum() - cacc.sum()

# The same for `Q6_K`.
fn _dot_q6k(w: []BlockQ6K, wbase: usize, info: _RowInfo, x: []BlockQ8K, nb: usize) -> f32:
    facc = f32x8.splat(0.0)
    cacc = f32x8.splat(0.0)
    halves: usize = 2
    m4 = u8x32.splat(15)
    m3 = u8x32.splat(3)
    for b in 0..nb:
        ql = w[wbase + b].ql[..]
        qh = w[wbase + b].qh[..]
        xq = x[b].qs[..]
        acc = i32x8.splat(0)
        for h in 0..halves:
            v0 = u8x32.load(ql, 64 * h)
            v1 = u8x32.load(ql, 64 * h + 32)
            hq = u8x32.load(qh, 32 * h)
            q1 = (v0 & m4) | (hq & m3).shl(4)
            q2 = (v1 & m4) | (hq.shr(2) & m3).shl(4)
            q3 = v0.shr(4) | (hq.shr(4) & m3).shl(4)
            q4 = v1.shr(4) | (hq.shr(6) & m3).shl(4)
            g = b * 16 + 8 * h
            acc = acc.dot_u4i8_scaled(q1, i8x32.load(xq, 128 * h), info.sc[g], info.sc[g + 1])
            acc = acc.dot_u4i8_scaled(q2, i8x32.load(xq, 128 * h + 32), info.sc[g + 2], info.sc[g + 3])
            acc = acc.dot_u4i8_scaled(q3, i8x32.load(xq, 128 * h + 64), info.sc[g + 4], info.sc[g + 5])
            acc = acc.dot_u4i8_scaled(q4, i8x32.load(xq, 128 * h + 96), info.sc[g + 6], info.sc[g + 7])
        dx = info.dd[b] * x[b].d
        facc = acc.to_f32().fma(f32x8.splat(dx), facc)
        bs = x[b].bsums[..]
        cs = i32x8.load(info.coef[..], b * 16) * i32x8.load(bs, 0) + i32x8.load(info.coef[..], b * 16 + 8) * i32x8.load(bs, 8)
        cacc = cs.to_f32().fma(f32x8.splat(dx), cacc)
    return facc.sum() - cacc.sum()

# Four vectors at once: a weight block is unpacked once for all of them.
fn _dot4_q4k(w: []BlockQ4K, wbase: usize, info: _RowInfo, x0: []BlockQ8K, x1: []BlockQ8K, x2: []BlockQ8K, x3: []BlockQ8K, nb: usize) -> (f32, f32, f32, f32):
    f0 = f32x8.splat(0.0)
    m0 = f32x8.splat(0.0)
    f1 = f32x8.splat(0.0)
    m1 = f32x8.splat(0.0)
    f2 = f32x8.splat(0.0)
    m2 = f32x8.splat(0.0)
    f3 = f32x8.splat(0.0)
    m3 = f32x8.splat(0.0)
    chunks: usize = 4
    m15 = u8x32.splat(15)
    for b in 0..nb:
        qs = w[wbase + b].qs[..]
        y0 = x0[b].qs[..]
        a0 = i32x8.splat(0)
        y1 = x1[b].qs[..]
        a1 = i32x8.splat(0)
        y2 = x2[b].qs[..]
        a2 = i32x8.splat(0)
        y3 = x3[b].qs[..]
        a3 = i32x8.splat(0)
        for c in 0..chunks:
            v = u8x32.load(qs, c * 32)
            lo = v & m15
            hi = v.shr(4)
            s0 = info.sc[b * 8 + 2 * c]
            s1 = info.sc[b * 8 + 2 * c + 1]
            a0 = a0.dot_u4i8_scaled(lo, i8x32.load(y0, c * 64), s0, s0)
            a0 = a0.dot_u4i8_scaled(hi, i8x32.load(y0, c * 64 + 32), s1, s1)
            a1 = a1.dot_u4i8_scaled(lo, i8x32.load(y1, c * 64), s0, s0)
            a1 = a1.dot_u4i8_scaled(hi, i8x32.load(y1, c * 64 + 32), s1, s1)
            a2 = a2.dot_u4i8_scaled(lo, i8x32.load(y2, c * 64), s0, s0)
            a2 = a2.dot_u4i8_scaled(hi, i8x32.load(y2, c * 64 + 32), s1, s1)
            a3 = a3.dot_u4i8_scaled(lo, i8x32.load(y3, c * 64), s0, s0)
            a3 = a3.dot_u4i8_scaled(hi, i8x32.load(y3, c * 64 + 32), s1, s1)
        c0 = i32x8.load(info.coef[..], b * 16)
        c1 = i32x8.load(info.coef[..], b * 16 + 8)
        dd = info.dd[b]
        dm = info.dm[b]
        e0 = x0[b].d
        b0 = x0[b].bsums[..]
        f0 = a0.to_f32().fma(f32x8.splat(dd * e0), f0)
        m0 = (c0 * i32x8.load(b0, 0) + c1 * i32x8.load(b0, 8)).to_f32().fma(f32x8.splat(dm * e0), m0)
        e1 = x1[b].d
        b1 = x1[b].bsums[..]
        f1 = a1.to_f32().fma(f32x8.splat(dd * e1), f1)
        m1 = (c0 * i32x8.load(b1, 0) + c1 * i32x8.load(b1, 8)).to_f32().fma(f32x8.splat(dm * e1), m1)
        e2 = x2[b].d
        b2 = x2[b].bsums[..]
        f2 = a2.to_f32().fma(f32x8.splat(dd * e2), f2)
        m2 = (c0 * i32x8.load(b2, 0) + c1 * i32x8.load(b2, 8)).to_f32().fma(f32x8.splat(dm * e2), m2)
        e3 = x3[b].d
        b3 = x3[b].bsums[..]
        f3 = a3.to_f32().fma(f32x8.splat(dd * e3), f3)
        m3 = (c0 * i32x8.load(b3, 0) + c1 * i32x8.load(b3, 8)).to_f32().fma(f32x8.splat(dm * e3), m3)
    return (f0.sum() - m0.sum(), f1.sum() - m1.sum(), f2.sum() - m2.sum(), f3.sum() - m3.sum())

fn _dot4_q6k(w: []BlockQ6K, wbase: usize, info: _RowInfo, x0: []BlockQ8K, x1: []BlockQ8K, x2: []BlockQ8K, x3: []BlockQ8K, nb: usize) -> (f32, f32, f32, f32):
    f0 = f32x8.splat(0.0)
    m0 = f32x8.splat(0.0)
    f1 = f32x8.splat(0.0)
    m1 = f32x8.splat(0.0)
    f2 = f32x8.splat(0.0)
    m2 = f32x8.splat(0.0)
    f3 = f32x8.splat(0.0)
    m3 = f32x8.splat(0.0)
    halves: usize = 2
    mask4 = u8x32.splat(15)
    mask3 = u8x32.splat(3)
    for b in 0..nb:
        ql = w[wbase + b].ql[..]
        qh = w[wbase + b].qh[..]
        y0 = x0[b].qs[..]
        a0 = i32x8.splat(0)
        y1 = x1[b].qs[..]
        a1 = i32x8.splat(0)
        y2 = x2[b].qs[..]
        a2 = i32x8.splat(0)
        y3 = x3[b].qs[..]
        a3 = i32x8.splat(0)
        for h in 0..halves:
            v0 = u8x32.load(ql, 64 * h)
            v1 = u8x32.load(ql, 64 * h + 32)
            hq = u8x32.load(qh, 32 * h)
            q1 = (v0 & mask4) | (hq & mask3).shl(4)
            q2 = (v1 & mask4) | (hq.shr(2) & mask3).shl(4)
            q3 = v0.shr(4) | (hq.shr(4) & mask3).shl(4)
            q4 = v1.shr(4) | (hq.shr(6) & mask3).shl(4)
            g = b * 16 + 8 * h
            a0 = a0.dot_u4i8_scaled(q1, i8x32.load(y0, 128 * h), info.sc[g], info.sc[g + 1])
            a0 = a0.dot_u4i8_scaled(q2, i8x32.load(y0, 128 * h + 32), info.sc[g + 2], info.sc[g + 3])
            a0 = a0.dot_u4i8_scaled(q3, i8x32.load(y0, 128 * h + 64), info.sc[g + 4], info.sc[g + 5])
            a0 = a0.dot_u4i8_scaled(q4, i8x32.load(y0, 128 * h + 96), info.sc[g + 6], info.sc[g + 7])
            a1 = a1.dot_u4i8_scaled(q1, i8x32.load(y1, 128 * h), info.sc[g], info.sc[g + 1])
            a1 = a1.dot_u4i8_scaled(q2, i8x32.load(y1, 128 * h + 32), info.sc[g + 2], info.sc[g + 3])
            a1 = a1.dot_u4i8_scaled(q3, i8x32.load(y1, 128 * h + 64), info.sc[g + 4], info.sc[g + 5])
            a1 = a1.dot_u4i8_scaled(q4, i8x32.load(y1, 128 * h + 96), info.sc[g + 6], info.sc[g + 7])
            a2 = a2.dot_u4i8_scaled(q1, i8x32.load(y2, 128 * h), info.sc[g], info.sc[g + 1])
            a2 = a2.dot_u4i8_scaled(q2, i8x32.load(y2, 128 * h + 32), info.sc[g + 2], info.sc[g + 3])
            a2 = a2.dot_u4i8_scaled(q3, i8x32.load(y2, 128 * h + 64), info.sc[g + 4], info.sc[g + 5])
            a2 = a2.dot_u4i8_scaled(q4, i8x32.load(y2, 128 * h + 96), info.sc[g + 6], info.sc[g + 7])
            a3 = a3.dot_u4i8_scaled(q1, i8x32.load(y3, 128 * h), info.sc[g], info.sc[g + 1])
            a3 = a3.dot_u4i8_scaled(q2, i8x32.load(y3, 128 * h + 32), info.sc[g + 2], info.sc[g + 3])
            a3 = a3.dot_u4i8_scaled(q3, i8x32.load(y3, 128 * h + 64), info.sc[g + 4], info.sc[g + 5])
            a3 = a3.dot_u4i8_scaled(q4, i8x32.load(y3, 128 * h + 96), info.sc[g + 6], info.sc[g + 7])
        c0 = i32x8.load(info.coef[..], b * 16)
        c1 = i32x8.load(info.coef[..], b * 16 + 8)
        dd = info.dd[b]
        e0 = dd * x0[b].d
        b0 = x0[b].bsums[..]
        f0 = a0.to_f32().fma(f32x8.splat(e0), f0)
        m0 = (c0 * i32x8.load(b0, 0) + c1 * i32x8.load(b0, 8)).to_f32().fma(f32x8.splat(e0), m0)
        e1 = dd * x1[b].d
        b1 = x1[b].bsums[..]
        f1 = a1.to_f32().fma(f32x8.splat(e1), f1)
        m1 = (c0 * i32x8.load(b1, 0) + c1 * i32x8.load(b1, 8)).to_f32().fma(f32x8.splat(e1), m1)
        e2 = dd * x2[b].d
        b2 = x2[b].bsums[..]
        f2 = a2.to_f32().fma(f32x8.splat(e2), f2)
        m2 = (c0 * i32x8.load(b2, 0) + c1 * i32x8.load(b2, 8)).to_f32().fma(f32x8.splat(e2), m2)
        e3 = dd * x3[b].d
        b3 = x3[b].bsums[..]
        f3 = a3.to_f32().fma(f32x8.splat(e3), f3)
        m3 = (c0 * i32x8.load(b3, 0) + c1 * i32x8.load(b3, 8)).to_f32().fma(f32x8.splat(e3), m3)
    return (f0.sum() - m0.sum(), f1.sum() - m1.sum(), f2.sum() - m2.sum(), f3.sum() - m3.sum())

struct _MatJobQ4K:
    w: []BlockQ4K
    x: []BlockQ8K
    y: *mut f32
    nb: usize
    rows: usize
    nvec: usize

struct _MatJobQ6K:
    w: []BlockQ6K
    x: []BlockQ8K
    y: *mut f32
    nb: usize
    rows: usize
    nvec: usize

# Each row of weights is read out once and used for all the vectors before the next row is read, so it stays in the
# cache.
fn _mat_rows_q4k(start: usize, end: usize, ctx: *u8):
    unsafe:
        job = ptr_cast[*_MatJobQ4K](ctx)
        info = _row_info(job[0].nb, 8)
        for r in start..end:
            _decode_q4k(job[0].w, r * job[0].nb, job[0].nb, info)
            nb = job[0].nb
            a: usize = 0
            while a + 4 <= job[0].nvec:
                f0, f1, f2, f3 = _dot4_q4k(job[0].w, r * nb, info, job[0].x[a * nb..(a + 1) * nb], job[0].x[(a + 1) * nb..(a + 2) * nb],
                    job[0].x[(a + 2) * nb..(a + 3) * nb], job[0].x[(a + 3) * nb..(a + 4) * nb], nb)
                job[0].y[a * job[0].rows + r] = f0
                job[0].y[(a + 1) * job[0].rows + r] = f1
                job[0].y[(a + 2) * job[0].rows + r] = f2
                job[0].y[(a + 3) * job[0].rows + r] = f3
                a += 4
            while a < job[0].nvec:
                job[0].y[a * job[0].rows + r] = _dot_q4k(job[0].w, r * nb, info, job[0].x[a * nb..(a + 1) * nb], nb)
                a += 1

fn _mat_rows_q6k(start: usize, end: usize, ctx: *u8):
    unsafe:
        job = ptr_cast[*_MatJobQ6K](ctx)
        info = _row_info(job[0].nb, 16)
        for r in start..end:
            _decode_q6k(job[0].w, r * job[0].nb, job[0].nb, info)
            nb = job[0].nb
            a: usize = 0
            while a + 4 <= job[0].nvec:
                f0, f1, f2, f3 = _dot4_q6k(job[0].w, r * nb, info, job[0].x[a * nb..(a + 1) * nb], job[0].x[(a + 1) * nb..(a + 2) * nb],
                    job[0].x[(a + 2) * nb..(a + 3) * nb], job[0].x[(a + 3) * nb..(a + 4) * nb], nb)
                job[0].y[a * job[0].rows + r] = f0
                job[0].y[(a + 1) * job[0].rows + r] = f1
                job[0].y[(a + 2) * job[0].rows + r] = f2
                job[0].y[(a + 3) * job[0].rows + r] = f3
                a += 4
            while a < job[0].nvec:
                job[0].y[a * job[0].rows + r] = _dot_q6k(job[0].w, r * nb, info, job[0].x[a * nb..(a + 1) * nb], nb)
                a += 1

public
# y = W x for `rows` x `cols` weights in `Q4_K` super-blocks (`cols` a multiple of 256) and a `Q8_K` vector.
fn q4k_matvec(w: []BlockQ4K, rows: usize, cols: usize, x: read Q8KVec, y: lend []f32):
    nb = cols / SUPER
    if x.len != cols or y.len != rows or w.len != rows * nb:
        panic("q4k_matvec: the sizes do not match")
    unsafe:
        job = _MatJobQ4K{ w: w, x: x.blocks[..], y: ptr_cast[*mut f32](addr_mut(y)), nb: nb, rows: rows, nvec: 1 }
        _mat_rows_q4k(0, rows, ptr_cast[*u8](addr(job)))

# The same with the rows shared between the threads of `pool`.
fn q4k_matvec_parallel(pool: lend parallel.Pool, w: []BlockQ4K, rows: usize, cols: usize, x: read Q8KVec, y: lend []f32):
    q4k_matmul_parallel(pool, w, rows, cols, 1, x, y)

# y = W x for `nvec` vectors at once (a batch of tokens): `x` holds them one after another (a `Q8KVec` of
# `nvec * cols` values) and `y` receives `nvec * rows` values, vector after vector. Every weight is read from memory
# once for the whole batch, so this is much faster per vector than `nvec` calls of `q4k_matvec` when the weights
# do not fit in the cache. The rows are shared between the threads of `pool`.
fn q4k_matmul_parallel(pool: lend parallel.Pool, w: []BlockQ4K, rows: usize, cols: usize, nvec: usize, x: read Q8KVec, y: lend []f32):
    nb = cols / SUPER
    if x.len != cols * nvec or y.len != rows * nvec or w.len != rows * nb:
        panic("q4k_matmul_parallel: the sizes do not match")
    unsafe:
        job = _MatJobQ4K{ w: w, x: x.blocks[..], y: ptr_cast[*mut f32](addr_mut(y)), nb: nb, rows: rows, nvec: nvec }
        pool.for_range(rows, _mat_rows_q4k, ptr_cast[*u8](addr(job)))

fn q6k_matvec(w: []BlockQ6K, rows: usize, cols: usize, x: read Q8KVec, y: lend []f32):
    nb = cols / SUPER
    if x.len != cols or y.len != rows or w.len != rows * nb:
        panic("q6k_matvec: the sizes do not match")
    unsafe:
        job = _MatJobQ6K{ w: w, x: x.blocks[..], y: ptr_cast[*mut f32](addr_mut(y)), nb: nb, rows: rows, nvec: 1 }
        _mat_rows_q6k(0, rows, ptr_cast[*u8](addr(job)))

fn q6k_matvec_parallel(pool: lend parallel.Pool, w: []BlockQ6K, rows: usize, cols: usize, x: read Q8KVec, y: lend []f32):
    q6k_matmul_parallel(pool, w, rows, cols, 1, x, y)

fn q6k_matmul_parallel(pool: lend parallel.Pool, w: []BlockQ6K, rows: usize, cols: usize, nvec: usize, x: read Q8KVec, y: lend []f32):
    nb = cols / SUPER
    if x.len != cols * nvec or y.len != rows * nvec or w.len != rows * nb:
        panic("q6k_matmul_parallel: the sizes do not match")
    unsafe:
        job = _MatJobQ6K{ w: w, x: x.blocks[..], y: ptr_cast[*mut f32](addr_mut(y)), nb: nb, rows: rows, nvec: nvec }
        pool.for_range(rows, _mat_rows_q6k, ptr_cast[*u8](addr(job)))

# Row `r` of a `Q4_K` matrix with `cols` columns, as f32.
fn dequantize_row_q4k(w: []BlockQ4K, cols: usize, r: usize) -> List[f32]:
    out = List[f32]()
    nb = cols / SUPER
    chunks: usize = 4
    for b in 0..nb:
        sm = w[r * nb + b].scales
        d = tensor.f16_to_f32(w[r * nb + b].d)
        dmin = tensor.f16_to_f32(w[r * nb + b].dmin)
        for c in 0..chunks:
            s0, m0 = _scale_min(sm, 2 * c)
            s1, m1 = _scale_min(sm, 2 * c + 1)
            for l in 0..32:
                out.push(d * f32(s0) * f32(i32(w[r * nb + b].qs[c * 32 + l] & 15)) - dmin * f32(m0))
            for l in 0..32:
                out.push(d * f32(s1) * f32(i32(w[r * nb + b].qs[c * 32 + l] >> 4)) - dmin * f32(m1))
    return out

# Row `r` of a `Q6_K` matrix with `cols` columns, as f32.
fn dequantize_row_q6k(w: []BlockQ6K, cols: usize, r: usize) -> List[f32]:
    out = List[f32]()
    nb = cols / SUPER
    for b in 0..nb:
        d = tensor.f16_to_f32(w[r * nb + b].d)
        for i in 0..SUPER:
            h = i / 128
            k = (i % 128) / 32
            l = i % 32
            lo_byte = w[r * nb + b].ql[64 * h + l + 32 * (k % 2)]
            nib = i32(lo_byte & 15)
            if k >= 2:
                nib = i32(lo_byte >> 4)
            top = i32((w[r * nb + b].qh[32 * h + l] >> u8(2 * k)) & 3)
            q = (nib | (top << 4)) - 32
            sc = i32(w[r * nb + b].scales[8 * h + 2 * k + l / 16])
            out.push(d * f32(sc) * f32(q))
    return out
