# std.encoding: text encodings (hex, base64, base32) and checksums (CRC-32, CRC-32C, CRC-16, CRC-8, Adler-32,
# Fletcher-16).
#
#     import std.encoding
#     text = encoding.base64_encode("hello".as_bytes())          # aGVsbG8=
#     bytes = encoding.base64_decode(text.as_str()).value_or_panic()
#     print(encoding.crc32("123456789".as_bytes()))               # 3421780262
#
# Byte data goes in as `[]u8` (a `List[u8]`, an array, or `text.as_bytes()`). The checksums use small 16-entry tables
# held in constants, so they need no setup and no heap. A checksum finds accidental damage; it is no defense against
# someone who changes the data on purpose (use `std.hash` for that).

const CRC32_TABLE: [16]u32 = [0x00000000, 0x1DB71064, 0x3B6E20C8, 0x26D930AC, 0x76DC4190, 0x6B6B51F4, 0x4DB26158, 0x5005713C, 0xEDB88320, 0xF00F9344, 0xD6D6A3E8, 0xCB61B38C, 0x9B64C2B0, 0x86D3D2D4, 0xA00AE278, 0xBDBDF21C]
const CRC32C_TABLE: [16]u32 = [0x00000000, 0x105EC76F, 0x20BD8EDE, 0x30E349B1, 0x417B1DBC, 0x5125DAD3, 0x61C69362, 0x7198540D, 0x82F63B78, 0x92A8FC17, 0xA24BB5A6, 0xB21572C9, 0xC38D26C4, 0xD3D3E1AB, 0xE330A81A, 0xF36E6F75]
const CRC16_MODBUS_TABLE: [16]u16 = [0x0000, 0xCC01, 0xD801, 0x1400, 0xF001, 0x3C00, 0x2800, 0xE401, 0xA001, 0x6C00, 0x7800, 0xB401, 0x5000, 0x9C01, 0x8801, 0x4400]
const CRC16_CCITT_TABLE: [16]u16 = [0x0000, 0x1021, 0x2042, 0x3063, 0x4084, 0x50A5, 0x60C6, 0x70E7, 0x8108, 0x9129, 0xA14A, 0xB16B, 0xC18C, 0xD1AD, 0xE1CE, 0xF1EF]

# -- checksums ----------------------------------------------------------------------------------------------

# CRC-32 (IEEE 802.3, as in zip, PNG, Ethernet). `crc32_update(crc32_update(0, a), b)` equals the CRC of `a` then `b`.
fn crc32(data: []u8) -> u32:
    return crc32_update(0, data)

fn crc32_update(crc: u32, data: []u8) -> u32:
    c: u32 = ~crc
    for b in data:
        c = c ^ u32(b)
        c = (c >> 4) ^ CRC32_TABLE[c & 15]
        c = (c >> 4) ^ CRC32_TABLE[c & 15]
    return ~c

# CRC-32C (Castagnoli, as in iSCSI, ext4, SCTP).
fn crc32c(data: []u8) -> u32:
    return crc32c_update(0, data)

fn crc32c_update(crc: u32, data: []u8) -> u32:
    c: u32 = ~crc
    for b in data:
        c = c ^ u32(b)
        c = (c >> 4) ^ CRC32C_TABLE[c & 15]
        c = (c >> 4) ^ CRC32C_TABLE[c & 15]
    return ~c

# CRC-16/MODBUS (polynomial 0xA001 reflected, initial value 0xFFFF; the low byte is sent first on the wire).
fn crc16_modbus(data: []u8) -> u16:
    c: u16 = 65535
    for b in data:
        c = c ^ u16(b)
        c = (c >> 4) ^ CRC16_MODBUS_TABLE[c & 15]
        c = (c >> 4) ^ CRC16_MODBUS_TABLE[c & 15]
    return c

# CRC-16/CCITT-FALSE (polynomial 0x1021, initial value 0xFFFF, no reflection; used by CCSDS packets, Bluetooth, AUTOSAR). Not the CRC of X.25 or HDLC (that one is reflected and inverted).
fn crc16_ccitt(data: []u8) -> u16:
    return crc16_ccitt_update(65535, data)

fn crc16_ccitt_update(crc: u16, data: []u8) -> u16:
    c: u16 = crc
    for b in data:
        c = c ^ (u16(b) << 8)
        c = (c << 4) ^ CRC16_CCITT_TABLE[c >> 12]
        c = (c << 4) ^ CRC16_CCITT_TABLE[c >> 12]
    return c

# CRC-8 (polynomial 0x07, initial value 0).
fn crc8(data: []u8) -> u8:
    c: u8 = 0
    for b in data:
        c = c ^ b
        for _ in 0..8:
            if (c & 128) != 0:
                c = (c << 1) ^ 7
            else:
                c = c << 1
    return c

fn adler32(data: []u8) -> u32:
    a: u32 = 1
    b: u32 = 0
    for x in data:
        a = (a + u32(x)) % 65521
        b = (b + a) % 65521
    return (b << 16) | a

fn fletcher16(data: []u8) -> u16:
    a: u16 = 0
    b: u16 = 0
    for x in data:
        a = (a + u16(x)) % 255
        b = (b + a) % 255
    return (b << 8) | a

# -- hex ----------------------------------------------------------------------------------------------------

fn hex_encode(data: []u8) -> string:
    out = string.new()
    for b in data:
        out.append_byte(_hex_digit(b >> 4))
        out.append_byte(_hex_digit(b & 15))
    return out

private
fn _hex_digit(n: u8) -> u8:
    if n < 10:
        return 48 + n
    return 87 + n

fn _hex_value(c: u8) -> i32:
    if c >= '0' and c <= '9':
        return i32(c - '0')
    if c >= 'a' and c <= 'f':
        return i32(c - 'a') + 10
    if c >= 'A' and c <= 'F':
        return i32(c - 'A') + 10
    return -1

public
# Reads pairs of hex digits (either case). Spaces, newlines and `:` between bytes are skipped.
fn hex_decode(text: str) -> Result[List[u8], string]:
    out = List[u8]()
    hi = -1
    for i in 0..text.len:
        c = text[i]
        if c == ' ' or c == ':' or c == '\n' or c == '\r':
            continue
        v = _hex_value(c)
        if v < 0:
            return Err(f"not a hex digit at position {i}")
        if hi < 0:
            hi = v
        else:
            out.push(u8(hi * 16 + v))
            hi = -1
    if hi >= 0:
        return Err(string.from("odd number of hex digits"))
    return Ok(out)

# -- base64 and base32 ------------------------------------------------------------------------------------------

private
fn _b64_char(n: u32, url: bool) -> u8:
    if n < 26:
        return u8(65 + n)
    if n < 52:
        return u8(97 + n - 26)
    if n < 62:
        return u8(48 + n - 52)
    if n == 62:
        if url:
            return '-'
        return '+'
    if url:
        return '_'
    return '/'

fn _b64_encode(data: []u8, url: bool, pad: bool) -> string:
    out = string.new()
    i: usize = 0
    n = data.len
    while i + 2 < n:
        v = (u32(data[i]) << 16) | (u32(data[i + 1]) << 8) | u32(data[i + 2])
        out.append_byte(_b64_char(v >> 18, url))
        out.append_byte(_b64_char((v >> 12) & 63, url))
        out.append_byte(_b64_char((v >> 6) & 63, url))
        out.append_byte(_b64_char(v & 63, url))
        i += 3
    rest = n - i
    if rest == 1:
        v1 = u32(data[i]) << 16
        out.append_byte(_b64_char(v1 >> 18, url))
        out.append_byte(_b64_char((v1 >> 12) & 63, url))
        if pad:
            out.append_str("==")
    elif rest == 2:
        v2 = (u32(data[i]) << 16) | (u32(data[i + 1]) << 8)
        out.append_byte(_b64_char(v2 >> 18, url))
        out.append_byte(_b64_char((v2 >> 12) & 63, url))
        out.append_byte(_b64_char((v2 >> 6) & 63, url))
        if pad:
            out.append_byte('=')
    return out

fn _b64_value(c: u8) -> i32:
    if c >= 'A' and c <= 'Z':
        return i32(c - 'A')
    if c >= 'a' and c <= 'z':
        return i32(c - 'a') + 26
    if c >= '0' and c <= '9':
        return i32(c - '0') + 52
    if c == '+' or c == '-':
        return 62
    if c == '/' or c == '_':
        return 63
    return -1

public
# Standard base64 (`+` and `/`) with `=` padding.
fn base64_encode(data: []u8) -> string:
    return _b64_encode(data, false, true)

# URL- and filename-safe base64 (`-` and `_`) without padding, as in JWTs.
fn base64url_encode(data: []u8) -> string:
    return _b64_encode(data, true, false)

# Reads either alphabet, with or without `=` padding; whitespace is skipped. Anything else is an error.
fn base64_decode(text: str) -> Result[List[u8], string]:
    out = List[u8]()
    acc: u32 = 0
    bits: u32 = 0
    padding = 0
    for i in 0..text.len:
        c = text[i]
        if c == ' ' or c == '\n' or c == '\r' or c == '\t':
            continue
        if c == '=':
            padding += 1
            continue
        if padding > 0:
            return Err(f"data after the padding at position {i}")
        v = _b64_value(c)
        if v < 0:
            return Err(f"not a base64 character at position {i}")
        acc = ((acc << 6) | u32(v)) & 0xFFFFFF
        bits += 6
        if bits >= 8:
            bits -= 8
            out.push(u8((acc >> bits) & 255))
    if bits >= 6:
        return Err(string.from("incomplete base64 input"))
    return Ok(out)

# RFC 4648 base32 (`A`-`Z`, `2`-`7`) with `=` padding.
fn base32_encode(data: []u8) -> string:
    out = string.new()
    acc: u32 = 0
    bits: u32 = 0
    for b in data:
        acc = ((acc << 8) | u32(b)) & 0xFFFFFF
        bits += 8
        while bits >= 5:
            bits -= 5
            out.append_byte(_b32_char((acc >> bits) & 31))
    if bits > 0:
        out.append_byte(_b32_char((acc << (5 - bits)) & 31))
    while out.len() % 8 != 0:
        out.append_byte('=')
    return out

private
fn _b32_char(n: u32) -> u8:
    if n < 26:
        return u8(65 + n)
    return u8(50 + n - 26)

public
fn base32_decode(text: str) -> Result[List[u8], string]:
    out = List[u8]()
    acc: u32 = 0
    bits: u32 = 0
    for i in 0..text.len:
        c = text[i]
        if c == '=' or c == ' ':
            continue
        v: i32 = -1
        if c >= 'A' and c <= 'Z':
            v = i32(c - 'A')
        elif c >= 'a' and c <= 'z':
            v = i32(c - 'a')
        elif c >= '2' and c <= '7':
            v = i32(c - '2') + 26
        if v < 0:
            return Err(f"not a base32 character at position {i}")
        acc = ((acc << 5) | u32(v)) & 0xFFFFFF
        bits += 5
        if bits >= 8:
            bits -= 8
            out.push(u8((acc >> bits) & 255))
    return Ok(out)
