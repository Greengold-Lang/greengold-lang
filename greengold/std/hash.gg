# std.hash: cryptographic hashes and keyed hashes. SHA-256, SHA-384, SHA-512 (streaming `Sha256` / `Sha512`, or in one
# call), SHA-3 and SHAKE, SHA-1 (legacy), HMAC, HKDF and PBKDF2.
#
#     import std.hash
#     import std.encoding
#     d = hash.sha256("abc".as_bytes())
#     print(encoding.hex_encode(d))        # ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad
#     mac = hash.hmac_sha256(key, message)
#
# Byte data goes in as `[]u8` (a `List[u8]`, an array, or `text.as_bytes()`). The code is portable Greengold with no libc:
# it works with `--no-std`. It is not hardened against timing or power analysis beyond using no secret-dependent
# branches or table lookups (SHA-2 and SHA-3 here have none). Compare MACs and digests with `crypto.constant_time_eq`,
# never with `==`.

