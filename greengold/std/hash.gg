const KECCAK_RC: [24]u64 = [
    0x0000000000000001, 0x0000000000008082,
    0x800000000000808A, 0x8000000080008000,
    0x000000000000808B, 0x0000000080000001,
    0x8000000080008081, 0x8000000000008009,
    0x000000000000008A, 0x0000000000000088,
    0x0000000080008009, 0x000000008000000A,
    0x000000008000808B, 0x800000000000008B,
    0x8000000000008089, 0x8000000000008003,
    0x8000000000008002, 0x8000000000000080,
    0x000000000000800A, 0x800000008000000A,
    0x8000000080008081, 0x8000000000008080,
    0x0000000080000001, 0x8000000080008008
]

const KECCAK_ROT: [25]u32 = [0, 1, 62, 28, 27, 36, 44, 6, 55, 20, 3, 10, 43, 25, 39, 41, 45, 15, 21, 8, 18, 2, 61, 56, 14]

# -- helpers ------------------------------------------------------------------------------------------------

fn _rotr32(x: u32, n: u32) -> u32:
    return (x >> n) | (x << (32 - n))

fn _rotr64(x: u64, n: u32) -> u64:
    return (x >> n) | (x << (64 - n))

fn _rotl64(x: u64, n: u32) -> u64:
    if n == 0:
        return x
    return (x << n) | (x >> (64 - n))

fn _be32(d: []u8, at: usize) -> u32:
    return (u32(d[at]) << 24) | (u32(d[at + 1]) << 16) | (u32(d[at + 2]) << 8) | u32(d[at + 3])

fn _be64(d: []u8, at: usize) -> u64:
    return (u64(_be32(d, at)) << 32) | u64(_be32(d, at + 4))

fn _le64(d: []u8, at: usize) -> u64:
    r: u64 = 0
    for i in 0..8:
        r = r | (u64(d[at + i]) << u32(8 * i))
    return r

# -- SHA-256 ---------------------------------------------------------------------------------------------------

public
# Incremental SHA-256: `update` with any pieces, then `finish`. A `Sha256` is a plain value (it can be copied to
# fork a hash in progress).
struct Sha256:
    state: [8]u32
    block: [64]u8
    filled: usize
    total: u64

fn sha256_new() -> Sha256:
    return Sha256{ state: SHA256_H0, block: [0; 64], filled: 0, total: 0 }

private
fn _sha256_compress(state: lend [8]u32, data: []u8, at: usize):
    overflow: wrap
    w: [64]u32 = [0; 64]
    for i in 0..16:
        w[i] = _be32(data, at + usize(i) * 4)
    for i in 16..64:
        s0 = _rotr32(w[i - 15], 7) ^ _rotr32(w[i - 15], 18) ^ (w[i - 15] >> 3)
        s1 = _rotr32(w[i - 2], 17) ^ _rotr32(w[i - 2], 19) ^ (w[i - 2] >> 10)
        w[i] = w[i - 16] + s0 + w[i - 7] + s1
    a = state[0]
    b = state[1]
    c = state[2]
    d = state[3]
    e = state[4]
    f = state[5]
    g = state[6]
    h = state[7]
    for i in 0..64:
        s1 = _rotr32(e, 6) ^ _rotr32(e, 11) ^ _rotr32(e, 25)
        ch = (e & f) ^ (~e & g)
        t1 = h + s1 + ch + SHA256_K[i] + w[i]
        s0 = _rotr32(a, 2) ^ _rotr32(a, 13) ^ _rotr32(a, 22)
        maj = (a & b) ^ (a & c) ^ (b & c)
        t2 = s0 + maj
        h = g
        g = f
        f = e
        e = d + t1
        d = c
        c = b
        b = a
        a = t1 + t2
    state[0] = state[0] + a
    state[1] = state[1] + b
    state[2] = state[2] + c
    state[3] = state[3] + d
    state[4] = state[4] + e
    state[5] = state[5] + f
    state[6] = state[6] + g
    state[7] = state[7] + h

public
impl Sha256:
    fn update(self: lend Self, data: []u8):
        self.total += u64(data.len)
        i: usize = 0
        if self.filled > 0:
            while i < data.len and self.filled < 64:
                self.block[self.filled] = data[i]
                self.filled += 1
                i += 1
            if self.filled == 64:
                _sha256_compress(self.state, self.block, 0)
                self.filled = 0
        while i + 64 <= data.len:
            _sha256_compress(self.state, data, i)
            i += 64
        while i < data.len:
            self.block[self.filled] = data[i]
            self.filled += 1
            i += 1

    # The 32-byte digest. The `Sha256` is spent: start a new one for another message.
    fn finish(self: lend Self) -> [32]u8:
        bits = self.total * 8
        self.update([128])
        while self.filled != 56:
            self.update([0])
        tail: [8]u8 = [0; 8]
        for i in 0..8:
            tail[i] = u8((bits >> u32(56 - 8 * i)) & 255)
        self.update(tail)
        out: [32]u8 = [0; 32]
        for i in 0..8:
            for j in 0..4:
                out[i * 4 + j] = u8((self.state[i] >> u32(24 - 8 * j)) & 255)
        return out

public
fn sha256(data: []u8) -> [32]u8:
    h = sha256_new()
    h.update(data)
    return h.finish()

# -- SHA-512 and SHA-384 -------------------------------------------------------------------------------------------

public
struct Sha512:
    state: [8]u64
    block: [128]u8
    filled: usize
    total: u64
    digest_len: usize

fn sha512_new() -> Sha512:
    return Sha512{ state: SHA512_H0, block: [0; 128], filled: 0, total: 0, digest_len: 64 }

fn sha384_new() -> Sha512:
    return Sha512{ state: SHA384_H0, block: [0; 128], filled: 0, total: 0, digest_len: 48 }

private
fn _sha512_compress(state: lend [8]u64, data: []u8, at: usize):
    overflow: wrap
    w: [80]u64 = [0; 80]
    for i in 0..16:
        w[i] = _be64(data, at + usize(i) * 8)
    for i in 16..80:
        s0 = _rotr64(w[i - 15], 1) ^ _rotr64(w[i - 15], 8) ^ (w[i - 15] >> 7)
        s1 = _rotr64(w[i - 2], 19) ^ _rotr64(w[i - 2], 61) ^ (w[i - 2] >> 6)
        w[i] = w[i - 16] + s0 + w[i - 7] + s1
    a = state[0]
    b = state[1]
    c = state[2]
    d = state[3]
    e = state[4]
    f = state[5]
    g = state[6]
    h = state[7]
    for i in 0..80:
        s1 = _rotr64(e, 14) ^ _rotr64(e, 18) ^ _rotr64(e, 41)
        ch = (e & f) ^ (~e & g)
        t1 = h + s1 + ch + SHA512_K[i] + w[i]
        s0 = _rotr64(a, 28) ^ _rotr64(a, 34) ^ _rotr64(a, 39)
        maj = (a & b) ^ (a & c) ^ (b & c)
        t2 = s0 + maj
        h = g
        g = f
        f = e
        e = d + t1
        d = c
        c = b
        b = a
        a = t1 + t2
    state[0] = state[0] + a
    state[1] = state[1] + b
    state[2] = state[2] + c
    state[3] = state[3] + d
    state[4] = state[4] + e
    state[5] = state[5] + f
    state[6] = state[6] + g
    state[7] = state[7] + h

public
impl Sha512:
    fn update(self: lend Self, data: []u8):
        self.total += u64(data.len)
        i: usize = 0
        if self.filled > 0:
            while i < data.len and self.filled < 128:
                self.block[self.filled] = data[i]
                self.filled += 1
                i += 1
            if self.filled == 128:
                _sha512_compress(self.state, self.block, 0)
                self.filled = 0
        while i + 128 <= data.len:
            _sha512_compress(self.state, data, i)
            i += 128
        while i < data.len:
            self.block[self.filled] = data[i]
            self.filled += 1
            i += 1

    # The digest: 64 bytes for SHA-512, 48 for SHA-384 (the list has that length).
    fn finish(self: lend Self) -> List[u8]:
        bits = self.total * 8
        keep = self.digest_len
        self.update([128])
        while self.filled != 112:
            self.update([0])
        tail: [16]u8 = [0; 16]
        for i in 0..8:
            tail[8 + i] = u8((bits >> u32(56 - 8 * i)) & 255)
        self.update(tail)
        out = List[u8]()
        for i in 0..8:
            for j in 0..8:
                if out.len < keep:
                    out.push(u8((self.state[i] >> u32(56 - 8 * j)) & 255))
        return out

public
fn sha512(data: []u8) -> List[u8]:
    h = sha512_new()
    h.update(data)
    return h.finish()

fn sha384(data: []u8) -> List[u8]:
    h = sha384_new()
    h.update(data)
    return h.finish()

# -- SHA-1 (broken for signatures: only for old protocols and file identification) ---------------------------------------

private
fn _sha1_compress(state: lend [5]u32, data: []u8, at: usize):
    overflow: wrap
    w: [80]u32 = [0; 80]
    for i in 0..16:
        w[i] = _be32(data, at + usize(i) * 4)
    for i in 16..80:
        x = w[i - 3] ^ w[i - 8] ^ w[i - 14] ^ w[i - 16]
        w[i] = (x << 1) | (x >> 31)
    a = state[0]
    b = state[1]
    c = state[2]
    d = state[3]
    e = state[4]
    for i in 0..80:
        f: u32 = 0
        k: u32 = 0
        if i < 20:
            f = (b & c) | (~b & d)
            k = 0x5A827999
        elif i < 40:
            f = b ^ c ^ d
            k = 0x6ED9EBA1
        elif i < 60:
            f = (b & c) | (b & d) | (c & d)
            k = 0x8F1BBCDC
        else:
            f = b ^ c ^ d
            k = 0xCA62C1D6
        t = ((a << 5) | (a >> 27)) + f + e + k + w[i]
        e = d
        d = c
        c = (b << 30) | (b >> 2)
        b = a
        a = t
    state[0] = state[0] + a
    state[1] = state[1] + b
    state[2] = state[2] + c
    state[3] = state[3] + d
    state[4] = state[4] + e

public
fn sha1(data: []u8) -> [20]u8:
    state: [5]u32 = [0x67452301, 0xEFCDAB89, 0x98BADCFE, 0x10325476, 0xC3D2E1F0]
    n = data.len
    full = (n / 64) * 64
    i: usize = 0
    while i < full:
        _sha1_compress(state, data, i)
        i += 64
    tail = List[u8]()
    for k in full..n:
        tail.push(data[k])
    tail.push(128)
    while tail.len % 64 != 56:
        tail.push(0)
    bits = u64(n) * 8
    for k in 0..8:
        tail.push(u8((bits >> u32(56 - 8 * k)) & 255))
    j: usize = 0
    while j < tail.len:
        _sha1_compress(state, tail, j)
        j += 64
    out: [20]u8 = [0; 20]
    for a in 0..5:
        for b in 0..4:
            out[a * 4 + b] = u8((state[a] >> u32(24 - 8 * b)) & 255)
    return out

# -- SHA-3 and SHAKE (Keccak) -----------------------------------------------------------------------------------------

private
fn _keccak_f(s: lend [25]u64):
    overflow: wrap
    c: [5]u64 = [0; 5]
    t: [25]u64 = [0; 25]
    for round in 0..24:
        for x in 0..5:
            c[x] = s[x] ^ s[x + 5] ^ s[x + 10] ^ s[x + 15] ^ s[x + 20]
        for x in 0..5:
            d = c[(x + 4) % 5] ^ _rotl64(c[(x + 1) % 5], 1)
            for y in 0..5:
                s[x + 5 * y] = s[x + 5 * y] ^ d
        # rho and pi: B[y][2x+3y] = rot(A[x][y], r[x][y])
        for x in 0..5:
            for y in 0..5:
                t[y + 5 * ((2 * x + 3 * y) % 5)] = _rotl64(s[x + 5 * y], KECCAK_ROT[x + 5 * y])
        for y in 0..5:
            for x in 0..5:
                s[x + 5 * y] = t[x + 5 * y] ^ (~t[(x + 1) % 5 + 5 * y] & t[(x + 2) % 5 + 5 * y])
        s[0] = s[0] ^ KECCAK_RC[round]

fn _keccak(data: []u8, rate: usize, suffix: u8, out_len: usize) -> List[u8]:
    s: [25]u64 = [0; 25]
    # absorb whole blocks, then the padded last block
    pos: usize = 0
    while data.len - pos >= rate:
        for i in 0..rate / 8:
            s[i] = s[i] ^ _le64(data, pos + i * 8)
        _keccak_f(s)
        pos += rate
    block = List[u8]()
    for k in pos..data.len:
        block.push(data[k])
    block.push(suffix)
    while block.len < rate:
        block.push(0)
    block[rate - 1] = block[rate - 1] | 128
    for i in 0..rate / 8:
        s[i] = s[i] ^ _le64(block, i * 8)
    _keccak_f(s)
    out = List[u8]()
    while true:
        for i in 0..rate:
            if out.len < out_len:
                out.push(u8((s[i / 8] >> u32(8 * (i % 8))) & 255))
        if out.len >= out_len:
            break
        _keccak_f(s)
    return out

public
fn sha3_256(data: []u8) -> List[u8]:
    return _keccak(data, 136, 6, 32)

fn sha3_384(data: []u8) -> List[u8]:
    return _keccak(data, 104, 6, 48)

fn sha3_512(data: []u8) -> List[u8]:
    return _keccak(data, 72, 6, 64)

# SHAKE128 / SHAKE256: hashes with an output of any length.
fn shake128(data: []u8, out_len: usize) -> List[u8]:
    return _keccak(data, 168, 31, out_len)

fn shake256(data: []u8, out_len: usize) -> List[u8]:
    return _keccak(data, 136, 31, out_len)

# -- HMAC, HKDF, PBKDF2 -----------------------------------------------------------------------------------------------

private
fn _digest(kind: i32, data: []u8) -> List[u8]:
    out = List[u8]()
    if kind == 1:
        d = sha1(data)
        for b in d:
            out.push(b)
    elif kind == 256:
        d2 = sha256(data)
        for b in d2:
            out.push(b)
    elif kind == 384:
        return sha384(data)
    else:
        return sha512(data)
    return out

fn _block_size(kind: i32) -> usize:
    if kind == 384 or kind == 512:
        return 128
    return 64

fn _hmac(kind: i32, key: []u8, data: []u8) -> List[u8]:
    bs = _block_size(kind)
    k = List[u8]()
    if key.len > bs:
        k = _digest(kind, key)
    else:
        for b in key:
            k.push(b)
    while k.len < bs:
        k.push(0)
    inner = List[u8]()
    outer = List[u8]()
    for i in 0..bs:
        inner.push(k[i] ^ 0x36)
        outer.push(k[i] ^ 0x5C)
    for b in data:
        inner.push(b)
    ih = _digest(kind, inner)
    for b in ih:
        outer.push(b)
    return _digest(kind, outer)

public
fn hmac_sha1(key: []u8, data: []u8) -> List[u8]:
    return _hmac(1, key, data)

fn hmac_sha256(key: []u8, data: []u8) -> List[u8]:
    return _hmac(256, key, data)

fn hmac_sha384(key: []u8, data: []u8) -> List[u8]:
    return _hmac(384, key, data)

fn hmac_sha512(key: []u8, data: []u8) -> List[u8]:
    return _hmac(512, key, data)

# HKDF (RFC 5869) with HMAC-SHA-256: `length` bytes of key material from `secret`, a `salt` (may be empty) and `info`.
# Panics when `length` is more than 255 * 32.
fn hkdf_sha256(secret: []u8, salt: []u8, info: []u8, length: usize) -> List[u8]:
    if length > 255 * 32:
        panic("hkdf_sha256: output too long")
    zero = List[u8]()
    for _ in 0..32:
        zero.push(0)
    prk = _hmac(256, zero, secret)
    if salt.len > 0:
        prk = _hmac(256, salt, secret)
    okm = List[u8]()
    prev = List[u8]()
    counter: u8 = 1
    while okm.len < length:
        msg = List[u8]()
        for b in prev:
            msg.push(b)
        for b in info:
            msg.push(b)
        msg.push(counter)
        prev = _hmac(256, prk, msg)
        for b in prev:
            if okm.len < length:
                okm.push(b)
        counter += 1
    return okm

# PBKDF2 (RFC 8018) with HMAC-SHA-256 or HMAC-SHA-512: stretches a password into `length` bytes of key. Use at least
# 600000 iterations of SHA-256 for passwords that people choose.
fn pbkdf2_sha256(password: []u8, salt: []u8, iterations: u32, length: usize) -> List[u8]:
    return _pbkdf2(256, password, salt, iterations, length)

fn pbkdf2_sha512(password: []u8, salt: []u8, iterations: u32, length: usize) -> List[u8]:
    return _pbkdf2(512, password, salt, iterations, length)

private
fn _pbkdf2(kind: i32, password: []u8, salt: []u8, iterations: u32, length: usize) -> List[u8]:
    if iterations == 0:
        panic("pbkdf2: iterations must be at least 1")
    out = List[u8]()
    block: u32 = 1
    while out.len < length:
        msg = List[u8]()
        for b in salt:
            msg.push(b)
        msg.push(u8(block >> 24))
        msg.push(u8((block >> 16) & 255))
        msg.push(u8((block >> 8) & 255))
        msg.push(u8(block & 255))
        u = _hmac(kind, password, msg)
        acc = u.clone()
        for _ in 1..iterations:
            u = _hmac(kind, password, u)
            for i in 0..acc.len:
                acc[i] = acc[i] ^ u[i]
        for b in acc:
            if out.len < length:
                out.push(b)
        block += 1
    return out
