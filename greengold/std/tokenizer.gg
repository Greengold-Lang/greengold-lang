# std.tokenizer: the tokenizer stored in a GGUF model file.
#
#     import std.gguf
#     import std.tokenizer
#
#     tok = tokenizer.Tokenizer.from_gguf(g)?
#     ids = tok.encode("Hello, world", true, true)    # text, add the BOS token, understand <|special|> tokens
#     print(tok.decode(ids))
#
# Two kinds are read, chosen by `tokenizer.ggml.model`:
#   `llama`  SentencePiece with BPE merges by score (LLaMA 1/2, TinyLlama, Mistral). Spaces become "▁", a "▁" is put
#            in front of the text, and bytes that no piece covers use the `<0xXX>` byte tokens.
#   `gpt2`   byte-level BPE with ranked merges (LLaMA 3 and others). The text is cut into words by the rules of the
#            LLaMA 3 pre-tokenizer; letters outside ASCII are treated as letters whatever their script, so text in
#            other scripts may be cut differently from the reference implementation.
# The token strings are views into the mapped model file: the `Gguf` must outlive the `Tokenizer`.
import std.collections
import std.gguf
import std.string

private
# U+2581, the SentencePiece space.
const SPACE_MARK: str = "▁"

fn _is_letter(c: u8) -> bool:
    return (c >= 65 and c <= 90) or (c >= 97 and c <= 122) or c >= 128

fn _is_digit(c: u8) -> bool:
    return c >= 48 and c <= 57

fn _is_space(c: u8) -> bool:
    return c == 32 or (c >= 9 and c <= 13)

fn _is_newline(c: u8) -> bool:
    return c == 10 or c == 13

fn _lower(c: u8) -> u8:
    if c >= 65 and c <= 90:
        return c + 32
    return c

# The code point that the byte-level BPE alphabet uses for byte `b` (the table of GPT-2).
fn _byte_cp(b: usize) -> u32:
    if (b >= 33 and b <= 126) or (b >= 161 and b <= 172) or b >= 174:
        return u32(b)
    n: u32 = 0
    for k in 0..b:
        if not ((k >= 33 and k <= 126) or (k >= 161 and k <= 172) or k >= 174):
            n += 1
    return 256 + n

# The length of the piece that begins at `i` in the LLaMA 3 pre-tokenizer pattern
#   (?i:'s|'t|'re|'ve|'m|'ll|'d) | [^\r\n\p{L}\p{N}]?\p{L}+ | \p{N}{1,3} | ' '?[^\s\p{L}\p{N}]+[\r\n]* | \s*[\r\n]+ | \s+(?!\S) | \s+
fn _piece_len(s: str, i: usize) -> usize:
    n = s.len
    c = s[i]
    if c == 39 and i + 1 < n:
        d = _lower(s[i + 1])
        if d == 115 or d == 116 or d == 109 or d == 100:
            return 2
        if i + 2 < n:
            e = _lower(s[i + 2])
            if (d == 114 and e == 101) or (d == 118 and e == 101) or (d == 108 and e == 108):
                return 3
    # an optional lead character, then letters
    j = i
    if not _is_letter(c) and not _is_digit(c) and not _is_newline(c):
        j = i + 1
    if j < n and _is_letter(s[j]):
        while j < n and _is_letter(s[j]):
            j += 1
        return j - i
    if _is_digit(c):
        j = i
        while j < n and j < i + 3 and _is_digit(s[j]):
            j += 1
        return j - i
    # an optional space, then symbols, then newlines
    j = i
    if c == 32:
        j = i + 1
    if j < n and not _is_space(s[j]) and not _is_letter(s[j]) and not _is_digit(s[j]):
        while j < n and not _is_space(s[j]) and not _is_letter(s[j]) and not _is_digit(s[j]):
            j += 1
        while j < n and _is_newline(s[j]):
            j += 1
        return j - i
    if _is_space(c):
        # \s*[\r\n]+ : whitespace up to and including the last newline of a run
        k = i
        last: usize = 0
        while k < n and _is_space(s[k]):
            if _is_newline(s[k]):
                last = k + 1
            k += 1
        if last > 0:
            return last - i
        # \s+(?!\S) : whitespace, but not the last space when a word follows it
        if k < n and k - i > 1:
            return k - i - 1
        return k - i
    return 1

public
struct Tokenizer:
    kind: i32           # 0 SentencePiece, 1 byte-level BPE
    tokens: List[str]   # token id -> text (views into the model file)
    scores: List[f32]   # SentencePiece: the score of each token
    types: List[i32]    # 1 normal, 2 unknown, 3 control, 4 user defined, 6 byte
    index: collections.HashMap[str, i32]
    ranks: collections.HashMap[str, i32]  # byte-level BPE: "left right" -> rank (lower merges first)
    specials: List[i32]       # ids of the control and user-defined tokens written like <...> or [...]
    byte_ids: List[i32]       # SentencePiece: the id of <0xXX> for each byte, or -1
    cp_to_byte: List[i32]     # byte-level BPE: code point -> byte, or -1
    bos: i32
    eos: i32
    unk: i32
    add_space_prefix: bool

impl Tokenizer:
    # Reads the vocabulary of `g`.
    public
    fn from_gguf(g: read gguf.Gguf) -> Result[Tokenizer, string]:
        model = g.get_str("tokenizer.ggml.model").value_or(string.from(""))
        kind: i32 = 0
        if model.as_str() == "gpt2":
            kind = 1
        elif model.as_str() != "llama":
            return Err(f"unsupported tokenizer model '{model.as_str()}'")
        tokens = g.array_strs("tokenizer.ggml.tokens")
        if tokens.len() == 0:
            return Err(string.from("the model file has no vocabulary"))
        scores = g.array_f32("tokenizer.ggml.scores")
        types = g.array_i32("tokenizer.ggml.token_type")
        index = collections.hashmap_new[str, i32]()
        for i in 0..tokens.len():
            index.insert(tokens[i], i32(i))
        ranks = collections.hashmap_new[str, i32]()
        if kind == 1:
            merges = g.array_strs("tokenizer.ggml.merges")
            if merges.len() == 0:
                return Err(string.from("the model file has no BPE merges"))
            for i in 0..merges.len():
                ranks.insert(merges[i], i32(i))
        specials = List[i32]()
        byte_ids = List[i32]()
        cp_to_byte = List[i32]()
        for i in 0..256:
            byte_ids.push(-1)
        for i in 0..400:
            cp_to_byte.push(-1)
        for b in 0..256:
            cp_to_byte[usize(_byte_cp(b))] = i32(b)
        for i in 0..tokens.len():
            t = 1
            if i < types.len():
                t = types[i]
            s = tokens[i]
            if t == 6 and s.len == 6 and s.starts_with("<0x") and s.ends_with(">"):
                hi = _hex(s[3])
                lo = _hex(s[4])
                if hi >= 0 and lo >= 0:
                    byte_ids[usize(hi * 16 + lo)] = i32(i)
            if (t == 3 or t == 4) and s.len >= 3 and ((s[0] == 60 and s[s.len - 1] == 62) or (s[0] == 91 and s[s.len - 1] == 93)):
                specials.push(i32(i))
        bos = i32(g.get_int("tokenizer.ggml.bos_token_id").value_or(1))
        eos = i32(g.get_int("tokenizer.ggml.eos_token_id").value_or(2))
        unk = i32(g.get_int("tokenizer.ggml.unknown_token_id").value_or(0))
        prefix = g.get_int("tokenizer.ggml.add_space_prefix").value_or(1) != 0
        return Ok(Tokenizer{ kind: kind, tokens: tokens, scores: scores, types: types, index: index, ranks: ranks,
            specials: specials, byte_ids: byte_ids, cp_to_byte: cp_to_byte, bos: bos, eos: eos,
            unk: unk, add_space_prefix: prefix })

    # The number of tokens.
    fn size(self: read Tokenizer) -> usize:
        return self.tokens.len()

    # True for the token that ends a reply (the end-of-sequence token and, for chat models, end-of-turn tokens).
    fn is_end(self: read Tokenizer, id: i32) -> bool:
        if id == self.eos:
            return true
        if id < 0 or usize(id) >= self.tokens.len():
            return true
        s = self.tokens[usize(id)]
        return s == "<|eot_id|>" or s == "<|end_of_text|>" or s == "<|im_end|>" or s == "<|endoftext|>"

    # Turns text into token ids. `add_bos` puts the beginning-of-sequence token first; `special` makes the text
    # `<|eot_id|>` (any special token of the vocabulary) one token instead of ordinary characters.
    fn encode(self: read Tokenizer, text: str, add_bos: bool, special: bool) -> List[i32]:
        out = List[i32]()
        if add_bos:
            out.push(self.bos)
        # cut the text at special tokens
        start: usize = 0
        i: usize = 0
        first = true
        while i < text.len:
            hit: i32 = -1
            if special and (text[i] == 60 or text[i] == 91):
                best: usize = 0
                for k in 0..self.specials.len():
                    s = self.tokens[usize(self.specials[k])]
                    if s.len > best and i + s.len <= text.len and text[i..i + s.len] == s:
                        best = s.len
                        hit = self.specials[k]
            if hit >= 0:
                if i > start:
                    self._encode_piece(text[start..i], first, out)
                    first = false
                out.push(hit)
                i += self.tokens[usize(hit)].len
                start = i
            else:
                i += 1
        if start < text.len:
            self._encode_piece(text[start..text.len], first, out)
        return out

    # Ordinary text (no special tokens) to ids, appended to `out`.
    fn _encode_piece(self: read Tokenizer, text: str, at_start: bool, out: lend List[i32]):
        if self.kind == 0:
            escaped = string.new()
            if self.add_space_prefix and at_start:
                escaped.append_str(SPACE_MARK)
            for i in 0..text.len:
                if text[i] == 32:
                    escaped.append_str(SPACE_MARK)
                else:
                    escaped.append_byte(text[i])
            self._merge(escaped.as_str(), out)
        else:
            i: usize = 0
            while i < text.len:
                n = _piece_len(text, i)
                mapped = string.new()
                for k in 0..n:
                    mapped.push_char(_byte_cp(usize(text[i + k])))
                self._merge(mapped.as_str(), out)
                i += n

    # The score of merging the symbols `a` and `b` (higher merges first), or -1e30 when the pair is not a merge.
    fn _pair_score(self: read Tokenizer, text: str, a0: usize, a1: usize, b1: usize, key: lend string) -> f32:
        if self.kind == 0:
            if let Valid(id) = self.index.get(text[a0..b1]):
                return self.scores[usize(id)]
            return -1e30
        key.clear()
        key.append_str(text[a0..a1])
        key.append_byte(32)
        key.append_str(text[a1..b1])
        if let Valid(rank) = self.ranks.get(key.as_str()):
            return 0.0 - f32(rank)
        return -1e30

    # Merges the characters of `text` into tokens and appends their ids to `out`.
    fn _merge(self: read Tokenizer, text: str, out: lend List[i32]):
        n = text.len
        if n == 0:
            return
        # symbols are ranges of `text`; `next[i]` is the symbol after i (or n), 0-length symbols are gone
        starts = List[usize]()
        ends = List[usize]()
        i: usize = 0
        while i < n:
            l = text.char_len_at(i)
            starts.push(i)
            ends.push(i + l)
            i += l
        m = starts.len()
        nxt = List[usize]()
        prev = List[usize]()
        alive = List[bool]()
        pair = List[f32]()
        for k in 0..m:
            nxt.push(k + 1)
            if k == 0:
                prev.push(0)
            else:
                prev.push(k - 1)
            alive.push(true)
            pair.push(-1e30)
        key = string.new()
        for k in 0..m:
            if k + 1 < m:
                pair[k] = self._pair_score(text, starts[k], ends[k], ends[k + 1], key)
        while true:
            best: usize = m
            bs: f32 = -1e29
            k: usize = 0
            while k < m:
                if alive[k] and pair[k] > bs:
                    bs = pair[k]
                    best = k
                k = nxt[k]
            if best == m:
                break
            r = nxt[best]
            ends[best] = ends[r]
            alive[r] = false
            nxt[best] = nxt[r]
            if nxt[r] < m:
                prev[nxt[r]] = best
            # the pair that begins at `best`, and the one that ends at it
            pair[best] = -1e30
            if nxt[best] < m:
                pair[best] = self._pair_score(text, starts[best], ends[best], ends[nxt[best]], key)
            if best > 0:
                p = prev[best]
                if p != best and alive[p] and nxt[p] == best:
                    pair[p] = self._pair_score(text, starts[p], ends[p], ends[best], key)
        pos: usize = 0
        while pos < m:
            k = pos
            if alive[k]:
                piece = text[starts[k]..ends[k]]
                if let Valid(id) = self.index.get(piece):
                    out.push(id)
                else:
                    for b in starts[k]..ends[k]:
                        id = self.byte_ids[usize(text[b])]
                        if id >= 0:
                            out.push(id)
                        else:
                            out.push(self.unk)
            pos = nxt[k]

    # The bytes of token `id` appended to `out` (a byte-level BPE token or a SentencePiece one).
    fn append_token(self: read Tokenizer, id: i32, out: lend string):
        if id < 0 or usize(id) >= self.tokens.len():
            return
        s = self.tokens[usize(id)]
        t = 1
        if usize(id) < self.types.len():
            t = self.types[usize(id)]
        if t == 3:
            return
        if self.kind == 0:
            if t == 6 and s.len == 6 and s.starts_with("<0x"):
                out.append_byte(u8(_hex(s[3]) * 16 + _hex(s[4])))
                return
            i: usize = 0
            while i < s.len:
                if i + 3 <= s.len and s[i] == 226 and s[i + 1] == 150 and s[i + 2] == 129:
                    out.append_byte(32)
                    i += 3
                else:
                    out.append_byte(s[i])
                    i += 1
        else:
            i: usize = 0
            while i < s.len:
                l = s.char_len_at(i)
                cp = s.char_at(i)
                if cp < 400 and self.cp_to_byte[usize(cp)] >= 0:
                    out.append_byte(u8(self.cp_to_byte[usize(cp)]))
                else:
                    for k in 0..l:
                        out.append_byte(s[i + k])
                i += l

    # The text of a list of ids.
    fn decode(self: read Tokenizer, ids: []i32) -> string:
        out = string.new()
        for i in 0..ids.len:
            self.append_token(ids[i], out)
        return out

private
fn _hex(c: u8) -> i32:
    if c >= 48 and c <= 57:
        return i32(c) - 48
    if c >= 65 and c <= 70:
        return i32(c) - 55
    if c >= 97 and c <= 102:
        return i32(c) - 87
    return -1
