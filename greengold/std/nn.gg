# std.nn: the f32 kernels of a transformer's forward pass: RMSNorm, RoPE, softmax, SiLU / SwiGLU, a KV cache and
# attention for one new token (grouped-query attention included).
#
#     import std.nn
#
#     nn.rmsnorm(x, weight, 1e-5, normed)             # normed = x / rms(x) * weight
#     nn.rope(q, n_heads, head_dim, pos, 10000.0, false)
#     cache.append(k, v)                              # the key and value of this token, at position cache.len()
#     nn.attention(q, cache, n_heads, out)            # out = softmax(q K^T / sqrt(d)) V for every head
#
# All of them work on slices of f32 and use 8-wide vectors, so build with `--cpu native` (or at least
# `--features +avx2,+fma`) for full speed. `exp` is a polynomial with a relative error near 1e-7, the same in every
# vector lane and for the leftover values at the end of a slice.
import std.math
import std.parallel

private
# e^x for 8 values at once. The input is clamped to [-87.3, 88.3], so the result is a normal float.
fn vexp(x: f32x8) -> f32x8:
    xc = x.max(f32x8.splat(-87.3)).min(f32x8.splat(88.3))
    n = xc.fma(f32x8.splat(1.44269504089), f32x8.splat(0.5)).floor()
    r = n.fma(f32x8.splat(-0.693359375), xc)
    r = n.fma(f32x8.splat(0.00021219444), r)
    p = f32x8.splat(0.00019875691500)
    p = p.fma(r, f32x8.splat(0.0013981999507))
    p = p.fma(r, f32x8.splat(0.0083334519073))
    p = p.fma(r, f32x8.splat(0.041665795894))
    p = p.fma(r, f32x8.splat(0.16666665459))
    p = p.fma(r, f32x8.splat(0.50000001201))
    y = p.fma(r * r, r) + f32x8.splat(1.0)
    scale = (n.to_i32() + i32x8.splat(127)).shl(23).as_f32()
    return y * scale

public
# e^x.
fn exp(x: f32) -> f32:
    return vexp(f32x8.splat(x)).lane(0)

# The dot product of two slices of the same length.
fn dot(a: []f32, b: []f32) -> f32:
    if a.len != b.len:
        panic("nn.dot: the lengths differ")
    acc = f32x8.splat(0.0)
    acc2 = f32x8.splat(0.0)
    i: usize = 0
    while i + 16 <= a.len:
        acc = f32x8.load(a, i).fma(f32x8.load(b, i), acc)
        acc2 = f32x8.load(a, i + 8).fma(f32x8.load(b, i + 8), acc2)
        i += 16
    while i + 8 <= a.len:
        acc = f32x8.load(a, i).fma(f32x8.load(b, i), acc)
        i += 8
    total = (acc + acc2).sum()
    while i < a.len:
        total += a[i] * b[i]
        i += 1
    return total

# y += a * x.
fn axpy(a: f32, x: []f32, y: lend []f32):
    if x.len != y.len:
        panic("nn.axpy: the lengths differ")
    av = f32x8.splat(a)
    i: usize = 0
    while i + 8 <= x.len:
        f32x8.load(x, i).fma(av, f32x8.load(y, i)).store(y, i)
        i += 8
    while i < x.len:
        y[i] += a * x[i]
        i += 1

# x += y (the residual connection).
fn add(x: lend []f32, y: []f32):
    if x.len != y.len:
        panic("nn.add: the lengths differ")
    i: usize = 0
    while i + 8 <= x.len:
        (f32x8.load(x, i) + f32x8.load(y, i)).store(x, i)
        i += 8
    while i < x.len:
        x[i] += y[i]
        i += 1

# y = W x for f32 weights: `w` has `rows * cols` values, row by row.
fn matvec(w: []f32, rows: usize, cols: usize, x: []f32, y: lend []f32):
    if w.len != rows * cols or x.len != cols or y.len != rows:
        panic("nn.matvec: the sizes do not match")
    for r in 0..rows:
        y[r] = dot(w[r * cols..(r + 1) * cols], x)

# The softmax of `x`, in place.
fn softmax(x: lend []f32):
    if x.len == 0:
        return
    top = x[0]
    i: usize = 0
    if x.len >= 8:
        tv = f32x8.load(x, 0)
        i = 8
        while i + 8 <= x.len:
            tv = tv.max(f32x8.load(x, i))
            i += 8
        top = tv.lane(0)
        for k in 1..8:
            if tv.lane(k) > top:
                top = tv.lane(k)
    while i < x.len:
        if x[i] > top:
            top = x[i]
        i += 1
    topv = f32x8.splat(top)
    sum = f32x8.splat(0.0)
    i = 0
    while i + 8 <= x.len:
        e = vexp(f32x8.load(x, i) - topv)
        e.store(x, i)
        sum = sum + e
        i += 8
    total = sum.sum()
    while i < x.len:
        e = exp(x[i] - top)
        x[i] = e
        total += e
        i += 1
    inv = f32x8.splat(1.0 / total)
    i = 0
    while i + 8 <= x.len:
        (f32x8.load(x, i) * inv).store(x, i)
        i += 8
    while i < x.len:
        x[i] = x[i] * (1.0 / total)
        i += 1

# out = x / sqrt(mean(x * x) + eps) * weight.
fn rmsnorm(x: []f32, weight: []f32, eps: f32, out: lend []f32):
    if x.len != weight.len or x.len != out.len or x.len == 0:
        panic("nn.rmsnorm: the sizes do not match")
    acc = f32x8.splat(0.0)
    i: usize = 0
    while i + 8 <= x.len:
        v = f32x8.load(x, i)
        acc = v.fma(v, acc)
        i += 8
    ss = acc.sum()
    while i < x.len:
        ss += x[i] * x[i]
        i += 1
    scale = 1.0 / f32x4.splat(ss / f32(x.len) + eps).sqrt().lane(0)
    sv = f32x8.splat(scale)
    i = 0
    while i + 8 <= x.len:
        (f32x8.load(x, i) * sv * f32x8.load(weight, i)).store(out, i)
        i += 8
    while i < x.len:
        out[i] = x[i] * scale * weight[i]
        i += 1

# x = x / sqrt(mean(x * x) + eps) * weight, in place (the per-head norm of Qwen3's queries and keys).
fn rmsnorm_inplace(x: lend []f32, weight: []f32, eps: f32):
    if x.len != weight.len or x.len == 0:
        panic("nn.rmsnorm_inplace: the sizes do not match")
    acc = f32x8.splat(0.0)
    i: usize = 0
    while i + 8 <= x.len:
        v = f32x8.load(x, i)
        acc = v.fma(v, acc)
        i += 8
    ss = acc.sum()
    while i < x.len:
        ss += x[i] * x[i]
        i += 1
    scale = 1.0 / f32x4.splat(ss / f32(x.len) + eps).sqrt().lane(0)
    sv = f32x8.splat(scale)
    i = 0
    while i + 8 <= x.len:
        (f32x8.load(x, i) * sv * f32x8.load(weight, i)).store(x, i)
        i += 8
    while i < x.len:
        x[i] = x[i] * scale * weight[i]
        i += 1

# x = x * sigmoid(x), in place.
fn silu(x: lend []f32):
    one = f32x8.splat(1.0)
    i: usize = 0
    while i + 8 <= x.len:
        v = f32x8.load(x, i)
        (v / (one + vexp(f32x8.splat(0.0) - v))).store(x, i)
        i += 8
    while i < x.len:
        x[i] = x[i] / (1.0 + exp(0.0 - x[i]))
        i += 1

# gate = silu(gate) * up, in place on `gate`: the activation of a SwiGLU feed-forward layer.
fn swiglu(gate: lend []f32, up: []f32):
    if gate.len != up.len:
        panic("nn.swiglu: the lengths differ")
    one = f32x8.splat(1.0)
    i: usize = 0
    while i + 8 <= gate.len:
        v = f32x8.load(gate, i)
        (v / (one + vexp(f32x8.splat(0.0) - v)) * f32x8.load(up, i)).store(gate, i)
        i += 8
    while i < gate.len:
        gate[i] = gate[i] / (1.0 + exp(0.0 - gate[i])) * up[i]
        i += 1

# Rotary position embedding, in place, for `n_heads` heads of `head_dim` values at position `pos`. Pair `i` of
# a head turns by the angle `pos * base^(-2i / head_dim)`. With `neox` false the pairs are neighbours
# (x[2i], x[2i+1]), as in the original LLaMA layout; with `neox` true they are (x[i], x[i + head_dim/2]).
fn rope(x: lend []f32, n_heads: usize, head_dim: usize, pos: usize, base: f32, neox: bool):
    none = List[f32]()
    rope_scaled(x, n_heads, head_dim, pos, base, neox, none[..])

# The same with a divisor per pair (`head_dim / 2` values, the `rope_freqs.weight` tensor of LLaMA 3.1 models):
# the angle of pair `i` is divided by `factors[i]`. An empty slice means no divisors.
fn rope_scaled(x: lend []f32, n_heads: usize, head_dim: usize, pos: usize, base: f32, neox: bool, factors: []f32):
    half = head_dim / 2
    cs = List[f32]()
    sn = List[f32]()
    for i in 0..half:
        cs.push(0.0)
        sn.push(0.0)
    rope_table(pos, head_dim, base, factors, 1.0, 0, 1.0, cs[..], sn[..])
    rope_apply(x, n_heads, head_dim, neox, cs[..], sn[..])

# The cosines and sines of the angles of the `head_dim / 2` pairs at position `pos` (the same for every head, so a
# model computes them once per token). `factors` are the divisors of `rope_scaled`. `linear` divides every angle by
# that number (linear position scaling; 1 = none). `yarn` > 1 is YaRN scaling by that factor, as llama.cpp does it:
# `original_ctx` is the context length the model was trained with; pairs that turn fast keep their angle, pairs
# that turn slowly get it divided by `yarn`, those in between a mixture, and the sines and cosines are multiplied
# by `1 + 0.1 * ln(yarn)`.
fn rope_table(pos: usize, head_dim: usize, base: f32, factors: []f32, linear: f32, original_ctx: usize, yarn: f32,
    cos: lend []f32, sin: lend []f32):
    half = head_dim / 2
    if cos.len != half or sin.len != half or head_dim % 2 != 0:
        panic("nn.rope_table: the sizes do not match")
    if factors.len != 0 and factors.len != half:
        panic("nn.rope_table: there must be head_dim / 2 factors")
    freq_scale = 1.0 / f64(linear)
    ext: f64 = 0.0
    mscale: f64 = 1.0
    low: f64 = 0.0
    high: f64 = 0.0
    if yarn > 1.0 and original_ctx > 0:
        freq_scale = 1.0 / f64(yarn)
        ext = 1.0
        mscale = 1.0 + 0.1 * math.ln(f64(yarn))
        # the pairs whose wavelength fits 32 (fast) and 1 (slow) times into the original context
        pi2 = 2.0 * math.pi()
        start = math.floor(f64(head_dim) * math.ln(f64(original_ctx) / (32.0 * pi2)) / (2.0 * math.ln(f64(base))))
        end = math.ceil(f64(head_dim) * math.ln(f64(original_ctx) / (1.0 * pi2)) / (2.0 * math.ln(f64(base))))
        low = start
        if low < 0.0:
            low = 0.0
        high = end
        if high > f64(head_dim - 1):
            high = f64(head_dim - 1)
    for i in 0..half:
        freq = math.pow(f64(base), 0.0 - f64(2 * i) / f64(head_dim))
        if factors.len != 0:
            freq = freq / f64(factors[i])
        extrap = f64(pos) * freq
        theta = extrap * freq_scale
        if ext != 0.0:
            span = high - low
            if span < 0.001:
                span = 0.001
            ramp = 1.0 - math.min(1.0, math.max(0.0, (f64(i) - low) / span))
            mix = ramp * ext
            theta = theta * (1.0 - mix) + extrap * mix
        cos[i] = f32(math.cos(theta) * mscale)
        sin[i] = f32(math.sin(theta) * mscale)

# Turns every head of `x` by the angles of a `rope_table`.
fn rope_apply(x: lend []f32, n_heads: usize, head_dim: usize, neox: bool, cos: []f32, sin: []f32):
    half = head_dim / 2
    if x.len != n_heads * head_dim or cos.len != half or sin.len != half or head_dim % 2 != 0:
        panic("nn.rope: the sizes do not match")
    for h in 0..n_heads:
        for i in 0..half:
            a = h * head_dim + 2 * i
            b = a + 1
            if neox:
                a = h * head_dim + i
                b = a + half
            x0 = x[a]
            x1 = x[b]
            x[a] = x0 * cos[i] - x1 * sin[i]
            x[b] = x0 * sin[i] + x1 * cos[i]

struct _MatvecJob:
    w: []f32
    x: []f32
    y: *mut f32
    cols: usize

fn _matvec_rows(start: usize, end: usize, ctx: *u8):
    unsafe:
        job = ptr_cast[*_MatvecJob](ctx)
        for r in start..end:
            job[0].y[r] = dot(job[0].w[r * job[0].cols..(r + 1) * job[0].cols], job[0].x)

public
# The same as `matvec`, with the rows shared between the threads of `pool`.
fn matvec_parallel(pool: lend parallel.Pool, w: []f32, rows: usize, cols: usize, x: []f32, y: lend []f32):
    if w.len != rows * cols or x.len != cols or y.len != rows:
        panic("nn.matvec_parallel: the sizes do not match")
    unsafe:
        job = _MatvecJob{ w: w, x: x, y: ptr_cast[*mut f32](addr_mut(y)), cols: cols }
        pool.for_range(rows, _matvec_rows, ptr_cast[*u8](addr(job)))

public
# The keys and values of the tokens seen so far, for one layer. Position `t` holds `n_kv_heads * head_dim`
# values of each, head after head.
struct KvCache:
    k: List[f32]
    v: List[f32]
    n_kv_heads: usize
    head_dim: usize
    max_seq: usize
    used: usize

impl KvCache:
    # An empty cache with room for `max_seq` tokens.
    public
    fn new(n_kv_heads: usize, head_dim: usize, max_seq: usize) -> KvCache:
        k = List[f32]()
        v = List[f32]()
        total = n_kv_heads * head_dim * max_seq
        k.reserve(total)
        v.reserve(total)
        for i in 0..total:
            k.push(0.0)
            v.push(0.0)
        return KvCache{ k: k, v: v, n_kv_heads: n_kv_heads, head_dim: head_dim, max_seq: max_seq, used: 0 }

    # How many tokens are stored.
    fn len(self: read KvCache) -> usize:
        return self.used

    # Stores the key and value of the next token (each `n_kv_heads * head_dim` values).
    fn append(self: lend KvCache, key: []f32, value: []f32):
        w = self.n_kv_heads * self.head_dim
        if key.len != w or value.len != w:
            panic("KvCache.append: the key and value must have n_kv_heads * head_dim values")
        if self.used >= self.max_seq:
            panic("KvCache.append: the cache is full")
        base = self.used * w
        for i in 0..w:
            self.k[base + i] = key[i]
            self.v[base + i] = value[i]
        self.used += 1

    # Forgets the tokens from position `n` on (for instance to go back to a shared prompt).
    fn truncate(self: lend KvCache, n: usize):
        if n < self.used:
            self.used = n

    fn clear(self: lend KvCache):
        self.used = 0

private
# The `group` query heads that share one key/value head: out = softmax(q . K^T / sqrt(d)) V for each, reading every
# key and every value once for all of them. `q` and `out` hold the group's heads one after another; `scores` has
# `group * tokens` values of scratch space.
fn _attend_group(q: []f32, keys: []f32, values: []f32, kv_width: usize, head_dim: usize, kv_head: usize,
    group: usize, tokens: usize, scores: lend []f32, out: lend []f32):
    scale = 1.0 / f32x4.splat(f32(head_dim)).sqrt().lane(0)
    off = kv_head * head_dim
    for t in 0..tokens:
        key = keys[t * kv_width + off..t * kv_width + off + head_dim]
        for g in 0..group:
            scores[g * tokens + t] = dot(q[g * head_dim..(g + 1) * head_dim], key) * scale
    for g in 0..group:
        softmax(scores[g * tokens..(g + 1) * tokens])
    for i in 0..group * head_dim:
        out[i] = 0.0
    for t in 0..tokens:
        value = values[t * kv_width + off..t * kv_width + off + head_dim]
        for g in 0..group:
            axpy(scores[g * tokens + t], value, out[g * head_dim..(g + 1) * head_dim])

struct _AttnJob:
    q: []f32
    keys: []f32
    values: []f32
    kv_width: usize
    head_dim: usize
    group: usize
    tokens: usize
    scores: *mut f32
    out: *mut f32

fn _attn_groups(start: usize, end: usize, ctx: *u8):
    unsafe:
        job = ptr_cast[*_AttnJob](ctx)
        hd = job[0].head_dim
        span = job[0].group * hd
        for kvh in start..end:
            scores = slice_from_raw[f32](ptr_offset(job[0].scores, isize(kvh * job[0].group * job[0].tokens)), job[0].group * job[0].tokens)
            out = slice_from_raw[f32](ptr_offset(job[0].out, isize(kvh * span)), span)
            _attend_group(job[0].q[kvh * span..(kvh + 1) * span], job[0].keys, job[0].values, job[0].kv_width, hd, kvh,
                job[0].group, job[0].tokens, scores, out)

struct _BatchAttnJob:
    q: []f32
    keys: []f32
    values: []f32
    kv_width: usize
    head_dim: usize
    kv_heads: usize
    group: usize
    pos0: usize
    most: usize
    scores: *mut f32
    out: *mut f32

# One unit is one token of the batch and one key/value head with its group of query heads.
fn _attn_batch_units(start: usize, end: usize, ctx: *u8):
    unsafe:
        job = ptr_cast[*_BatchAttnJob](ctx)
        hd = job[0].head_dim
        span = job[0].group * hd
        q_dim = job[0].kv_heads * span
        for u in start..end:
            b = u / job[0].kv_heads
            kvh = u % job[0].kv_heads
            tokens = job[0].pos0 + b + 1
            scores = slice_from_raw[f32](ptr_offset(job[0].scores, isize(u * job[0].group * job[0].most)), job[0].group * tokens)
            out = slice_from_raw[f32](ptr_offset(job[0].out, isize(b * q_dim + kvh * span)), span)
            _attend_group(job[0].q[b * q_dim + kvh * span..b * q_dim + (kvh + 1) * span], job[0].keys, job[0].values,
                job[0].kv_width, hd, kvh, job[0].group, tokens, scores, out)

public
# Attention of the new token's query `q` (`n_heads * head_dim` values) over every token in `cache`, which must
# already hold the new token's own key and value. `n_heads` must be a multiple of `cache.n_kv_heads` (grouped-query
# attention: neighbouring query heads share a key/value head). `out` has `n_heads * head_dim` values.
fn attention(q: []f32, cache: read KvCache, n_heads: usize, out: lend []f32):
    attention_prefix(q, cache, n_heads, cache.used, out)

# The same over only the first `tokens` tokens of the cache: when a batch of tokens has been appended, token `i` of
# the batch looks at the tokens up to and including itself.
fn attention_prefix(q: []f32, cache: read KvCache, n_heads: usize, tokens: usize, out: lend []f32):
    w = cache.n_kv_heads * cache.head_dim
    if tokens == 0 or tokens > cache.used or n_heads % cache.n_kv_heads != 0 or q.len != n_heads * cache.head_dim or out.len != q.len:
        panic("nn.attention: the sizes do not match")
    group = n_heads / cache.n_kv_heads
    scores = List[f32]()
    for i in 0..group * tokens:
        scores.push(0.0)
    ss = scores[..]
    hd = cache.head_dim
    span = group * hd
    for kvh in 0..cache.n_kv_heads:
        _attend_group(q[kvh * span..(kvh + 1) * span], cache.k[..], cache.v[..], w, hd, kvh, group, tokens, ss,
            out[kvh * span..(kvh + 1) * span])

# The same with the key/value heads (each with its group of query heads) shared between the threads of `pool`.
fn attention_parallel(pool: lend parallel.Pool, q: []f32, cache: read KvCache, n_heads: usize, out: lend []f32):
    attention_prefix_parallel(pool, q, cache, n_heads, cache.used, out)

fn attention_prefix_parallel(pool: lend parallel.Pool, q: []f32, cache: read KvCache, n_heads: usize, tokens: usize, out: lend []f32):
    w = cache.n_kv_heads * cache.head_dim
    if tokens == 0 or tokens > cache.used or n_heads % cache.n_kv_heads != 0 or q.len != n_heads * cache.head_dim or out.len != q.len:
        panic("nn.attention_parallel: the sizes do not match")
    scores = List[f32]()
    for i in 0..n_heads * tokens:
        scores.push(0.0)
    ss = scores[..]
    unsafe:
        job = _AttnJob{ q: q, keys: cache.k[..], values: cache.v[..], kv_width: w, head_dim: cache.head_dim,
            group: n_heads / cache.n_kv_heads, tokens: tokens,
            scores: ptr_cast[*mut f32](addr_mut(ss)), out: ptr_cast[*mut f32](addr_mut(out)) }
        pool.for_range_chunked(cache.n_kv_heads, 1, _attn_groups, ptr_cast[*u8](addr(job)))

# Attention for a batch of `m` tokens that were appended to the cache at positions `pos0 .. pos0 + m` (the cache holds
# `pos0 + m` tokens): token `i` looks at the first `pos0 + i + 1`. `q` and `out` hold the `m` tokens one after
# another (`n_heads * head_dim` values each). All the (token, key/value head) pairs are shared between the threads
# of `pool` in one go.
fn attention_batch_parallel(pool: lend parallel.Pool, q: []f32, cache: read KvCache, n_heads: usize, pos0: usize, m: usize, out: lend []f32):
    w = cache.n_kv_heads * cache.head_dim
    q_dim = n_heads * cache.head_dim
    if m == 0 or pos0 + m > cache.used or n_heads % cache.n_kv_heads != 0 or q.len != m * q_dim or out.len != q.len:
        panic("nn.attention_batch_parallel: the sizes do not match")
    group = n_heads / cache.n_kv_heads
    most = pos0 + m
    scores = List[f32]()
    for i in 0..m * cache.n_kv_heads * group * most:
        scores.push(0.0)
    ss = scores[..]
    unsafe:
        job = _BatchAttnJob{ q: q, keys: cache.k[..], values: cache.v[..], kv_width: w, head_dim: cache.head_dim,
            kv_heads: cache.n_kv_heads, group: group, pos0: pos0, most: most,
            scores: ptr_cast[*mut f32](addr_mut(ss)), out: ptr_cast[*mut f32](addr_mut(out)) }
        pool.for_range_chunked(m * cache.n_kv_heads, 1, _attn_batch_units, ptr_cast[*u8](addr(job)))
