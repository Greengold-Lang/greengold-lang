# std.gguf: reads GGUF model files (the format of llama.cpp) through a memory map.
#
#     import std.gguf
#
#     match gguf.Gguf.open("llama-3.2-1b-q4_0.gguf"):
#         Ok(g):
#             print(g.get_str("general.architecture"), g.tensors.len(), "tensors")
#             match g.find_tensor("blk.0.attn_q.weight"):
#                 Some(i): print(g.tensors[i].dims[0], g.tensors[i].dims[1])
#                 None: print("no such tensor")
#         Err(e): print(e)
#
# Opening a file reads only the header, the key/value metadata and the tensor table. The weights stay in the
# mapped file: `q4_blocks(i)`, `q8_blocks(i)` and `f32_values(i)` are views straight into it (valid as long as the
# `Gguf` lives), so a model of several gigabytes opens in milliseconds and is paged in as it is used.
# Versions 2 and 3 are read. A tensor's `dims` are in file order: `dims[0]` is the number of columns of a matrix
# (the fastest changing one) and `dims[1]` the number of rows.
import std.mmap
import std.string
import std.tensor

private
# The size in bytes of `n` values of ggml type `kind`; 0 for a type this reader does not know.
fn _type_size(kind: u32, n: usize) -> usize:
    if kind == 0:
        return n * 4
    if kind == 1 or kind == 30:
        return n * 2
    # (type, values per block, bytes per block)
    if kind == 2:
        return n / 32 * 18
    if kind == 3:
        return n / 32 * 20
    if kind == 6:
        return n / 32 * 22
    if kind == 7:
        return n / 32 * 24
    if kind == 8:
        return n / 32 * 34
    if kind == 9:
        return n / 32 * 40
    if kind == 10:
        return n / 256 * 84
    if kind == 11:
        return n / 256 * 110
    if kind == 12:
        return n / 256 * 144
    if kind == 13:
        return n / 256 * 176
    if kind == 14:
        return n / 256 * 210
    if kind == 15:
        return n / 256 * 292
    return 0

fn _scalar_size(kind: u32) -> usize:
    if kind == 0 or kind == 1 or kind == 7:
        return 1
    if kind == 2 or kind == 3:
        return 2
    if kind == 4 or kind == 5 or kind == 6:
        return 4
    if kind == 10 or kind == 11 or kind == 12:
        return 8
    return 0

struct _Reader:
    bytes: []u8
    pos: usize
    ok: bool

impl _Reader:
    # Reserves `n` bytes; false (and the reader fails for good) when the file ends first.
    fn take(self: lend _Reader, n: usize) -> bool:
        if not self.ok:
            return false
        if n > self.bytes.len or self.pos > self.bytes.len - n:
            self.ok = false
            return false
        return true

    fn u8(self: lend _Reader) -> u8:
        if not self.take(1):
            return 0
        v = self.bytes[self.pos]
        self.pos += 1
        return v

    fn u16(self: lend _Reader) -> u16:
        if not self.take(2):
            return 0
        v = u16(self.bytes[self.pos]) | (u16(self.bytes[self.pos + 1]) << 8)
        self.pos += 2
        return v

    fn u32(self: lend _Reader) -> u32:
        if not self.take(4):
            return 0
        v: u32 = 0
        for i in 0..4:
            v = v | (u32(self.bytes[self.pos + i]) << u32(8 * i))
        self.pos += 4
        return v

    fn u64(self: lend _Reader) -> u64:
        if not self.take(8):
            return 0
        v: u64 = 0
        for i in 0..8:
            v = v | (u64(self.bytes[self.pos + i]) << u64(8 * i))
        self.pos += 8
        return v

    fn string(self: lend _Reader) -> string:
        n = self.u64()
        out = string.new()
        if n > u64(self.bytes.len) or not self.take(usize(n)):
            self.ok = false
            return out
        for i in 0..usize(n):
            out.append_byte(self.bytes[self.pos + i])
        self.pos += usize(n)
        return out

fn _f32_of(bits: u32) -> f32:
    return tensor.f32_from_bits(bits)

fn _f64_of(bits: u64) -> f64:
    unsafe:
        p = ptr_cast[*f64](addr(bits))
        return p[0]

public
# One key/value pair of the metadata. `kind` is the GGUF value type (0 u8, 1 i8, 2 u16, 3 i16, 4 u32, 5 i32,
# 6 f32, 7 bool, 8 string, 9 array, 10 u64, 11 i64, 12 f64). Integers and booleans are in `ival`, floats in
# `fval`, text in `text`. For an array, `arr_kind` is the type of its elements, `count` their number and `offset`
# where they start in the file.
struct Meta:
    key: string
    kind: u32
    ival: i64
    fval: f64
    text: string
    arr_kind: u32
    count: usize
    offset: usize

# One entry of the tensor table.
struct TensorInfo:
    name: string
    dims: List[usize]
    kind: u32       # the ggml type: 0 f32, 1 f16, 2 q4_0, 8 q8_0, 30 bf16, ...
    count: usize    # number of values
    offset: usize   # where the data starts in the file
    size: usize     # its size in bytes

private
fn _read_value(r: lend _Reader, kind: u32, m: lend Meta):
    m.kind = kind
    if kind == 0:
        m.ival = i64(r.u8())
    elif kind == 1:
        v = r.u8()
        m.ival = i64(v)
        if v > 127:
            m.ival = i64(v) - 256
    elif kind == 2:
        m.ival = i64(r.u16())
    elif kind == 3:
        v = r.u16()
        m.ival = i64(v)
        if v > 32767:
            m.ival = i64(v) - 65536
    elif kind == 4:
        m.ival = i64(r.u32())
    elif kind == 5:
        v = r.u32()
        m.ival = i64(v)
        if v > 2147483647:
            m.ival = i64(v) - 4294967296
    elif kind == 6:
        m.fval = f64(_f32_of(r.u32()))
    elif kind == 7:
        m.ival = i64(r.u8())
    elif kind == 8:
        m.text = r.string()
    elif kind == 10 or kind == 11:
        m.ival = i64(r.u64())  # a u64 above 2^63 comes out negative
    elif kind == 12:
        m.fval = _f64_of(r.u64())
    elif kind == 9:
        m.arr_kind = r.u32()
        n = r.u64()
        m.offset = r.pos
        if n > u64(r.bytes.len):
            r.ok = false
            return
        m.count = usize(n)
        if m.arr_kind == 8:
            for i in 0..m.count:
                skipped = r.string()
                if not r.ok:
                    return
        else:
            width = _scalar_size(m.arr_kind)
            if width == 0 or not r.take(width * m.count):
                r.ok = false
                return
            r.pos += width * m.count
    else:
        r.ok = false

public
struct Gguf:
    version: u32
    meta: List[Meta]
    tensors: List[TensorInfo]
    data_start: usize
    file: mmap.MappedFile

impl Gguf:
    # Maps the file and reads its header, metadata and tensor table.
    public
    fn open(path: str) -> Result[Gguf, string]:
        file = mmap.MappedFile.open(path)?
        r = _Reader{ bytes: file.bytes(), pos: 0, ok: true }
        if r.u32() != 0x46554747:  # "GGUF"
            return Err(string.from("not a GGUF file"))
        version = r.u32()
        if version != 2 and version != 3:
            return Err(string.from("unsupported GGUF version"))
        n_tensors = r.u64()
        n_meta = r.u64()
        if n_tensors > 1000000 or n_meta > 1000000:
            return Err(string.from("the GGUF header is not valid"))
        meta = List[Meta]()
        alignment: usize = 32
        for i in 0..usize(n_meta):
            m = Meta{ key: r.string(), kind: 0, ival: 0, fval: 0.0, text: string.new(), arr_kind: 0, count: 0, offset: 0 }
            kind = r.u32()
            _read_value(r, kind, m)
            if not r.ok:
                return Err(string.from("the GGUF metadata is cut short or not valid"))
            if m.key.as_str() == "general.alignment" and m.ival > 0:
                alignment = usize(m.ival)
            meta.push(m)
        tensors = List[TensorInfo]()
        for i in 0..usize(n_tensors):
            name = r.string()
            n_dims = r.u32()
            if n_dims == 0 or n_dims > 8:
                return Err(string.from("a tensor has an unsupported number of dimensions"))
            dims = List[usize]()
            count: usize = 1
            for d in 0..usize(n_dims):
                dim = r.u64()
                if dim == 0 or dim > 4294967296:
                    return Err(string.from("a tensor has an unsupported size"))
                dims.push(usize(dim))
                count *= usize(dim)
            kind = r.u32()
            rel = r.u64()
            if not r.ok:
                return Err(string.from("the GGUF tensor table is cut short"))
            tensors.push(TensorInfo{ name: name, dims: dims, kind: kind, count: count, offset: usize(rel), size: _type_size(kind, count) })
        data_start = (r.pos + alignment - 1) / alignment * alignment
        total = file.len()
        for i in 0..tensors.len():
            t = tensors[i].offset
            if t > total or data_start > total - t:
                return Err(string.from("a tensor lies outside the file"))
            tensors[i].offset = data_start + t
            if tensors[i].size > 0 and tensors[i].size > total - tensors[i].offset:
                return Err(string.from("a tensor lies outside the file"))
        return Ok(Gguf{ version: version, meta: meta, tensors: tensors, data_start: data_start, file: file })

    # The index of the metadata entry `key`.
    fn find_meta(self: read Gguf, key: str) -> Optional[usize]:
        for i in 0..self.meta.len():
            if self.meta[i].key.as_str() == key:
                return Valid(i)
        return None

    # An integer (or boolean) entry.
    fn get_int(self: read Gguf, key: str) -> Optional[i64]:
        if let Valid(i) = self.find_meta(key):
            return Valid(self.meta[i].ival)
        return None

    # A float entry.
    fn get_float(self: read Gguf, key: str) -> Optional[f64]:
        if let Valid(i) = self.find_meta(key):
            if self.meta[i].kind == 6 or self.meta[i].kind == 12:
                return Valid(self.meta[i].fval)
        return None

    # A string entry (a copy).
    fn get_str(self: read Gguf, key: str) -> Optional[string]:
        if let Valid(i) = self.find_meta(key):
            if self.meta[i].kind == 8:
                return Valid(self.meta[i].text.clone())
        return None

    # The index of the tensor called `name`.
    fn find_tensor(self: read Gguf, name: str) -> Optional[usize]:
        for i in 0..self.tensors.len():
            if self.tensors[i].name.as_str() == name:
                return Valid(i)
        return None

    # The bytes of tensor `i`, as stored.
    fn raw(self: read Gguf, i: usize) -> []u8:
        t = self.tensors[i].offset
        return self.file.bytes()[t..t + self.tensors[i].size]

    # Tensor `i` as `q4_0` blocks (it must have type 2), straight from the mapped file.
    fn q4_blocks(self: read Gguf, i: usize) -> []tensor.BlockQ4:
        if self.tensors[i].kind != 2:
            panic("Gguf.q4_blocks: the tensor is not q4_0")
        unsafe:
            return slice_from_raw[tensor.BlockQ4](ptr_cast[*tensor.BlockQ4](addr(self.file.bytes()[self.tensors[i].offset..])), self.tensors[i].count / 32)

    # Tensor `i` as `q8_0` blocks (type 8).
    fn q8_blocks(self: read Gguf, i: usize) -> []tensor.BlockQ8:
        if self.tensors[i].kind != 8:
            panic("Gguf.q8_blocks: the tensor is not q8_0")
        unsafe:
            return slice_from_raw[tensor.BlockQ8](ptr_cast[*tensor.BlockQ8](addr(self.file.bytes()[self.tensors[i].offset..])), self.tensors[i].count / 32)

    # Tensor `i` as f32 values (type 0).
    fn f32_values(self: read Gguf, i: usize) -> []f32:
        if self.tensors[i].kind != 0:
            panic("Gguf.f32_values: the tensor is not f32")
        unsafe:
            return slice_from_raw[f32](ptr_cast[*f32](addr(self.file.bytes()[self.tensors[i].offset..])), self.tensors[i].count)
