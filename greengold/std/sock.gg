# std.sock: waiting for sockets, with a time limit. std.net, std.tls and std.http are built on it.
#
# A socket here is the handle number a `TcpListener`, `TcpStream`, or `UdpSocket` gives from `handle()`. Times are
# in milliseconds; a negative time waits for ever.
import std.time

private
extern "stdlib.h" fn malloc(size: usize) -> *mut u8
extern "string.h" fn memcpy(dst: *mut u8, src: *u8, n: usize) -> *mut u8
extern "stdlib.h" fn free(ptr: *u8)
weak extern "winsock2.h" fn WSAPoll(fds: *mut u8, n: u32, timeout: i32) -> i32
weak extern "poll.h" fn poll(fds: *mut u8, n: u64, timeout: i32) -> i32

public
# A NUL-ended copy of `s` for a C function. The caller frees it with `free`.
fn cstr(s: str) -> *mut u8:
    unsafe:
        p = malloc(s.len + 1)
        if s.len > 0:
            memcpy(p, addr(s), s.len)
        ptr_cast[*mut u8](ptr_offset(p, i64(s.len)))[0] = 0
        return p

# What `poll_many` reports for one socket (a sum of these).
const READY_READ: i32 = 1
const READY_WRITE: i32 = 2
const READY_ERROR: i32 = 4

# What to wait for in `poll_many` (a sum of these).
const WANT_READ: i32 = 1
const WANT_WRITE: i32 = 2

# Waits until socket `fd` can be read (or written, with `writable`), at most `ms` milliseconds.
# 1: ready (or closed, or failed: the next call says which). 0: the time ran out. -1: the wait itself failed.
fn wait(fd: i64, writable: bool, ms: i64) -> i32:
    fds = List[i64]()
    fds.push(fd)
    want = List[i32]()
    want.push(if writable then WANT_WRITE else WANT_READ)
    got = poll_many(fds, want, ms)
    if got.len == 0:
        return -1
    if got[0] == 0:
        return 0
    return 1

# Waits until one of `fds` is ready for what `want` (WANT_READ / WANT_WRITE, same position) asks, at most `ms`
# milliseconds. Returns one number per socket: READY_* flags, 0 when that socket is not ready. The list is empty
# when the wait failed.
fn poll_many(fds: read List[i64], want: read List[i32], ms: i64) -> List[i32]:
    out = List[i32]()
    n = fds.len
    if n == 0:
        if ms > 0:
            _sleep(ms)
        return out
    win = target_os() == "windows"
    size: usize = if win then 16 else 8
    timeout: i32 = if ms < 0 then -1 else if ms > 2000000000 then 2000000000 else i32(ms)
    unsafe:
        buf = malloc(n * size)
        for i in 0..n:
            at = ptr_offset(buf, i64(i * size))
            w = (want[i] & WANT_WRITE) != 0
            if win:
                ptr_cast[*mut i64](at)[0] = fds[i]
                ptr_cast[*mut i16](ptr_offset(at, 8))[0] = if w then 16 else 256
                ptr_cast[*mut i16](ptr_offset(at, 10))[0] = 0
            else:
                ptr_cast[*mut i32](at)[0] = i32(fds[i])
                ptr_cast[*mut i16](ptr_offset(at, 4))[0] = if w then 4 else 1
                ptr_cast[*mut i16](ptr_offset(at, 6))[0] = 0
        r: i32 = 0
        if target_os() == "windows":
            r = WSAPoll(buf, u32(n), timeout)
        else:
            r = poll(buf, u64(n), timeout)
        if r < 0:
            free(buf)
            return out
        for i in 0..n:
            at = ptr_offset(buf, i64(i * size))
            revents: i32 = 0
            if win:
                revents = i32(ptr_cast[*mut i16](ptr_offset(at, 10))[0])
            else:
                revents = i32(ptr_cast[*mut i16](ptr_offset(at, 6))[0])
            flags: i32 = 0
            if r > 0 and revents != 0:
                if win:
                    if (revents & 256) != 0:
                        flags = flags | READY_READ
                    if (revents & 16) != 0:
                        flags = flags | READY_WRITE
                    if (revents & (1 | 2 | 4 | 8 | 32)) != 0:
                        flags = flags | READY_ERROR
                else:
                    if (revents & 1) != 0:
                        flags = flags | READY_READ
                    if (revents & 4) != 0:
                        flags = flags | READY_WRITE
                    if (revents & (8 | 16 | 32)) != 0:
                        flags = flags | READY_ERROR
            out.push(flags)
        free(buf)
    return out

private
fn _sleep(ms: i64):
    time.sleep_millis(ms)
