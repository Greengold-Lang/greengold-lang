# std.math: floating point math over libm.
# The name after `fn` is the C symbol. `as` is the name used inside this module.
private
extern "math.h" fn sqrt(x: f64) -> f64 as c_sqrt
extern "math.h" fn sin(x: f64) -> f64 as c_sin
extern "math.h" fn cos(x: f64) -> f64 as c_cos
extern "math.h" fn tan(x: f64) -> f64 as c_tan
extern "math.h" fn atan2(y: f64, x: f64) -> f64 as c_atan2
extern "math.h" fn pow(x: f64, y: f64) -> f64 as c_pow
extern "math.h" fn exp(x: f64) -> f64 as c_exp
extern "math.h" fn log(x: f64) -> f64 as c_log
extern "math.h" fn floor(x: f64) -> f64 as c_floor
extern "math.h" fn ceil(x: f64) -> f64 as c_ceil
extern "math.h" fn fmod(x: f64, y: f64) -> f64 as c_fmod
extern "math.h" fn asin(x: f64) -> f64 as c_asin
extern "math.h" fn acos(x: f64) -> f64 as c_acos
extern "math.h" fn atan(x: f64) -> f64 as c_atan
extern "math.h" fn sinh(x: f64) -> f64 as c_sinh
extern "math.h" fn cosh(x: f64) -> f64 as c_cosh
extern "math.h" fn tanh(x: f64) -> f64 as c_tanh
extern "math.h" fn log2(x: f64) -> f64 as c_log2
extern "math.h" fn log10(x: f64) -> f64 as c_log10
extern "math.h" fn round(x: f64) -> f64 as c_round
extern "math.h" fn trunc(x: f64) -> f64 as c_trunc
extern "math.h" fn cbrt(x: f64) -> f64 as c_cbrt
extern "math.h" fn log1p(x: f64) -> f64 as c_log1p
extern "math.h" fn expm1(x: f64) -> f64 as c_expm1
extern "math.h" fn exp2(x: f64) -> f64 as c_exp2
extern "math.h" fn hypot(x: f64, y: f64) -> f64 as c_hypot
extern "math.h" fn copysign(x: f64, y: f64) -> f64 as c_copysign
extern "math.h" fn sqrtf(x: f32) -> f32 as c_sqrtf
extern "math.h" fn sinf(x: f32) -> f32 as c_sinf
extern "math.h" fn cosf(x: f32) -> f32 as c_cosf
extern "math.h" fn tanf(x: f32) -> f32 as c_tanf
extern "math.h" fn atan2f(x: f32, y: f32) -> f32 as c_atan2f
extern "math.h" fn powf(x: f32, y: f32) -> f32 as c_powf
extern "math.h" fn expf(x: f32) -> f32 as c_expf
extern "math.h" fn floorf(x: f32) -> f32 as c_floorf
extern "math.h" fn ceilf(x: f32) -> f32 as c_ceilf
extern "math.h" fn fabsf(x: f32) -> f32 as c_fabsf
extern "math.h" fn logf(x: f32) -> f32 as c_logf

public
fn pi() -> f64:
    return 3.14159265358979323846

fn e_const() -> f64:
    return 2.71828182845904523536

fn sqrt(x: f64) -> f64:
    unsafe:
        return c_sqrt(x)

fn sin(x: f64) -> f64:
    unsafe:
        return c_sin(x)

fn cos(x: f64) -> f64:
    unsafe:
        return c_cos(x)

fn tan(x: f64) -> f64:
    unsafe:
        return c_tan(x)

fn atan2(y: f64, x: f64) -> f64:
    unsafe:
        return c_atan2(y, x)

fn pow(x: f64, y: f64) -> f64:
    unsafe:
        return c_pow(x, y)

fn exp(x: f64) -> f64:
    unsafe:
        return c_exp(x)

fn ln(x: f64) -> f64:
    unsafe:
        return c_log(x)

fn floor(x: f64) -> f64:
    unsafe:
        return c_floor(x)

fn ceil(x: f64) -> f64:
    unsafe:
        return c_ceil(x)

fn fmod(x: f64, y: f64) -> f64:
    unsafe:
        return c_fmod(x, y)

fn gcd_u64(a: u64, b: u64) -> u64:
    x = a
    y = b
    while y != 0:
        t = x % y
        x = y
        y = t
    return x

fn pow_i64(base: i64, exp_: u32) -> i64:
    result: i64 = 1
    b = base
    n = exp_
    while n > 0:
        if n % 2 == 1:
            result = result * b
        b = b * b
        n = n / 2
    return result

fn asin(x: f64) -> f64:
    unsafe:
        return c_asin(x)

