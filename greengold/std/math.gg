fn ln_f32(x: f32) -> f32:
    unsafe:
        return c_logf(x)

fn tau() -> f64:
    return 6.28318530717958647692

fn is_nan(x: f64) -> bool:
    return x != x

fn is_inf(x: f64) -> bool:
    return x - x != 0.0 and x == x

fn is_finite(x: f64) -> bool:
    return x - x == 0.0

fn is_nan_f32(x: f32) -> bool:
    return x != x

fn is_finite_f32(x: f32) -> bool:
    return x - x == 0.0

fn to_radians(deg: f64) -> f64:
    return deg * pi() / 180.0

fn to_degrees(rad: f64) -> f64:
    return rad * 180.0 / pi()

# Generic helpers. `abs` traps on the most negative integer, like `-x`.
fn min[T: Ord](a: T, b: T) -> T:
    if b < a:
        return b
    return a

fn max[T: Ord](a: T, b: T) -> T:
    if b > a:
        return b
    return a

fn clamp[T: Ord](x: T, lo: T, hi: T) -> T:
    if lo > hi:
        panic("clamp: lo must not be greater than hi")
    if x < lo:
        return lo
    if x > hi:
        return hi
    return x

fn abs[T: Num](x: T) -> T:
    if x < T(0):
        return T(0) - x
    return x

fn signum[T: Num](x: T) -> T:
    if x < T(0):
        return T(0) - T(1)
    if x > T(0):
        return T(1)
    return T(0)

fn lcm_u64(a: u64, b: u64) -> u64:
    if a == 0 or b == 0:
        return 0
    return a / gcd_u64(a, b) * b

# Floor of the square root, exact for every u64. Integer arithmetic only: no libm, works with `--no-std`.
fn isqrt(n0: u64) -> u64:
    n = n0
    res: u64 = 0
    bit: u64 = u64(1) << 62
    while bit > n:
        bit = bit >> 2
    while bit != 0:
        if n >= res + bit:
            n = n - (res + bit)
            res = (res >> 1) + bit
        else:
            res = res >> 1
        bit = bit >> 2
    return res

# Euclidean (always non-negative) remainder.
fn rem_euclid(a: i64, b: i64) -> i64:
    r = a % b
    if r < 0:
        if b < 0:
            return r - b
        return r + b
    return r

# `base ** exp` that returns None when it does not fit.
fn checked_pow_i64(base: i64, exp_: u32) -> Optional[i64]:
    result: i64 = 1
    for _ in 0..exp_:
        r = checked_mul(result, base)
        if r.is_none():
            return None
        result = r.value_or_panic()
    return Valid(result)

fn saturating_pow_i64(base: i64, exp_: u32) -> i64:
    result: i64 = 1
    for _ in 0..exp_:
        result = saturating_mul(result, base)
    return result

# Fused multiply-add in plain arithmetic (two roundings); use `std.nn` or SIMD `fma` for hardware FMA.
fn lerp(a: f64, b: f64, t: f64) -> f64:
    return a + (b - a) * t
