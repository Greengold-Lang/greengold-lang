# std.sort: in-place sorting and searching for `List[T]` of copyable elements.
#
#   sort(v)                      ascending, uses `<` (T needs `Ord`)
#   sort_by(v, fn(a, b) -> bool) custom "a goes before b" predicate
#   binary_search(v, x)          index of x in an ascending list, if present

public
fn sort_by[T](v: lend List[T], before: fn(T, T) -> bool):
    # Heap sort: O(n log n) worst case, no recursion, no extra memory.
    n = v.len
    if n < 2:
        return
    start = n / 2
    while start > 0:
        start -= 1
        sift_down_by(v, start, n, before)
    end = n
    while end > 1:
        end -= 1
        tmp = v[0]
        v[0] = v[end]
        v[end] = tmp
        sift_down_by(v, 0, end, before)

private
fn sift_down_by[T](v: lend List[T], start: usize, end: usize, before: fn(T, T) -> bool):
    root = start
    while true:
        child = root * 2 + 1
        if child >= end:
            return
        if child + 1 < end and before(v[child], v[child + 1]):
            child += 1
        if before(v[root], v[child]):
            tmp = v[root]
            v[root] = v[child]
            v[child] = tmp
            root = child
        else:
            return

public
fn sort[T: Ord](v: lend List[T]):
    n = v.len
    if n < 2:
        return
    start = n / 2
    while start > 0:
        start -= 1
        sift_down(v, start, n)
    end = n
    while end > 1:
        end -= 1
        tmp = v[0]
        v[0] = v[end]
        v[end] = tmp
        sift_down(v, 0, end)

private
fn sift_down[T: Ord](v: lend List[T], start: usize, end: usize):
    root = start
    while true:
        child = root * 2 + 1
        if child >= end:
            return
        if child + 1 < end and v[child] < v[child + 1]:
            child += 1
        if v[root] < v[child]:
            tmp = v[root]
            v[root] = v[child]
            v[child] = tmp
            root = child
        else:
            return

public
fn binary_search[T: Ord](v: read List[T], x: T) -> Optional[usize]:
    lo: usize = 0
    hi: usize = v.len
    while lo < hi:
        mid = lo + (hi - lo) / 2
        if v[mid] < x:
            lo = mid + 1
        elif x < v[mid]:
            hi = mid
        else:
            return Valid(mid)
    return None

public
fn is_sorted[T: Ord](v: read List[T]) -> bool:
    for i in 1..v.len:
        if v[i] < v[i - 1]:
            return false
    return true

# A stable sort (equal elements keep their order): merge sort, O(n log n) steps, one extra buffer of `n` elements.
# `sort` and `sort_by` use no extra memory but may reorder equal elements. For copyable elements.
fn sort_stable_by[T](v: lend List[T], before: fn(T, T) -> bool):
    n = v.len
    if n < 2:
        return
    run: usize = 8
    i: usize = 0
    while i < n:
        end = i + run
        if end > n:
            end = n
        j = i + 1
        while j < end:
            x = v[j]
            k = j
            while k > i and before(x, v[k - 1]):
                v[k] = v[k - 1]
                k -= 1
            v[k] = x
            j += 1
        i += run
    buf = List[T]()
    for x in v:
        buf.push(x)
    width = run
    while width < n:
        lo: usize = 0
        while lo < n:
            mid = lo + width
            if mid > n:
                mid = n
            hi = lo + 2 * width
            if hi > n:
                hi = n
            a = lo
            b = mid
            k = lo
            while a < mid and b < hi:
                if before(v[b], v[a]):
                    buf[k] = v[b]
                    b += 1
                else:
                    buf[k] = v[a]
                    a += 1
                k += 1
            while a < mid:
                buf[k] = v[a]
                a += 1
                k += 1
            while b < hi:
                buf[k] = v[b]
                b += 1
                k += 1
            lo += 2 * width
        for q in 0..n:
            v[q] = buf[q]
        width *= 2

fn sort_stable[T: Ord](v: lend List[T]):
    n = v.len
    if n < 2:
        return
    run: usize = 8
    i: usize = 0
    while i < n:
        end = i + run
        if end > n:
            end = n
        j = i + 1
        while j < end:
            x = v[j]
            k = j
            while k > i and x < v[k - 1]:
                v[k] = v[k - 1]
                k -= 1
            v[k] = x
            j += 1
        i += run
    buf = List[T]()
    for x in v:
        buf.push(x)
    width = run
    while width < n:
        lo: usize = 0
        while lo < n:
            mid = lo + width
            if mid > n:
                mid = n
            hi = lo + 2 * width
            if hi > n:
                hi = n
            a = lo
            b = mid
            k = lo
            while a < mid and b < hi:
                if v[b] < v[a]:
                    buf[k] = v[b]
                    b += 1
                else:
                    buf[k] = v[a]
                    a += 1
                k += 1
            while a < mid:
                buf[k] = v[a]
                a += 1
                k += 1
            while b < hi:
                buf[k] = v[b]
                b += 1
                k += 1
            lo += 2 * width
        for q in 0..n:
            v[q] = buf[q]
        width *= 2
