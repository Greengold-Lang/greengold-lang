  "tokenColors": [
    {
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#7b897f", "fontStyle": "italic" }
    },
    {
      "scope": ["keyword", "keyword.control", "keyword.declaration", "keyword.other", "storage.modifier", "storage.type"],
      "settings": { "foreground": "#0f7a47" }
    },
    {
      "scope": ["keyword.operator", "keyword.operator.arrow", "keyword.operator.try"],
      "settings": { "foreground": "#55655b" }
    },
    {
      "scope": ["keyword.operator.logical", "keyword.operator.word", "keyword.operator.cast"],
      "settings": { "foreground": "#0f7a47" }
    },
    {
      "scope": ["entity.name.type", "entity.name.type.class", "entity.name.type.struct", "entity.name.type.enum", "entity.name.type.interface", "entity.name.type.alias", "support.type", "entity.name.type.parameter"],
      "settings": { "foreground": "#8f5f00" }
    },
    {
      "scope": ["entity.name.type.primitive", "support.type.primitive", "support.type.simd"],
      "settings": { "foreground": "#7a5300" }
    },
    {
      "scope": ["entity.name.namespace"],
      "settings": { "foreground": "#1f2b24" }
    },
    {
      "scope": ["entity.name.function", "entity.name.function.call", "support.function"],
      "settings": { "foreground": "#1f63a8" }
    },
    {
      "scope": ["string", "string.quoted", "punctuation.definition.string"],
      "settings": { "foreground": "#b04a1c" }
    },
    {
      "scope": ["storage.type.string.format"],
      "settings": { "foreground": "#0f7a47" }
    },
    {
      "scope": ["constant.character.escape"],
      "settings": { "foreground": "#5f7a00" }
    },
    {
      "scope": ["punctuation.definition.template-expression", "punctuation.section.embedded"],
      "settings": { "foreground": "#8f5f00" }
    },
    {
      "scope": ["constant.numeric"],
      "settings": { "foreground": "#5f7a00" }
    },
    {
      "scope": ["constant.language", "support.constant", "entity.name.type.enum.variant"],
      "settings": { "foreground": "#5f7a00" }
    },
    {
      "scope": ["variable.language", "variable.language.self", "variable.language.wildcard"],
      "settings": { "foreground": "#0f7a47", "fontStyle": "italic" }
    },
    {
      "scope": ["variable.other.property", "support.variable.property", "entity.other.attribute-name"],
      "settings": { "foreground": "#3b4a41" }
    },
    {
      "scope": ["variable", "variable.other"],
      "settings": { "foreground": "#1f2b24" }
    },
    {
      "scope": ["punctuation", "meta.brace"],
      "settings": { "foreground": "#66746b" }
    },
    {
      "scope": ["invalid", "invalid.illegal"],
      "settings": { "foreground": "#c2352b", "fontStyle": "underline" }
    }
  ],
  "semanticTokenColors": {
    "function": "#1f63a8",
    "method": "#1f63a8",
    "type": "#8f5f00",
    "struct": "#8f5f00",
    "enum": "#8f5f00",
    "interface": "#8f5f00",
    "typeParameter": "#7a5300",
    "enumMember": "#5f7a00",
    "namespace": "#1f2b24",
    "property": "#3b4a41",
    "parameter": "#1f2b24",
    "variable": "#1f2b24",
    "number": "#5f7a00",
    "string": "#b04a1c",
    "keyword": "#0f7a47",
    "comment": "#7b897f"
  }
}
