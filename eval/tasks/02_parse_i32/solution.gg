fn parse_i32(text: str) -> Optional[i32]:
    if text.len == 0:
        return None
    i: usize = 0
    neg = false
    if text[0] == '-':
        if text.len == 1:
            return None
        neg = true
        i = 1
    n: i32 = 0
    while i < text.len:
        c = text[i]
        if c < '0' or c > '9':
            return None
        n = n * 10 + i32(c - '0')
        i += 1
    if neg:
        n = 0 - n
    return Valid(n)
