# The f32 kernels of one transformer layer at the size of a 8B LLaMA model (32 query heads, 8 key/value heads,
# head size 128, hidden size 4096, feed-forward size 14336) with 2048 tokens in the KV cache. It prints the time of
# each kernel. Build with `--cpu native`.
import std.nn
import std.parallel
import std.time

const HIDDEN: usize = 4096
const FFN: usize = 14336
const HEADS: usize = 32
const KV_HEADS: usize = 8
const HEAD_DIM: usize = 128
const TOKENS: usize = 2048

fn filled(n: usize, a: usize) -> List[f32]:
    out = List[f32]()
    out.reserve(n)
    for i in 0..n:
        out.push(f32((i * a + 3) % 101) / 50.0 - 1.0)
    return out

fn report(name: str, secs: f64, reps: usize):
    print(name, secs / f64(reps) * 1000000.0, "us")

fn main():
    x = filled(HIDDEN, 7)
    w = filled(HIDDEN, 3)
    out = filled(HIDDEN, 1)
    gate = filled(FFN, 5)
    up = filled(FFN, 11)
    scores = filled(TOKENS, 13)
    cache = nn.KvCache.new(KV_HEADS, HEAD_DIM, TOKENS)
    kv = HEAD_DIM * KV_HEADS
    for t in 0..TOKENS:
        k = filled(kv, 17 + t)
        v = filled(kv, 19 + t)
        cache.append(k[..], v[..])
    q = filled(HEADS * HEAD_DIM, 23)
    o = filled(HEADS * HEAD_DIM, 1)
    pool = parallel.Pool.new(0)
    reps: usize = 2000

    start = time.Instant.now()
    for r in 0..reps:
        nn.rmsnorm(x[..], w[..], 0.00001, out[..])
    report("rmsnorm 4096        ", start.elapsed_secs(), reps)

    start = time.Instant.now()
    for r in 0..reps:
        nn.swiglu(gate[..], up[..])
    report("swiglu 14336        ", start.elapsed_secs(), reps)

    start = time.Instant.now()
    for r in 0..reps:
        nn.softmax(scores[..])
    report("softmax 2048        ", start.elapsed_secs(), reps)

    start = time.Instant.now()
    for r in 0..reps:
        nn.rope(q[..], HEADS, HEAD_DIM, 1000, 500000.0, true)
    report("rope 32 heads       ", start.elapsed_secs(), reps)

    reps = 200
    start = time.Instant.now()
    for r in 0..reps:
        nn.attention(q[..], cache, HEADS, o[..])
    report("attention serial    ", start.elapsed_secs(), reps)

    start = time.Instant.now()
    for r in 0..reps:
        nn.attention_parallel(pool, q[..], cache, HEADS, o[..])
    report("attention parallel  ", start.elapsed_secs(), reps)
    print(o[0], out[0], gate[0], scores[0])
