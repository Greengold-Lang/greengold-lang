# qmatvec on all CPUs: the rows of the 4096 x 4096 int8 matrix are shared between the threads of a
# `std.parallel` pool. Same checksum as qmatvec.gg. Build with `--cpu native` for AVX2.
import std.parallel

const ROWS: usize = 4096
const COLS: usize = 4096
const PASSES: usize = 64

struct Job:
    w: []i8
    x: []i8
    y: *mut i32
    cols: usize

fn rows(start: usize, end: usize, ctx: *u8):
    unsafe:
        job = ptr_cast[*Job](ctx)
        cols = job[0].cols
        wp = job[0].w
        xp = job[0].x
        yp = job[0].y
        for r in start..end:
            base = r * cols
            acc = i32x8.splat(0)
            c: usize = 0
            while c + 32 <= cols:
                acc = acc.dot_i8(i8x32.load(xp, c), i8x32.load(wp, base + c))
                c += 32
            yp[r] = acc.sum()

fn main():
    w = List[i8]()
    w.reserve(ROWS * COLS)
    state: u64 = 12345
    for i in 0..ROWS * COLS:
        overflow: wrap
        state = state * 6364136223846793005 + 1442695040888963407
        w.push(i8(i64((state >> 33) % 255) - 127))
    x = List[i8]()
    for i in 0..COLS:
        x.push(i8(i64((i * 37) % 255) - 127))
    y = List[i32]()
    for i in 0..ROWS:
        y.push(0)
    pool = parallel.Pool.new(0)
    ws = w[..]
    xs = x[..]
    ys = y[..]
    total: i64 = 0
    unsafe:
        job = Job{ w: ws, x: xs, y: ptr_cast[*mut i32](addr_mut(ys)), cols: COLS }
        for p in 0..PASSES:
            pool.for_range(ROWS, rows, ptr_cast[*u8](addr(job)))
            total += i64(y[p % ROWS])
    sum: i64 = 0
    for i in 0..ROWS:
        sum += i64(y[i])
    print(total)
    print(sum)
