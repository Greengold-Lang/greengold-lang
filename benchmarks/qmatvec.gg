# Quantized matrix-vector product, the inner loop of LLM token generation: 4096 x 4096 int8 weights times an
# int8 activation vector, 64 times (one "token" per pass). Each row is a 32-bit integer dot product, so the
# printed checksum is exact. The weights are 16 MB, more than the caches, so the speed is memory bandwidth plus
# how well the multiply-add is vectorized. Build with `--cpu native` to use AVX2.

const ROWS: usize = 4096
const COLS: usize = 4096
const PASSES: usize = 64

hot fn matvec(w: []i8, x: []i8, y: lend []i32, rows: usize, cols: usize):
    for r in 0..rows:
        base = r * cols
        acc = i32x8.splat(0)
        c: usize = 0
        while c + 32 <= cols:
            acc = acc.dot_i8(i8x32.load(x, c), i8x32.load(w, base + c))
            c += 32
        y[r] = acc.sum()

fn main():
    w = List[i8]()
    w.reserve(ROWS * COLS)
    state: u64 = 12345
    for i in 0..ROWS * COLS:
        overflow: wrap
        state = state * 6364136223846793005 + 1442695040888963407
        w.push(i8(i64((state >> 33) % 255) - 127))
    x = List[i8]()
    for i in 0..COLS:
        x.push(i8(i64((i * 37) % 255) - 127))
    y = List[i32]()
    for i in 0..ROWS:
        y.push(0)
    total: i64 = 0
    for p in 0..PASSES:
        matvec(w[..], x[..], y[..], ROWS, COLS)
        total += i64(y[p % ROWS])
    sum: i64 = 0
    for i in 0..ROWS:
        sum += i64(y[i])
    print(total)
    print(sum)
