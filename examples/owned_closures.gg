struct Button:
    label: string
    on_click: Fn(i32) -> i32

fn make_adder(k: i32) -> Fn(i32) -> i32:
    return fn(x: i32) -> i32 => x + k

fn make_greeter(name: string) -> Fn(i32) -> i32:
    return fn(times: i32) -> i32 => i32(name.len()) * times

fn twice(x: i32) -> i32:
    return x * 2

fn run(f: Fn(i32) -> i32, x: i32) -> i32:
    return f(x)

fn main():
    add5 = make_adder(5)
    print(add5(1), run(add5, 10))
    handlers = List[Fn(i32) -> i32]()
    handlers.push(make_adder(1))
    handlers.push(make_greeter(string.from("abc")))
    handlers.push(twice)
    k = 100
    handlers.push(fn(x: i32) -> i32 => x - k)
    total = 0
    for i in 0..handlers.len:
        total += run(handlers[i].clone(), 10)
    print(total)
    b = Button{ label: string.from("ok"), on_click: make_adder(7) }
    print(b.label, b.on_click(3))
    g = add5.clone()
    print(g(0))
