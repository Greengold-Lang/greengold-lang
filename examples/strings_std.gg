import std.string

fn main():
    s = "  hello, world  "
    t = string.str_trim(s)
    print(t, t.len)
    print(string.str_find(t, "world").value_or(99), string.str_contains(t, "xyz"), string.str_starts_with(t, "hello"), string.str_ends_with(t, "ld"))
    parts = string.str_split("a,b,,c", ',')
    print(parts.len, parts[0], parts[2].len, parts[3])
    print(string.parse_i64("-1234").value_or(0), string.parse_i64("12x").value_or(-1), string.parse_u64("18446744073709551615").value_or(0))
    print(string.parse_i64("-9223372036854775808").value_or(0), string.parse_i64("9223372036854775808").value_or(7))
    print(string.parse_f64("3.25").value_or(0.0), string.parse_f64("-0.5").value_or(0.0), string.parse_f64("abc").value_or(-1.0))
    out = string.new()
    out.append_str("n=")
    out.append_i64(-42)
    out.append_str(" u=")
    out.append_u64(0)
    out.append_str(" f=")
    out.append_f64(2.5)
    out.append_str(" b=")
    out.append_bool(true)
    print(out.as_str())
    up = string.to_upper("MiXed")
    print(up.as_str(), string.to_lower("MiXed").as_str())
    j = string.str_join(parts, "|")
    print(j.as_str())
    r = string.str_replace("a-b-c", "-", "::")
    print(r.as_str(), string.str_repeat("ab", 3).as_str())
    lines = string.str_lines("x\r\ny\nz")
    print(lines.len, lines[0].len)
