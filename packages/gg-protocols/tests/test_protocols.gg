import "../src/arinc429.gg"
import "../src/mil1553.gg"
import "../src/ccsds.gg"
import "../src/mavlink.gg"
import std.math

fn near(a: f64, b: f64, tol: f64) -> bool:
    return math.abs(a - b) <= tol

fn test_arinc429_word_round_trip_and_parity():
    w = arinc429.encode(200, 1, arinc429.f64_to_bnr(45.5, 18, 180.0), 3)
    d = arinc429.decode(w)
    require d.parity_ok
    require d.label == 200 and d.sdi == 1 and d.ssm == 3
    require near(arinc429.bnr_to_f64(d.data, 18, 180.0), 45.5, 0.001)
    # flipping any bit breaks the odd parity
    broken = arinc429.decode(w ^ 0x100)
    require not broken.parity_ok

fn test_arinc429_label_bit_order_and_negative_bnr():
    # label 001 octal is the byte 0x80 on the wire (the label is sent most significant bit first)
    w = arinc429.encode(1, 0, 0, 0)
    require (w & 255) == 0x80
    require arinc429.decode(w).label == 1
    f = arinc429.f64_to_bnr(-12.25, 15, 100.0)
    require near(arinc429.bnr_to_f64(f, 15, 100.0), -12.25, 100.0 / 16384.0)
    require arinc429.bnr_to_i32(arinc429.f64_to_bnr(-100.0, 15, 100.0), 15) == -16384
    sat = arinc429.bnr_to_i32(arinc429.f64_to_bnr(500.0, 15, 100.0), 15)
    require sat == 16383

fn test_arinc429_bcd():
    d = arinc429.bcd_digits(0x1305, 4)
    require d[0] == 1 and d[1] == 3 and d[2] == 0 and d[3] == 5
    bad = arinc429.bcd_digits(0x1A05, 4)
    require bad[1] == -1

fn test_mil1553_command_and_status_words():
    cw = mil1553.command_word(5, true, 3, 4)
    require cw == 0b00101_1_00011_00100
    c = mil1553.parse_command(cw)
    require c.rt_address == 5 and c.transmit and c.subaddress == 3 and c.word_count == 4 and not c.is_mode_code
    thirty_two = mil1553.parse_command(mil1553.command_word(1, false, 7, 32))
    require thirty_two.word_count == 32
    mode = mil1553.parse_command(mil1553.command_word(2, true, 0, 17))
    require mode.is_mode_code and mode.word_count == 17
    s = mil1553.Status{ rt_address: 9, message_error: false, instrumentation: false, service_request: true, broadcast_received: false,
                        busy: true, subsystem_flag: false, dynamic_bus_control: false, terminal_flag: true }
    w = mil1553.status_word(s)
    back = mil1553.parse_status(w)
    require back.rt_address == 9 and back.service_request and back.busy and back.terminal_flag and not back.message_error
    require mil1553.parity_ok(0x0001, 0) and mil1553.parity_ok(0x0003, 1)

fn test_ccsds_packet_round_trip_and_crc():
    h = ccsds.PacketHeader{ version: 0, is_command: true, secondary_header: true, apid: 0x123, seq_flags: 3, seq_count: 0x2ABC }
    payload: [5]u8 = [1, 2, 3, 4, 5]
    wire = ccsds.build_packet(h, payload[..], true)
    require wire.len == 6 + 5 + 2
    require wire[0] == 0x19 and wire[1] == 0x23        # 000 1 1 00100100011
    require wire[4] == 0 and wire[5] == 6                 # data field of 7 bytes: length 6
    p = ccsds.parse_packet(wire[..], true).value_or_panic()
    require p.header.apid == 0x123 and p.header.is_command and p.header.seq_count == 0x2ABC and p.header.seq_flags == 3
    require p.data.len == 5 and p.data[4] == 5
    wire[7] = 99
    require not ccsds.parse_packet(wire[..], true).is_ok()
    require ccsds.packet_len(wire[..]).value_or(0) == 13

fn test_ccsds_rejects_short_and_overlong():
    short: [5]u8 = [0, 0, 0, 0, 0]
    require not ccsds.parse_packet(short[..], false).is_ok()
    liar: [8]u8 = [0x00, 0x01, 0xC0, 0x00, 0x00, 0x09, 1, 2]
    require not ccsds.parse_packet(liar[..], false).is_ok()

fn extra_of(id: u32) -> Optional[u8]:
    if id == 0:
        return Valid(50)
    return None

fn test_mavlink_crc_check_value():
    # CRC-16/MCRF4XX of "123456789" is 0x6F91
    text: [9]u8 = [49, 50, 51, 52, 53, 54, 55, 56, 57]
    require mavlink.crc_update(0xFFFF, text[..]) == 0x6F91

fn test_mavlink_v2_round_trip_and_truncation():
    payload = List[u8]()
    for b in [0, 0, 0, 0, 2, 3, 81, 4, 3]:
        payload.push(u8(b))
    f = mavlink.Frame{ sysid: 1, compid: 1, msgid: 0, seq: 7, payload: payload, incompat_flags: 0, compat_flags: 0 }
    wire = mavlink.build_v2(f, 50)
    require wire.len == 12 + 9
    require wire[0] == 0xFD and wire[1] == 9 and wire[4] == 7 and wire[5] == 1
    g = mavlink.parse(wire[..], extra_of).value_or_panic()
    require g.sysid == 1 and g.seq == 7 and g.payload.len == 9 and g.payload[6] == 81
    wire[12] = wire[12] ^ 1                              # damage the payload
    require not mavlink.parse(wire[..], extra_of).is_ok()
    zeros: [4]u8 = [5, 0, 0, 0]
    cut = mavlink.truncate_payload(zeros[..])
    require cut.len == 1 and cut[0] == 5
    allzero: [3]u8 = [0, 0, 0]
    require mavlink.truncate_payload(allzero[..]).len == 1

fn test_mavlink_v1_and_unknown_ids():
    payload = List[u8]()
    payload.push(9)
    payload.push(8)
    f = mavlink.Frame{ sysid: 3, compid: 4, msgid: 0, seq: 1, payload: payload, incompat_flags: 0, compat_flags: 0 }
    wire = mavlink.build_v1(f, 50)
    require wire[0] == 0xFE and wire.len == 8 + 2
    g = mavlink.parse(wire[..], extra_of).value_or_panic()
    require g.sysid == 3 and g.compid == 4 and g.payload.len == 2
    other = mavlink.Frame{ sysid: 3, compid: 4, msgid: 77, seq: 1, payload: List[u8](), incompat_flags: 0, compat_flags: 0 }
    other.payload.push(1)
    require not mavlink.parse(mavlink.build_v2(other, 1)[..], extra_of).is_ok()

fn main():
    pass
