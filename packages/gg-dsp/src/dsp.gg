# dsp: signal processing on slices of `f64`. No allocation inside: the caller owns the buffers, so the same code runs on a
# microcontroller with `--forbid-heap` and on a server.
#
#     import dsp.dsp { fft, magnitude, window_hann }
#     re = [0.0; 1024]
#     im = [0.0; 1024]
#     ...fill `re` with samples...
#     window_hann(re[..])                       # in place
#     fft(re[..], im[..])                       # in place; the length must be a power of two
#     m = magnitude(re[..], im[..], 5)          # amplitude of bin 5
#
# Contents: FFT/IFFT (radix-2), windows, Goertzel (one frequency, no FFT), biquad IIR filters (RBJ cookbook), a streaming FIR
# filter of fixed length, windowed-sinc FIR design, and a moving average.
#
# Conventions. A signal of length n has bins 0..n-1; bin k is the frequency k * fs / n (bins above n/2 are the negative frequencies).
# `fft` computes X[k] = sum x[j] e^(-2 pi i j k / n) with no scaling; `ifft` divides by n, so `ifft(fft(x)) == x`.

import std.math

# -- FFT ---------------------------------------------------------------------------------------------------------------------

public
fn is_power_of_two(n: usize) -> bool:
    return n > 0 and (n & (n - 1)) == 0

private
fn reverse_bits_n(x: usize, bits: u32) -> usize:
    r: usize = 0
    v = x
    for _i in 0..bits:
        r = (r << 1) | (v & 1)
        v = v >> 1
    return r

fn transform(re: lend []f64, im: lend []f64, sign: f64):
    n = re.len
    if im.len != n:
        panic("fft: the real and imaginary parts have different lengths")
    if not is_power_of_two(n):
        panic("fft: the length must be a power of two")
    if n == 1:
        return
    bits: u32 = 0
    while (usize(1) << bits) < n:
        bits += 1
    for i in 0..n:
        j = reverse_bits_n(usize(i), bits)
        if j > usize(i):
            tr = re[usize(i)]
            ti = im[usize(i)]
            re[usize(i)] = re[j]
            im[usize(i)] = im[j]
            re[j] = tr
            im[j] = ti
    size: usize = 2
    while size <= n:
        half = size / 2
        step = sign * 2.0 * math.pi() / f64(size)
        start: usize = 0
        while start < n:
            for k in 0..half:
                angle = step * f64(k)
                wr = math.cos(angle)
                wi = math.sin(angle)
                a = start + usize(k)
                b = a + half
                xr = re[b] * wr - im[b] * wi
                xi = re[b] * wi + im[b] * wr
                re[b] = re[a] - xr
                im[b] = im[a] - xi
                re[a] = re[a] + xr
                im[a] = im[a] + xi
            start += size
        size = size * 2

public
# The discrete Fourier transform in place. The length of both slices must be the same power of two (it panics otherwise).
fn fft(re: lend []f64, im: lend []f64):
    transform(re, im, -1.0)

# The inverse transform in place, scaled by 1/n.
fn ifft(re: lend []f64, im: lend []f64):
    transform(re, im, 1.0)
    n = f64(re.len)
    for i in 0..re.len:
        re[usize(i)] = re[usize(i)] / n
        im[usize(i)] = im[usize(i)] / n

# sqrt(re^2 + im^2) of bin `k`, divided by n and doubled for the bins strictly between 0 and n/2, which is the amplitude of a
# sine wave at that frequency (bins 0 and n/2 are not doubled).
fn magnitude(re: []f64, im: []f64, k: usize) -> f64:
    n = re.len
    m = math.sqrt(re[k] * re[k] + im[k] * im[k]) / f64(n)
    if k != 0 and k != n / 2:
        m = m * 2.0
    return m

# The frequency in hertz of bin `k` for a transform of `n` samples taken at `fs` hertz.
fn bin_frequency(k: usize, n: usize, fs: f64) -> f64:
    return f64(k) * fs / f64(n)

# -- windows (in place: multiply the signal by the window) ----------------------------------------------------------------------

# Hann window, w[j] = 0.5 - 0.5 cos(2 pi j / n) ("periodic" form, the right one for spectral analysis).
fn window_hann(x: lend []f64):
    n = f64(x.len)
    for j in 0..x.len:
        x[usize(j)] = x[usize(j)] * (0.5 - 0.5 * math.cos(2.0 * math.pi() * f64(j) / n))

fn window_hamming(x: lend []f64):
    n = f64(x.len)
    for j in 0..x.len:
        x[usize(j)] = x[usize(j)] * (0.54 - 0.46 * math.cos(2.0 * math.pi() * f64(j) / n))

fn window_blackman(x: lend []f64):
    n = f64(x.len)
    for j in 0..x.len:
        t = 2.0 * math.pi() * f64(j) / n
        x[usize(j)] = x[usize(j)] * (0.42 - 0.5 * math.cos(t) + 0.08 * math.cos(2.0 * t))

# -- Goertzel: the power at one frequency, without an FFT ------------------------------------------------------------------------

# The squared magnitude of the DFT at frequency `freq` (hertz) for samples taken at `fs` hertz. Cheaper than an FFT when you want
# one or two tones (DTMF, pilot tones). The frequency need not fall on a bin.
fn goertzel_power(x: []f64, freq: f64, fs: f64) -> f64:
    w = 2.0 * math.pi() * freq / fs
    coeff = 2.0 * math.cos(w)
    s1 = 0.0
    s2 = 0.0
    for j in 0..x.len:
        s0 = x[usize(j)] + coeff * s1 - s2
        s2 = s1
        s1 = s0
    return s1 * s1 + s2 * s2 - coeff * s1 * s2

# -- biquad IIR filter -----------------------------------------------------------------------------------------------------------

# A second-order section in direct form II transposed: y = b0 x + z1; z1 = b1 x - a1 y + z2; z2 = b2 x - a2 y.
# The coefficients are normalised so that a0 = 1.
struct Biquad:
    b0: f64
    b1: f64
    b2: f64
    a1: f64
    a2: f64
    z1: f64
    z2: f64

impl Biquad:
    public
    fn from_coefficients(b0: f64, b1: f64, b2: f64, a0: f64, a1: f64, a2: f64) -> Biquad:
        return Biquad{ b0: b0 / a0, b1: b1 / a0, b2: b2 / a0, a1: a1 / a0, a2: a2 / a0, z1: 0.0, z2: 0.0 }

    # Low-pass with corner `fc` hertz at sample rate `fs`; `q` = 0.7071 gives a Butterworth response.
    fn lowpass(fc: f64, fs: f64, q: f64) -> Biquad:
        w = 2.0 * math.pi() * fc / fs
        c = math.cos(w)
        alpha = math.sin(w) / (2.0 * q)
        return Biquad.from_coefficients((1.0 - c) / 2.0, 1.0 - c, (1.0 - c) / 2.0, 1.0 + alpha, -2.0 * c, 1.0 - alpha)

    fn highpass(fc: f64, fs: f64, q: f64) -> Biquad:
        w = 2.0 * math.pi() * fc / fs
        c = math.cos(w)
        alpha = math.sin(w) / (2.0 * q)
        return Biquad.from_coefficients((1.0 + c) / 2.0, -(1.0 + c), (1.0 + c) / 2.0, 1.0 + alpha, -2.0 * c, 1.0 - alpha)

    # Band-pass with unity gain at the centre frequency `fc`.
    fn bandpass(fc: f64, fs: f64, q: f64) -> Biquad:
        w = 2.0 * math.pi() * fc / fs
        c = math.cos(w)
        alpha = math.sin(w) / (2.0 * q)
        return Biquad.from_coefficients(alpha, 0.0, -alpha, 1.0 + alpha, -2.0 * c, 1.0 - alpha)

    # Notch (band-stop) at `fc`.
    fn notch(fc: f64, fs: f64, q: f64) -> Biquad:
        w = 2.0 * math.pi() * fc / fs
        c = math.cos(w)
        alpha = math.sin(w) / (2.0 * q)
        return Biquad.from_coefficients(1.0, -2.0 * c, 1.0, 1.0 + alpha, -2.0 * c, 1.0 - alpha)

    # Clears the state.
    fn reset(self: lend Self):
        self.z1 = 0.0
        self.z2 = 0.0

    # Filters one sample.
    fn process(self: lend Self, x: f64) -> f64:
        y = self.b0 * x + self.z1
        self.z1 = self.b1 * x - self.a1 * y + self.z2
        self.z2 = self.b2 * x - self.a2 * y
        return y

    # Filters a buffer in place.
    fn process_all(self: lend Self, x: lend []f64):
        for j in 0..x.len:
            x[usize(j)] = self.process(x[usize(j)])

    # The magnitude of the frequency response at `freq` hertz (sample rate `fs`).
    fn gain_at(self: read Self, freq: f64, fs: f64) -> f64:
        w = 2.0 * math.pi() * freq / fs
        c1 = math.cos(w)
        s1 = math.sin(w)
        c2 = math.cos(2.0 * w)
        s2 = math.sin(2.0 * w)
        nr = self.b0 + self.b1 * c1 + self.b2 * c2
        ni = -(self.b1 * s1 + self.b2 * s2)
        dr = 1.0 + self.a1 * c1 + self.a2 * c2
        di = -(self.a1 * s1 + self.a2 * s2)
        return math.sqrt((nr * nr + ni * ni) / (dr * dr + di * di))

# -- FIR filters -----------------------------------------------------------------------------------------------------------------

# A streaming FIR filter with `N` taps: y[n] = sum taps[k] * x[n - k]. The history is a ring buffer inside the struct.
struct Fir[N: usize]:
    taps: [N]f64
    history: [N]f64
    pos: usize

impl Fir[N]:
    public
    fn new(taps: [N]f64) -> Fir[N]:
        return Fir[N]{ taps: taps, history: [0.0; N], pos: 0 }

    fn reset(self: lend Self):
        self.history = [0.0; N]
        self.pos = 0

    fn process(self: lend Self, x: f64) -> f64:
        self.history[self.pos] = x
        acc = 0.0
        idx = self.pos
        for k in 0..N:
            acc = acc + self.taps[usize(k)] * self.history[idx]
            if idx == 0:
                idx = N - 1
            else:
                idx = idx - 1
        self.pos = (self.pos + 1) % N
        return acc

public
# Windowed-sinc low-pass design: fills `taps` (an odd length is best) with a linear-phase filter whose corner is `fc` hertz at sample
# rate `fs`, using a Hamming window. The taps are scaled to sum to 1 (unity gain at DC).
fn design_lowpass(taps: lend []f64, fc: f64, fs: f64):
    n = taps.len
    m = f64(n - 1) / 2.0
    wc = 2.0 * math.pi() * fc / fs
    total = 0.0
    for j in 0..n:
        t = f64(j) - m
        h = wc / math.pi()
        if t != 0.0:
            h = math.sin(wc * t) / (math.pi() * t)
        h = h * (0.54 - 0.46 * math.cos(2.0 * math.pi() * f64(j) / f64(n - 1)))
        taps[usize(j)] = h
        total = total + h
    for j in 0..n:
        taps[usize(j)] = taps[usize(j)] / total

# The mean of the last `n` values of a stream, in O(1) per sample. `window` must hold `n` values (use a `[n]f64` array).
struct MovingAverage[N: usize]:
    window: [N]f64
    pos: usize
    filled: usize
    sum: f64

impl MovingAverage[N]:
    public
    fn new() -> MovingAverage[N]:
        return MovingAverage[N]{ window: [0.0; N], pos: 0, filled: 0, sum: 0.0 }

    fn push(self: lend Self, x: f64) -> f64:
        self.sum = self.sum - self.window[self.pos] + x
        self.window[self.pos] = x
        self.pos = (self.pos + 1) % N
        if self.filled < N:
            self.filled += 1
        return self.sum / f64(self.filled)
