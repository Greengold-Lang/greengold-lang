import "../src/dsp.gg" { fft, ifft, magnitude, bin_frequency, window_hann, goertzel_power, Biquad, Fir, MovingAverage, design_lowpass, is_power_of_two }
import std.math

fn near(a: f64, b: f64, tol: f64) -> bool:
    return math.abs(a - b) <= tol

fn test_fft_of_a_sine_peaks_at_its_bin():
    re = [0.0; 256]
    im = [0.0; 256]
    for j in 0..256:
        re[usize(j)] = 3.0 * math.sin(2.0 * math.pi() * 10.0 * f64(j) / 256.0)
    fft(re[..], im[..])
    require near(magnitude(re[..], im[..], 10), 3.0, 1.0e-9)
    require near(magnitude(re[..], im[..], 11), 0.0, 1.0e-9)
    require near(magnitude(re[..], im[..], 0), 0.0, 1.0e-9)
    require near(bin_frequency(10, 256, 2560.0), 100.0, 1.0e-12)

fn test_fft_matches_the_naive_dft():
    n = 16
    xr = [0.0; 16]
    xi = [0.0; 16]
    for j in 0..n:
        xr[usize(j)] = math.sin(0.7 * f64(j)) + 0.25 * f64(j % 3)
        xi[usize(j)] = math.cos(1.3 * f64(j))
    want_r = [0.0; 16]
    want_i = [0.0; 16]
    for k in 0..n:
        for j in 0..n:
            a = -2.0 * math.pi() * f64(j * k) / f64(n)
            want_r[usize(k)] = want_r[usize(k)] + xr[usize(j)] * math.cos(a) - xi[usize(j)] * math.sin(a)
            want_i[usize(k)] = want_i[usize(k)] + xr[usize(j)] * math.sin(a) + xi[usize(j)] * math.cos(a)
    fft(xr[..], xi[..])
    for k in 0..n:
        require near(xr[usize(k)], want_r[usize(k)], 1.0e-9)
        require near(xi[usize(k)], want_i[usize(k)], 1.0e-9)

fn test_ifft_undoes_fft():
    re = [0.0; 64]
    im = [0.0; 64]
    orig = [0.0; 64]
    for j in 0..64:
        orig[usize(j)] = math.sin(f64(j) * 0.37) * f64(j)
        re[usize(j)] = orig[usize(j)]
    fft(re[..], im[..])
    ifft(re[..], im[..])
    for j in 0..64:
        require near(re[usize(j)], orig[usize(j)], 1.0e-9)
        require near(im[usize(j)], 0.0, 1.0e-9)
    require is_power_of_two(64) and not is_power_of_two(48) and not is_power_of_two(0)

fn test_window_reduces_leakage():
    n = 256
    plain_r = [0.0; 256]
    plain_i = [0.0; 256]
    wind_r = [0.0; 256]
    wind_i = [0.0; 256]
    for j in 0..n:
        v = math.sin(2.0 * math.pi() * 10.5 * f64(j) / 256.0)       # between two bins
        plain_r[usize(j)] = v
        wind_r[usize(j)] = v
    window_hann(wind_r[..])
    fft(plain_r[..], plain_i[..])
    fft(wind_r[..], wind_i[..])
    far: usize = 40
    require magnitude(wind_r[..], wind_i[..], far) < magnitude(plain_r[..], plain_i[..], far) / 20.0

fn test_goertzel_finds_a_tone():
    x = [0.0; 400]
    for j in 0..400:
        x[usize(j)] = math.sin(2.0 * math.pi() * 697.0 * f64(j) / 8000.0)
    on = goertzel_power(x[..], 697.0, 8000.0)
    off = goertzel_power(x[..], 1209.0, 8000.0)
    require on > 1000.0 * off

fn test_lowpass_biquad_gain():
    lp = Biquad.lowpass(1000.0, 48000.0, 0.7071067811865476)
    require near(lp.gain_at(1.0, 48000.0), 1.0, 1.0e-3)
    require near(lp.gain_at(1000.0, 48000.0), 0.7071067811865476, 1.0e-4)
    require lp.gain_at(20000.0, 48000.0) < 0.01
    # the time-domain output agrees with the frequency response
    x = [0.0; 4800]
    for j in 0..4800:
        x[usize(j)] = math.sin(2.0 * math.pi() * 1000.0 * f64(j) / 48000.0)
    lp.process_all(x[..])
    peak = 0.0
    for j in 4000..4800:
        if math.abs(x[usize(j)]) > peak:
            peak = math.abs(x[usize(j)])
    require near(peak, 0.7071067811865476, 2.0e-3)

fn test_notch_removes_its_frequency():
    nt = Biquad.notch(50.0, 1000.0, 10.0)
    require nt.gain_at(50.0, 1000.0) < 1.0e-6
    require near(nt.gain_at(5.0, 1000.0), 1.0, 1.0e-2)
    hp = Biquad.highpass(100.0, 1000.0, 0.7071)
    bp = Biquad.bandpass(100.0, 1000.0, 5.0)
    require near(bp.gain_at(100.0, 1000.0), 1.0, 1.0e-9)
    require hp.gain_at(5.0, 1000.0) < 0.01

fn test_fir_design_and_streaming():
    taps = [0.0; 31]
    design_lowpass(taps[..], 100.0, 1000.0)
    total = 0.0
    for k in 0..31:
        total = total + taps[usize(k)]
    require near(total, 1.0, 1.0e-12)
    f = Fir[31].new(taps)
    # a constant input settles to the input value (unity gain at DC)
    last = 0.0
    for _i in 0..100:
        last = f.process(2.0)
    require near(last, 2.0, 1.0e-9)
    # an impulse returns the taps in order
    g = Fir[31].new(taps)
    require near(g.process(1.0), taps[0], 1.0e-15)
    require near(g.process(0.0), taps[1], 1.0e-15)
    require near(g.process(0.0), taps[2], 1.0e-15)

fn test_moving_average():
    ma = MovingAverage[4].new()
    require near(ma.push(4.0), 4.0, 1.0e-12)
    require near(ma.push(8.0), 6.0, 1.0e-12)
    ma.push(0.0)
    require near(ma.push(4.0), 4.0, 1.0e-12)
    require near(ma.push(12.0), 6.0, 1.0e-12)

fn main():
    pass
