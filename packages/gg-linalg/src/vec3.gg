# linalg.vec3: three-dimensional vectors of `f64`, for position, velocity, and force. No allocation.
#
#     import linalg.vec3 { Vec3 }
#     a = Vec3{ x: 1.0, y: 0.0, z: 0.0 }
#     b = Vec3{ x: 0.0, y: 1.0, z: 0.0 }
#     print(a.cross(b).z, a.dot(b), (a + b).norm())        # 1 0 1.4142135623730951

import std.math

public
struct Vec3:
    x: f64
    y: f64
    z: f64

impl Vec3:
    public
    fn zero() -> Vec3:
        return Vec3{ x: 0.0, y: 0.0, z: 0.0 }

    fn add(self: read Self, o: Vec3) -> Vec3:
        return Vec3{ x: self.x + o.x, y: self.y + o.y, z: self.z + o.z }

    fn sub(self: read Self, o: Vec3) -> Vec3:
        return Vec3{ x: self.x - o.x, y: self.y - o.y, z: self.z - o.z }

    fn neg(self: read Self) -> Vec3:
        return Vec3{ x: -self.x, y: -self.y, z: -self.z }

    fn eq(self: read Self, o: Vec3) -> bool:
        return self.x == o.x and self.y == o.y and self.z == o.z

    fn scale(self: read Self, k: f64) -> Vec3:
        return Vec3{ x: self.x * k, y: self.y * k, z: self.z * k }

    fn dot(self: read Self, o: Vec3) -> f64:
        return self.x * o.x + self.y * o.y + self.z * o.z

    fn cross(self: read Self, o: Vec3) -> Vec3:
        return Vec3{ x: self.y * o.z - self.z * o.y, y: self.z * o.x - self.x * o.z, z: self.x * o.y - self.y * o.x }

    fn norm_sq(self: read Self) -> f64:
        return self.dot(self)

    fn norm(self: read Self) -> f64:
        return math.sqrt(self.norm_sq())

    fn distance(self: read Self, o: Vec3) -> f64:
        return self.sub(o).norm()

    # The vector of length 1 in the same direction; the zero vector stays zero.
    fn normalized(self: read Self) -> Vec3:
        n = self.norm()
        if n == 0.0:
            return Vec3.zero()
        return self.scale(1.0 / n)

    # The angle between two vectors, in radians (0 when either is zero).
    fn angle_to(self: read Self, o: Vec3) -> f64:
        d = self.norm() * o.norm()
        if d == 0.0:
            return 0.0
        c = self.dot(o) / d
        if c > 1.0:
            c = 1.0
        if c < -1.0:
            c = -1.0
        return math.acos(c)

    # The point `t` of the way from this vector to `o` (t = 0 is this one, t = 1 is `o`).
    fn lerp(self: read Self, o: Vec3, t: f64) -> Vec3:
        return Vec3{ x: self.x + (o.x - self.x) * t, y: self.y + (o.y - self.y) * t, z: self.z + (o.z - self.z) * t }
