# conformance: SPEC section 7 (Structs, methods, enums), example 2
# expect-output:
#   1

struct Pair[A, B]:
    first: A
    second: B

impl Pair[A, B]:
    fn swapped(self) -> Pair[B, A]:
        return Pair[B, A]{ first: self.second, second: self.first }

fn main():
    p = Pair[i32, str]{ first: 1, second: "a" }.swapped()
    print(p.second)
