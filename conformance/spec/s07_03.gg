# conformance: SPEC section 7 (Structs, methods, enums), example 3
# expect-output:
#   4

enum Shape:
    Circle(i32)
    Empty

fn main():
    s = Shape.Circle(3)
    match lend s:
        Circle(r):
            r = 4
        Empty:
            pass
    match s:
        Circle(r):
            print(r)
        Empty:
            print(0)
