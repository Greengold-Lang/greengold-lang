# conformance: SPEC section 7 (Structs, methods, enums), example 7
# expect-output:
#   1065353216
#   5 64

union Bits:
    f: f32
    u: u32

packed struct Header:
    tag: u8
    len: u32

align(64) struct Slot:
    hits: i64

fn main():
    x = Bits{ f: 1.0 }
    unsafe:
        print(x.u)
    print(size_of[Header](), align_of[Slot]())
