# conformance: SPEC section 11 (References), example 1
# expect-output:
#   3 3
#   8

struct Player:
    hp: i32

fn hp_of(p: read Player) -> ref i32:
    return p.hp

fn main():
    hero = Player{ hp: 3 }
    view = read hero
    print(view.hp, hp_of(hero))
    slot: lend Player = hero
    slot.hp = 8
    print(hero.hp)
